	},

	Axis_Truck_Stolen = function()
	{
		SetAvailableMapGoals( TEAM.AXIS, true, "ESCORT_Axis_Truck" );

		Util.MapDebugPrint( "Axis_Truck_Stolen" );
	},

	Allied_Truck_Stolen = function()
	{
		SetAvailableMapGoals( TEAM.ALLIES, true, "ESCORT_Allied_Truck" );

		Util.MapDebugPrint( "Allied_Truck_Stolen" );
	},

	// ---

	Check_Tank_Building_Axis_Existence = function( ent )
	{
		while ( Util.GetEntHealth( ent ) > 0 )
		{
			//Util.MapDebugPrint( "Axis Tank building up", true );
			sleep( 5 );
		}

		SetAvailableMapGoals( TEAM.AXIS, false, "PLANT_Tank_Building_Axis" );
		SetAvailableMapGoals( TEAM.AXIS, true, { "BUILD_Axis_Tank", "ESCORT_Axis_Tank" } );
		Util.MapDebugPrint( "Axis Tank building destroyed", true );
	},

	Check_Tank_Building_Allies_Existence = function( ent )
	{
		while ( Util.GetEntHealth( ent ) > 0 )
		{
			//Util.MapDebugPrint( "Allied Tank building up", true );
			sleep( 5 );
		}

		SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_Tank_Building_Allies" );
		SetAvailableMapGoals( TEAM.ALLIES, true, { "BUILD_Allied_Tank", "ESCORT_Allied_Tank" } );
		Util.MapDebugPrint( "Allied Tank building destroyed", true );
	}
};

global OnMapLoad = function()
{
	OnTrigger( "MISSING_STRING", Map.Allied_Tank_Built );
	OnTrigger( "MISSING_STRING", Map.Allied_Tank_Barrier_1_Built );
	OnTrigger( "MISSING_STRING", Map.Allied_Truck_Built );
	OnTrigger( "MISSING_STRING", Map.Allied_rebuildable_bank_door_Built );
	OnTrigger( "MISSING_STRING", Map.Axis_Tank_Built );
	OnTrigger( "MISSING_STRING", Map.Axis_Tank_Barrier_1_Built );
	OnTrigger( "MISSING_STRING", Map.Axis_Tank_Barrier_2_Built );
	OnTrigger( "MISSING_STRING", Map.Axis_Truck_Built );
	OnTrigger( "MISSING_STRING", Map.Axis_rebuildable_bank_door_Built );
	OnTrigger( "MISSING_STRING", Map.Command_Post_Built );
	OnTrigger( "MISSING_STRING", Map.Tank_Barrier_Built );
	OnTrigger( "MISSING_STRING", Map.Truck_Barrier_1_Built );
	OnTrigger( "MISSING_STRING", Map.Truck_Barrier_1_1_Built );
	OnTrigger( "MISSING_STRING", Map.Truck_Barrier_2_Built );
	OnTrigger( "MISSING_STRING", Map.Truck_Barrier_2_1_Built );
	OnTrigger( "MISSING_STRING", Map.Allied_Tank_Barrier_1_Destroyed );
	OnTrigger( "MISSING_STRING", Map.Allied_rebuildable_bank_door_Destroyed );
	OnTrigger( "MISSING_STRING", Map.Axis_Tank_Barrier_1_Destroyed );
	OnTrigger( "MISSING_STRING", Map.Axis_Tank_Barrier_2_Destroyed );
	OnTrigger( "MISSING_STRING", Map.Axis_rebuildable_bank_door_Destroyed );
	OnTrigger( "MISSING_STRING", Map.Command_Post_Destroyed );
	OnTrigger( "MISSING_STRING", Map.Tank_Barrier_Destroyed );
	OnTrigger( "MISSING_STRING", Map.Truck_Barrier_1_Destroyed );
	OnTrigger( "MISSING_STRING", Map.Truck_Barrier_1_1_Destroyed );
	OnTrigger( "MISSING_STRING", Map.Truck_Barrier_2_Destroyed );
	OnTrigger( "MISSING_STRING", Map.Truck_Barrier_2_1_Destroyed );
	OnTrigger( "MISSING_STRING", Map.Allied_Gold_Taken);
	OnTrigger( "MISSING_STRING", Map.Axis_Gold_Taken);
	OnTrigger( "MISSING_STRING", Map.Allied_Gold_Returned );
	OnTrigger( "MISSING_STRING", Map.Axis_Gold_Returned );
	OnTrigger( "MISSING_STRING", Map.Allied_Gold_Secured );
	OnTrigger( "MISSING_STRING", Map.Axis_Gold_Secured );

	OnTrigger( "^3Axis tank now permanently parked away!", Map.Axis_Tank_Parked );
	OnTrigger( "^3Allied tank now permanently parked away!", Map.Allied_Tank_Parked );

	OnTrigger( "^1Axis team is escaping with the Gold Crates!", Map.Axis_Truck_Stolen );
	OnTrigger( "Allied team is escaping with the Gold Crates!", Map.Allied_Truck_Stolen );

	// ---

	Util.DisableGoal( "ESCORT_.*" );

	SetGoalPriority( "BUILD_.*_Tank", 0.91 ); // Above BUILD

	// ---

	// Tank buildings management
	// Custom PLANT goal trace says invalid/null entity, so here we go

	SetAvailableMapGoals( TEAM.AXIS, false, { "BUILD_Axis_Tank", "CAPPOINT_Allies", "PLANT_Tank_Building_Allies" } );
	SetAvailableMapGoals( TEAM.ALLIES, false, { "BUILD_Allied_Tank", "CAPPOINT_Axis", "PLANT_Tank_Building_Axis" } );

	SetGoalPriority( "PLANT_Tank_Building_.*", 0.91 ); // Above BUILD

	start = Vec3( 3550, -2760, -1830 );
	end   = Vec3( 3500, -2760, -1830 );
	tr    = TraceLine( start, end, null, TRACE.SHOT, 0, false );
	if ( tr.fraction < 1 )
	{
		tankBuildingAxis = tr.entity;
		Util.MapDebugPrint( "Axis Tank building entity found, ID: " +  GetGameIdFromEntity( tankBuildingAxis ), true );
		thread( Map.Check_Tank_Building_Axis_Existence, tankBuildingAxis );
	}
	else
	{
		Util.MapDebugPrint( "Axis Tank building entity not found!", 2 );
	}

	start = Vec3( -3515, -2735, -1830 );
	end   = Vec3( -3460, -2735, -1830 );
	tr    = TraceLine( start, end, null, TRACE.SHOT, 0, false );
	if ( tr.fraction < 1 )
	{
		tankBuildingAllies = tr.entity;
		Util.MapDebugPrint( "Allied Tank building entity found, ID: " +  GetGameIdFromEntity( tankBuildingAllies ), true );
		thread( Map.Check_Tank_Building_Allies_Existence, tankBuildingAllies );
	}
	else
	{
		Util.MapDebugPrint( "Allied Tank building entity not found!", 2 );
	}

	// ---

	Util.MapDebugPrint( "Omni-bot map script for " + GetMapName() + " executed." );
};
