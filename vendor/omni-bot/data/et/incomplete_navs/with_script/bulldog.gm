	{
		SetAvailableMapGoals( TEAM.ALLIES, true, "CAPPOINT_Allied_West_Vault" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "CAPPOINT_Allied_East_Vault" );
		Util.MapDebugPrint( "allied_pickup3_Secured" );
	},

