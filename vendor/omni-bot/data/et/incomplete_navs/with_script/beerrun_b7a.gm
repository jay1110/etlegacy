					list[ent] += 1;
				}
				else
				{
					list[ent] = 1;
					if ( tableCount(list) == 1 ) {
						// enable DISABLE Waypoint for allies
						Wp.SetWaypointFlag( "Coldfiltering_east", "axis", true );
					}
				}
			}
		},
		OnExit = function(ent)
		{
			list = Map.Loadingdock_N_Trigger.playerList;
			if (list[ent])
			{
				if (list[ent] > 1)
				{
					//overlapping regions
					list[ent] -= 1;
				}
				else
