	{
		Map.KegStolen = false;
		
		Wp.SetWaypointFlag( "Loadingdock_west", "axis", false );
		Wp.SetWaypointFlag( "Brewhouse_east", "axis", false );
	//	Wp.SetWaypointFlag( "Brewhouse_south", "axis", true );
	//	Wp.SetWaypointFlag( "Brewhouse_west", "axis", true );
		Wp.SetWaypointFlag( "Coldfiltering_north", "axis", false );
		Wp.SetWaypointFlag( "Axis_spawn_ladder", "axis", false );

