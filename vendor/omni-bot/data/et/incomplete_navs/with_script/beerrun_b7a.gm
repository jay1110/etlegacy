					}
				}
			}
		},	
	},
	Loadingdock_N_Trigger_2 =
	{
		Name = "Loadingdock_N_Trigger_2",
		TriggerOnClass = CLASS.ANYPLAYER,
		playerList = {},
		OnEnter = function(ent)
		{
