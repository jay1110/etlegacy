global Map =
{
	Quiet = true,
	KeyStatus = false, //home
	KeyCapturedStatus = false, //not capped
	KegStolen = false,
	ControlsStatus = false, //destroyed
	CardReturned = 0,
	ChangingNumber = 0,

	Checkpoint_forward_spawn = "CHECKPOINT_forward_spawn",
	Flag_access_codes = "FLAG_access_codes",
	Flag_axis_gold1 = "FLAG_axis_gold1",
	Flag_axis_gold2 = "FLAG_axis_gold2",
	Cappoint_keg = "CAPPOINT_keg",
	Cappoint_keycodes = "CAPPOINT_keycodes",
	Build_Axis_Controls = "BUILD_Axis_Controls",
	Plant_Axis_Controls = "PLANT_Axis_Controls",
	
	Roles =
	{
		AXIS =
		{
			AllBots = true,
			DEFENDER =
			{
				crucialClass = CLASS.ENGINEER,
				numbots = 3,
			},
			DEFENDER1 =
			{
				crucialClass = CLASS.ENGINEER,
				numbots = 3,
				//MinBotsForRole = 4,
			},
		},
		ALLIES =
		{
			ATTACKER =
			{
				crucialClass = CLASS.COVERTOPS,
				numbots = 4,
			},
			ATTACKER1 =
			{
				crucialClass = CLASS.COVERTOPS,
				numbots = 4,
				//MinBotsForRole = 4,
			},
			ATTACKER2 =
			{
				crucialClass = CLASS.MEDIC,
				numbots = 4,
			},
			ATTACKER3 =
			{
				crucialClass = CLASS.MEDIC,
				numbots = 4,
				//MinBotsForRole = 4,
			},
		},
	},

	Axis_Controls_Built = function()
	{
		Map.ControlsStatus = true;
		//EchoToScreen(5, "^1Axis_Controls_Built");

		SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_Axis_Controls" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "CAMP_Axiscontrol_0.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, {
			"BUILD_Axis_Controls",
			"DEFEND_loading_area_1",
		});
		if(Map.KegStolen)
		{
			sleep(5.5);
			//EchoToScreen(5, "^5CAPPOINT_keg_false");
			SetAvailableMapGoals(TEAM.ALLIES, false, "CAPPOINT_keg");
		}

		Util.MapDebugPrint( "Axis_Controls_Built" );
	},

	Axis_Controls_Destroyed = function()
	{
		//EchoToScreen(5, "^5Axis_Controls_Destroyed");

		if ( Map.KeyCapturedStatus )
		{
			SetAvailableMapGoals( TEAM.ALLIES, true, {
				"ATTACK_axis_control_04",
				"CAMP_Axiscontrol_0.*",
			});
		}

		SetAvailableMapGoals( TEAM.AXIS, true, {
			"BUILD_Axis_Controls",
		});
		SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_Axis_Controls" );

		Util.MapDebugPrint( "Axis_Controls_Destroyed" );
		sleep(2.5);
		Map.ControlsStatus = false;
		//EchoToScreen(5, "^CAPPOINT_keg ENABLED");
		if(Map.KegStolen)
		{
			SetAvailableMapGoals(TEAM.ALLIES, false, "CAMP_Keg_0.*");
			SetAvailableMapGoals(TEAM.ALLIES, true, "CAPPOINT_keg");
			SetAvailableMapGoals(TEAM.AXIS, true, "DEFEND_loading_area_1");
		}
	},

	access_codes_Taken = function()
	{

		Map.KeyStatus = true;

		SetAvailableMapGoals(TEAM.AXIS, true, {
			"DEFEND_keycode_0.*",
			"MOBILEMG42_defend_cappoint_keycodes_.*",
		});
		SetAvailableMapGoals(TEAM.ALLIES, true, {
			"CAPPOINT_keycodes",
			"ATTACK_keg_cage_0.*",
		});
		SetAvailableMapGoals(TEAM.ALLIES, false, "FLAG_access_codes");
		Util.MapDebugPrint( "access_codes_Taken" );
	},
	
	access_card_Dropped = function()
	{
		SetAvailableMapGoals(TEAM.AXIS, false, {
			"DEFEND_keycode_0.*",
		});
		SetAvailableMapGoals(TEAM.ALLIES, false, {
			"ATTACK_keg_cage_0.*",
		});
		Util.MapDebugPrint( "access_card_Dropped" );
	},

	access_codes_Returned = function()
	{
		Map.KeyStatus = false;
		Map.CardReturned += 1;
		Util.MapDebugPrint("^3CardReturned = " + Map.CardReturned);
		
		if(Map.CardReturned == 1)
		{
			Map.ChangingNumber = (RandInt(2,4));
			Util.MapDebugPrint("ChangingNumber = " + Map.ChangingNumber);
		}
		if(Map.ChangingNumber == Map.CardReturned)
		{
			Wp.SetWaypointFlag( "checkpoint_entrance", "closed", true );
			Wp.SetWaypointFlag( "checkpoint_door", "closed", true );
			Wp.SetWaypointFlag( "checkpoint_1", "axis", true );
			Wp.SetWaypointFlag( "checkpoint_2", "axis", true );
			Wp.SetWaypointFlag( "checkpoint_3", "axis", true );
			SetAvailableMapGoals(TEAM.ALLIES, false, {
			"CHECKPOINT.*",
			"ATTACK_checkpoint.*",
			});
			Util.MapDebugPrint("^5 And now we need choose together other path!");
		}

		SetAvailableMapGoals(TEAM.ALLIES, true, "FLAG_access_codes");
		SetAvailableMapGoals(TEAM.ALLIES, false, "CAPPOINT_keycodes");
		SetAvailableMapGoals(TEAM.AXIS, false, "MOBILEMG42_defend_cappoint_keycodes_.*");
		Util.MapDebugPrint( "access_codes_Returned" );
	},
	
	keycodes_Captured = function()
	{
		Map.KeyCapturedStatus = true;
		
			Wp.SetWaypointFlag( "checkpoint_1", "axis", false );
			Wp.SetWaypointFlag( "checkpoint_2", "axis", false );
			Wp.SetWaypointFlag( "checkpoint_3", "axis", false );
		
		if ( !Map.ControlsStatus )
		{
			SetAvailableMapGoals(TEAM.AXIS, true, "BUILD_Axis_Controls");
		}
		else
		{
			SetAvailableMapGoals(TEAM.ALLIES, true, "PLANT_Axis_Controls");
		}

		SetAvailableMapGoals( TEAM.AXIS, true, {
			"DEFEND_keycode_0.*",
			"MOBILEMG42_defend_keycode_.*",
		});
		SetAvailableMapGoals(TEAM.AXIS, false, {
			"MOBILEMG42_defend_checkpoint_.*",
			"MOBILEMG42_defend_cappoint_keycodes_.*",
			"DEFEND_checkpoint_0.*",
		});

        SetAvailableMapGoals( TEAM.ALLIES, false, {
        	"CAPPOINT_keycodes",
        	"FLAG_access_codes",
			"ATTACK_checkpoint_0.*",
        });
		sleep(4);
		SetAvailableMapGoals( TEAM.ALLIES, true, {
			"FLAG_axis_gold1", 
			"ATTACK_keg_cage_0.*",	
		});

		Util.MapDebugPrint( "keycodes_Captured" );
	},

	axis_gold1_Taken = function()
	{
		Map.KegStolen = true;
		
		Wp.SetWaypointFlag( "Loadingdock_west", "axis", true );
		Wp.SetWaypointFlag( "Brewhouse_east", "axis", true );
	//	Wp.SetWaypointFlag( "Brewhouse_south", "axis", true );
	//	Wp.SetWaypointFlag( "Brewhouse_west", "axis", true );
		Wp.SetWaypointFlag( "Coldfiltering_north", "axis", true );
	//	Wp.SetWaypointFlag( "Axis_spawn_ladder", "axis", true );

		SetAvailableMapGoals(TEAM.AXIS, true, {
			"DEFEND_loading_area_[2-9]",
			"MOBILEMG42_Defend_truck.*",
		});
		SetAvailableMapGoals(TEAM.ALLIES, true, "CAMP_keg.*");
		SetAvailableMapGoals(TEAM.ALLIES, true, "ATTACK_Loadingdock_00.*");
		SetAvailableMapGoals(TEAM.AXIS, false, {
			"MOBILEMG42_defend_keycode_.*",
			"DEFEND_keycode_0.*",
		});
		
		SetAvailableMapGoals(TEAM.ALLIES, false, {
			"ATTACK_keg_cage_0.*",
			"FLAG_axis_gold1",
		});
		if(Map.ControlsStatus)
		{
			SetAvailableMapGoals(TEAM.ALLIES, true, {
				"PLANT_Axis_Controls",
			});
			SetAvailableMapGoals(TEAM.AXIS, false, "DEFEND_loading_area_1");
		}
		else
		{
			SetAvailableMapGoals(TEAM.ALLIES, true, "CAPPOINT_keg");
			SetAvailableMapGoals(TEAM.ALLIES, true, {
				"ATTACK_Loadingdock.*",
				"CAMP_Axiscontrol_0.*",
			});
			SetAvailableMapGoals(TEAM.AXIS, true, "DEFEND_loading_area_1");
		}
		Util.MapDebugPrint( "axis_gold1_Taken" );
	},
	
