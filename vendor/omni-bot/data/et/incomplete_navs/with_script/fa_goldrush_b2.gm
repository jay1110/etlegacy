	Tank_Barrier_1_Destroyed = function()
	{
		SetAvailableMapGoals( 1, 0, "BUILD_North_Command_Post" ); //leave it for allies
		SetAvailableMapGoals( 0, 1, "BUILD_South_Command_Post" ); //any team can use the south cp
		Util.MapDebugPrint( "Tank_Barrier_1_Destroyed" );
	},

	// TODO Never called, see to restore what expected previous waypointer?
	barrier2 = function()
	{
		SetAvailableMapGoals( TEAM.AXIS, true, "MOUNT_tank_axis" );
		// allies can come from both sides
		ETUtil.SetAimModeForMount( "MOUNT_tank_axis", "random" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "ESCORT_tank" );
		SetGoalPriority( "PLANT_Tank_Barrier_2", 0.95);
		SetGoalPriority( "BUILD_South_Command_Post", 0.96, TEAM.ALLIES);
		Util.SetGoalRange( "BUILD_South_Command_Post", 1350);
		SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_South_Command_Post" );
		ETUtil.SetStartIndex("BUILD_Tank", 1);

		SetAvailableMapGoals( TEAM.ALLIES, true, {
			"ATTACK_Tank_Barrier2_.*",
			"ATTACK_newbarrier2_.*",
			"AIRSTRIKE_bBarrier2_2",
			"AIRSTRIKE_bBarrier2_1",
			"CALLARTILLERY_b2call",
			"ARTILLERY_S_b2call_1",
			"ARTILLERY_S_b2call_2",
		});

		SetGoalPriority( "CALLARTILLERY_b2call", 0.99, TEAM.ALLIES );
		SetGoalPriority( "ARTILLERY_S_b2call_1", 0.99, TEAM.ALLIES );
		SetGoalPriority( "ARTILLERY_S_b2call_2", 0.99, TEAM.ALLIES );

		SetGoalPriority( "ATTACK_Tank_Barrier2_.*", 0.9, TEAM.ALLIES );
		SetGoalPriority( "AIRSTRIKE_bBarrier2_1", 0.96, TEAM.ALLIES );
		SetGoalPriority( "AIRSTRIKE_bBarrier2_2", 0.96, TEAM.ALLIES );
		// enable the repair routes
		Util.ForceRouting( "BUILD_Tank", true );
		Util.EnableGoal("ROUTE_repair_route.*");

		Util.MapDebugPrint("tank at Barrier 2 mg42");
	},

