global Map =
{
	Debug = 0, // please set to zero before distributing your script

	Allied_Command_Post_Built = function( trigger )
	{
		SetAvailableMapGoals( TEAM.AXIS, true, "PLANT_Allied_Command_Post" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Allied_Commandpost" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_bridge_top" );
		Util.MapDebugPrint( "Allied_Command_Post_Built" );
	},

	Axis_Commandpost_Built = function( trigger )
	{
		SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_Axis_Command_Post" );
		SetAvailableMapGoals( TEAM.AXIS, false, "BUILD_Axis_Commandpost" );
		SetAvailableMapGoals( TEAM.AXIS, true, "ATTACK_bridge_top" );
		Util.MapDebugPrint( "Axis_Commandpost_Built" );
	},

	Allied_Command_Post_Destroyed = function( trigger )
	{
		SetAvailableMapGoals( TEAM.AXIS, false, "PLANT_Allied_Command_Post" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Allied_Commandpost" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_bridge_top" );
		Util.MapDebugPrint( "Allied_Command_Post_Destroyed" );
	},

	Axis_Commandpost_Destroyed = function( trigger )
	{
		SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_Axis_Command_Post" );
		SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_Axis_Commandpost" );
		SetAvailableMapGoals( TEAM.AXIS, false, "ATTACK_bridge_top" );
		Util.MapDebugPrint( "Axis_Commandpost_Destroyed" );
	},

};

global OnMapLoad = function()
{
	// Register callback functions
	OnTrigger( "Allied Command Post constructed. Charge speed increased! Jump pads enab", Map.Allied_Command_Post_Built );
	OnTrigger( "Axis Command Post constructed. Charge speed increased!  Jump pads enabl", Map.Axis_Commandpost_Built );
	OnTrigger( "Allied team has destroyed the Axis Command Post! Jump pads disabled!", Map.Allied_Command_Post_Destroyed );
	OnTrigger( "Axis team has destroyed the Allied Command Post! Jump pads disabled!", Map.Axis_Commandpost_Destroyed );

	Util.DisableGoal( ".*", true ); // all but routes
	SetAvailableMapGoals( TEAM.AXIS, true, "ATTACK_bridge_1" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_bridge_1" );
	SetAvailableMapGoals( TEAM.AXIS, true, "ATTACK_bridge_2" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_bridge_2" );
	SetAvailableMapGoals( TEAM.AXIS, true, "ATTACK_bridge_3" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_bridge_3" );
	SetAvailableMapGoals( TEAM.AXIS, false, "AMMOCAB_.*" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "AMMOCAB_.*" );
	SetAvailableMapGoals( TEAM.AXIS, true, "HEALTHCAB_.*" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "HEALTHCAB_.*" );
	SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_Allied_Commandpost" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Axis_Commandpost" );

	// Max users per goal
	Util.SetMaxUsers( 3, "ATTACK_.*" );
	Util.SetMaxUsers( 1, "BUILD_Allied_Commandpost" );
	Util.SetMaxUsers( 1, "BUILD_Axis_Commandpost" );
	Util.SetMaxUsers( 1, "PLANT_Axis_Command_Post" );
	Util.SetMaxUsers( 1, "PLANT_Allied_Command_Post" );

	// Camp times
	//SetMapGoalProperties( "MOUNTMG42_.*", {MinCampTime=15, MaxCampTime=90} );
	
	SetGoalPriority( "BUILD_Allied_Commandpost", 1.50, 0, CLASS.ENGINEER );
	SetGoalPriority( "BUILD_Axis_Commandpost", 1.50, 0, CLASS.ENGINEER );
	SetGoalPriority( "PLANT_Axis_Command_Post", 1.50, 0, CLASS.COVERTOPS);
	SetGoalPriority( "PLANT_Allied_Command_Post", 1.50, 0, CLASS.COVERTOPS );


	Util.MapDebugPrint( "Omni-bot map script for " + GetMapName() + " executed." );
};

global OnBotJoin = function( bot )
{
	// Uncomment for shootable breakables
	//~bot.TargetBreakableDist = 90.0;
