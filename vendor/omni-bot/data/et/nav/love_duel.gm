global OnMapLoad = function()
{
	Util.LimitToTeam( TEAM.ALLIES, "ATTACK_tankmg42" );
	Util.LimitToTeam( TEAM.AXIS, "ATTACK_allyspawn" );
	Util.LimitToTeam( TEAM.ALLIES, "DEFEND_mg42allyspawn" );
	Util.LimitToTeam( TEAM.ALLIES, "DEFEND_allyspawn.*" );
	Util.LimitToTeam( TEAM.AXIS, "DEFEND_axisspawn.*" );
	Util.LimitToTeam( TEAM.ALLIES, "DEFEND_roof.*" );
	Util.LimitToTeam( TEAM.ALLIES, "CALLARTILLERY_1" );
	Util.LimitToTeam( TEAM.ALLIES, "ARTILLERY_D_1" );
	Util.LimitToTeam( TEAM.ALLIES, "AIRSTRIKE_1" );
	Util.LimitToTeam( TEAM.AXIS, "AIRSTRIKE_2" );

	SetGoalPriority( "ATTACK_allyspawn", 0.7, TEAM.AXIS );
	SetGoalPriority( "ATTACK_axisspawn", 0.7, TEAM.ALLIES );

	Util.SetMaxUsers(1, {"ATTACK.*", "DEFEND.*"});

	Util.MapDebugPrint("Omni-bot map script for " + GetMapName() + " executed.");
};

