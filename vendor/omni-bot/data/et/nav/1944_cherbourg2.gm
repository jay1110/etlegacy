	SetSpawn1 = function(bot)
	{

		if ( Map.Forward_Spawn_Fixed )
		{
			if ( bot.GetTeam() == TEAM.AXIS )
			{
				if ( Map.Axis_CP )
				{
					if ( tableCount(Map.AlliesInsideFirst) < 1 )
					{
						if ( bot.HasRole(ROLE.DEFENDER) or bot.HasRole(ROLE.DEFENDER1) or bot.HasRole(ROLE.DEFENDER2) )
						{
							bot.ChangeSpawnPoint(5);	//CP
						}
						else
						{
							bot.ChangeSpawnPoint(1);	//Axis Road Spawn
						}
					}
					else
					{
						if ( tableCount(Map.AlliesInsideSecond) < 1 )
						{
							if ( bot.HasRole(ROLE.DEFENDER) )
							{
								if ( Map.Axis_Bunker_Controlpanel )
								{
									bot.ChangeSpawnPoint(4);	//Axis AA Guns spawn
								}
								else
								{
									bot.ChangeSpawnPoint(5);	//CP
								}
							}

							if ( bot.HasRole(ROLE.DEFENDER1) or bot.HasRole(ROLE.DEFENDER2) )
							{
								bot.ChangeSpawnPoint(5);	//CP
							}

							if ( bot.HasRole(ROLE.DEFENDER3) )
							{
								bot.ChangeSpawnPoint(1);	//Axis Road Spawn
							}
						}
						else
						{
							if ( Map.West_AA_Gun or Map.East_AA_Gun )
							{
								if ( tableCount(Map.AlliesNearAAGuns) < 1 )
								{
									if ( bot.HasRole(ROLE.DEFENDER1) or bot.HasRole(ROLE.DEFENDER2) )
									{
										if ( Map.Axis_Bunker_Controlpanel )
										{
											bot.ChangeSpawnPoint(4);	//Axis AA Guns spawn
										}
										else
										{
											bot.ChangeSpawnPoint(5);	//CP
										}
									}

									if ( bot.HasRole(ROLE.DEFENDER3) )
									{
										bot.ChangeSpawnPoint(1);	//Axis Road Spawn
									}
								}
								else
								{
									if ( Map.Axis_Bunker_Controlpanel )
									{
										bot.ChangeSpawnPoint(4);	//Axis AA Guns spawn
									}
									else
									{
										bot.ChangeSpawnPoint(5);	//CP
									}
								}
							}
							else
							{
								if ( bot.HasRole(ROLE.DEFENDER1) or bot.HasRole(ROLE.DEFENDER2) or bot.HasRole(ROLE.DEFENDER3) )
								{
									if ( Map.Axis_Bunker_Controlpanel )
									{
										bot.ChangeSpawnPoint(4);	//Axis AA Guns spawn
									}
									else
									{
										bot.ChangeSpawnPoint(5);	//CP
									}
								}
							}

							if ( bot.HasRole(ROLE.DEFENDER) )
							{
								if ( Map.Axis_Bunker_Controlpanel )
								{
									bot.ChangeSpawnPoint(4);	//Axis AA Guns spawn
								}
								else
								{
									bot.ChangeSpawnPoint(5);	//CP
								}
							}
						}
					}
				}
				else
				{
					if ( tableCount(Map.AlliesInsideFirst) < 1 and tableCount(Map.AlliesInsideSecond) < 1 )
					{
						if ( bot.HasRole(ROLE.DEFENDER) or bot.HasRole(ROLE.DEFENDER1) )
						{
							if ( Map.Axis_Bunker_Controlpanel )
							{
								bot.ChangeSpawnPoint(4);	//Axis AA Guns spawn
							}
							else
							{
								bot.ChangeSpawnPoint(1);	//Axis Road Spawn
							}
						}
						else
						{
							bot.ChangeSpawnPoint(1);	//Axis Road Spawn
						}
					}
					else
					{
						if ( Map.West_AA_Gun or Map.East_AA_Gun )
						{
							if ( tableCount(Map.AlliesNearAAGuns) < 1 )
							{
								if ( bot.HasRole(ROLE.DEFENDER1) or bot.HasRole(ROLE.DEFENDER2) )
								{
									if ( Map.Axis_Bunker_Controlpanel )
									{
										bot.ChangeSpawnPoint(4);	//Axis AA Guns spawn
									}
									else
									{
										bot.ChangeSpawnPoint(1);	//Axis Road Spawn
									}
								}

								if ( bot.HasRole(ROLE.DEFENDER3) )
								{
									bot.ChangeSpawnPoint(1);	//Axis Road Spawn
								}
							}
							else
							{
								if ( Map.Axis_Bunker_Controlpanel )
								{
									bot.ChangeSpawnPoint(4);	//Axis AA Guns spawn
								}
								else
								{
									bot.ChangeSpawnPoint(1);	//Axis Road Spawn
								}
							}
						}
						else
						{
							if ( Map.Axis_Bunker_Controlpanel )
							{
								bot.ChangeSpawnPoint(4);	//Axis AA Guns spawn
							}
							else
							{
								bot.ChangeSpawnPoint(1);	//Axis Road Spawn
							}
						}

						if ( bot.HasRole(ROLE.DEFENDER) )
						{
							if ( Map.Axis_Bunker_Controlpanel )
							{
								bot.ChangeSpawnPoint(4);	//Axis AA Guns spawn
							}
							else
							{
								bot.ChangeSpawnPoint(1);	//Axis Road Spawn
							}
						}
					}
				}
			}
			else
			{
				if ( Map.Dock_AA_Gun )
				{
					if ( Map.Allied_CP )
					{
						bot.ChangeSpawnPoint(5);	//CP
					}
					else
					{
						bot.ChangeSpawnPoint(2);	//Allied Road Spawn
					}
				}
				else
				{
					r = RandInt(0,1);

					if ( Map.Allied_CP )
					{
						if( r < 1 )
						{
							bot.ChangeSpawnPoint(5);	//CP
						}
						else
						{
							bot.ChangeSpawnPoint(3);	//Allied Dock Spawn
						}
					}
					else
					{
						if( r < 1 )
						{
							bot.ChangeSpawnPoint(2);	//Allied Road Spawn
						}
						else
						{
							bot.ChangeSpawnPoint(3);	//Allied Dock Spawn
						}
					}
				}
			}
		}
		else
		{
			if ( bot.GetTeam() == TEAM.AXIS )
			{
				if ( tableCount(Map.AlliesInsideFirst) < 1 and tableCount(Map.AlliesInsideSecond) < 1 )
				{
					if ( bot.HasRole(ROLE.DEFENDER) or bot.HasRole(ROLE.DEFENDER1) )
					{
						if ( Map.Axis_Bunker_Controlpanel )
						{
							bot.ChangeSpawnPoint(4);	//Axis AA Guns spawn
						}
						else
						{
							bot.ChangeSpawnPoint(1);	//Axis Road Spawn
						}
					}
					else
					{
						bot.ChangeSpawnPoint(1);	//Axis Road Spawn
					}
				}
				else
				{
					if ( Map.West_AA_Gun or Map.East_AA_Gun )
					{
						if ( tableCount(Map.AlliesNearAAGuns) < 1 )
						{
							if ( bot.HasRole(ROLE.DEFENDER1) or bot.HasRole(ROLE.DEFENDER2) )
							{
								if ( Map.Axis_Bunker_Controlpanel )
								{
									bot.ChangeSpawnPoint(4);	//Axis AA Guns spawn
								}
								else
								{
									bot.ChangeSpawnPoint(1);	//Axis Road Spawn
								}
							}

							if ( bot.HasRole(ROLE.DEFENDER3) )
							{
								bot.ChangeSpawnPoint(1);	//Axis Road Spawn
							}
						}
						else
						{
							if ( Map.Axis_Bunker_Controlpanel )
							{
								bot.ChangeSpawnPoint(4);	//Axis AA Guns spawn
							}
							else
							{
								bot.ChangeSpawnPoint(1);	//Axis Road Spawn
							}
						}
					}
					else
					{
						if ( Map.Axis_Bunker_Controlpanel )
						{
							bot.ChangeSpawnPoint(4);	//Axis AA Guns spawn
						}
						else
						{
							bot.ChangeSpawnPoint(1);	//Axis Road Spawn
						}
					}

					if ( bot.HasRole(ROLE.DEFENDER) )
					{
						if ( Map.Axis_Bunker_Controlpanel )
						{
							bot.ChangeSpawnPoint(4);	//Axis AA Guns spawn
						}
						else
						{
							bot.ChangeSpawnPoint(1);	//Axis Road Spawn
						}
					}
				}
			}
			else
			{
				if ( Map.Dock_AA_Gun )
				{
					bot.ChangeSpawnPoint(2);	//Allied Road Spawn
				}
				else
				{
					r = RandInt(0,1);

					if( r < 1 )
					{
						bot.ChangeSpawnPoint(2);	//Allied Road Spawn
					}
					else
					{
						bot.ChangeSpawnPoint(3);	//Allied Dock Spawn
					}
				}
			}
		}
	},

	SetSpawn = function()
	{
		foreach(bot in BotTable)
