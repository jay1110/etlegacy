	East_AA_Gun_Planted = function()
	{
		Map.East_AA_Gun_Dyno += 1;

		if ( Map.Dock_AA_Gun )
		{
			SetGoalRole( "DEFUSE_East_AA_Gun_.*", { ROLE.DEFENDER2, ROLE.DEFENDER3 } );
		}
		else
		{
			SetGoalRole( "DEFUSE_East_AA_Gun_.*", { ROLE.DEFENDER, ROLE.DEFENDER2, ROLE.DEFENDER3 } );
		}

		Util.MapDebugPrint( "^5East_AA_Gun_Planted" );
	},

	East_AA_Gun_Defused = function()
	{
		Map.East_AA_Gun_Dyno -= 1;

		Util.MapDebugPrint( "^5East_AA_Gun_Defused" );
	},

	East_AA_Gun_Destroyed = function()
	{
		if ( Map.East_AA_Gun_Dyno > 0 )
		{
			SetAvailableMapGoals( TEAM.AXIS, false, "DEFUSE_East_AA_Gun_.*" );
		}

		Map.East_AA_Gun_Dyno = 0;
		Map.East_AA_Gun = false;
		Map.NumberOfCompletedTasks +=  1;

		if ( Map.NumberOfCompletedTasks == 3 )
		{
			Map.Allies_Win = true;

			sleep(1);
			ETUtil.WinningChat( TEAM.ALLIES );
			sleep(1.5);
			ETUtil.LosingChat( TEAM.AXIS );

			Util.MapDebugPrint( "^5Allies win" );
		}

		SetAvailableMapGoals( TEAM.AXIS, false, ".*_Axis_EastAAGun_.*" );

		SetAvailableMapGoals( TEAM.ALLIES, false, {
			"PLANT_East_AA_Gun",
			"ATTACK_Allies_EastAAGun_.*",
		});

		if ( !Map.West_AA_Gun )
		{
			DeleteTriggerRegion("Allies_Near_AA_Guns");
			DeleteTriggerRegion("Trigger_AlliesIn_BunkerSewer");
			DeleteTriggerRegion("Trigger_AlliesIn_CourtyardSewer");
			yield();
			Map.AlliedEngsNearAAGuns = null;
			Map.AlliesNearAAGuns = null;
			Map.AlliesInBunkerSewer = null;
			Map.AlliesInCourtyardSewer = null;

			if ( Map.Dock_AA_Gun )
			{
				Util.SetMaxUsers( 2, "DEFEND_Axis_Second_DockArea_.*" );
				Util.SetMaxUsers( 2, "DEFEND_Axis_First_DockArea_.*" );
				Util.SetMaxUsers( 2, "DEFEND_Axis_DockAAGun_.*" );

				SetGoalRole( "DEFEND_Axis_Second_DockArea_.*", { ROLE.DEFENDER, ROLE.DEFENDER1, ROLE.DEFENDER2, ROLE.DEFENDER3 } );
				SetGoalRole( "DEFEND_Axis_First_DockArea_.*", { ROLE.DEFENDER, ROLE.DEFENDER1, ROLE.DEFENDER2, ROLE.DEFENDER3 } );
				SetGoalRole( "DEFEND_Axis_DockAAGun_.*", { ROLE.DEFENDER, ROLE.DEFENDER1, ROLE.DEFENDER2, ROLE.DEFENDER3 } );

				Util.SetMaxUsers( 2, "ATTACK_Allies_DockAAGun_.*" );

				SetGoalRole( "PLANT_Dock_AA_Gun", { ROLE.ATTACKER, ROLE.ATTACKER1, ROLE.ATTACKER2, ROLE.ATTACKER3 } );
				SetGoalRole( "ATTACK_Allies_DockAAGun_.*", { ROLE.ATTACKER, ROLE.ATTACKER1, ROLE.ATTACKER2, ROLE.ATTACKER3 } );
			}

			if ( Map.Courtyard_Sewer_Grate )
			{
				SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_Allies_CourtyardSewerGrate_.*" );
			}

			if ( Map.Axis_Bunker_Sewer_Grate )
			{
				SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_Allies_BunkerSewerGrate_.*" );
			}

			if ( !Map.Axis_Inner_Blockade )
			{
				SetAvailableMapGoals( TEAM.AXIS, false, "BUILD_Axis_Inner_Blockade" );
			}
			else
			{
				SetAvailableMapGoals( TEAM.AXIS, false, {
					"REPAIRMG42_axis_inner_blockade_mg42",
					"MOUNTMG42_axis_inner_blockade_mg42",
				});

				SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_Axis_Inner_Blockade" );
			}
		}
		else
		{
			Util.SetMaxUsers( 2, "DEFEND_Axis_WestAAGun_.*" );
			Util.SetMaxUsers( 2, "ATTACK_Allies_WestAAGun_.*" );

			SetGoalRole( "DEFEND_Axis_WestAAGun_.*", { ROLE.DEFENDER2, ROLE.DEFENDER3 } );
			SetGoalRole( "ATTACK_Allies_WestAAGun_.*", { ROLE.ATTACKER2, ROLE.ATTACKER3 } );
		}

		Util.MapDebugPrint( "^5East_AA_Gun_Destroyed" );
	},

	West_AA_Gun_Planted = function()
	{
		Map.West_AA_Gun_Dyno += 1;

		if ( Map.Dock_AA_Gun )
		{
			SetGoalRole( "DEFUSE_East_AA_Gun_.*", { ROLE.DEFENDER2, ROLE.DEFENDER3 } );
		}
		else
		{
			SetGoalRole( "DEFUSE_East_AA_Gun_.*", { ROLE.DEFENDER, ROLE.DEFENDER2, ROLE.DEFENDER3 } );
		}

		Util.MapDebugPrint( "^5West_AA_Gun_Planted" );
	},

	West_AA_Gun_Defused = function()
	{
		Map.West_AA_Gun_Dyno -= 1;

		Util.MapDebugPrint( "^5West_AA_Gun_Defused" );
	},

	West_AA_Gun_Destroyed = function()
	{
		if ( Map.West_AA_Gun_Dyno > 0 )
		{
			SetAvailableMapGoals( TEAM.AXIS, false, "DEFUSE_West_AA_Gun_.*" );
		}

		Map.West_AA_Gun_Dyno = 0;
		Map.West_AA_Gun = false;
		Map.NumberOfCompletedTasks +=  1;

		if ( Map.NumberOfCompletedTasks == 3 )
		{
			Map.Allies_Win = true;

			sleep(1);
			ETUtil.WinningChat( TEAM.ALLIES );
			sleep(1.5);
			ETUtil.LosingChat( TEAM.AXIS );

			Util.MapDebugPrint( "^5Allies win" );
		}

		SetAvailableMapGoals( TEAM.AXIS, false, ".*_Axis_WestAAGun_.*" );

		SetAvailableMapGoals( TEAM.ALLIES, false, {
			"PLANT_West_AA_Gun",
			"ATTACK_Allies_WestAAGun_.*",
		});

		DeleteTriggerRegion("Allies_Near_West_AA_Gun");
		yield();
		Map.AlliesNearWestAAGuns = null;

		if ( !Map.East_AA_Gun )
		{
			DeleteTriggerRegion("Allies_Near_AA_Guns");
			DeleteTriggerRegion("Trigger_AlliesIn_BunkerSewer");
			DeleteTriggerRegion("Trigger_AlliesIn_CourtyardSewer");
			yield();
			Map.AlliedEngsNearAAGuns = null;
			Map.AlliesNearAAGuns = null;
			Map.AlliesInBunkerSewer = null;
			Map.AlliesInCourtyardSewer = null;

			if ( Map.Dock_AA_Gun )
			{
				Util.SetMaxUsers( 2, "DEFEND_Axis_Second_DockArea_.*" );
				Util.SetMaxUsers( 2, "DEFEND_Axis_First_DockArea_.*" );
				Util.SetMaxUsers( 2, "DEFEND_Axis_DockAAGun_.*" );

				SetGoalRole( "DEFEND_Axis_Second_DockArea_.*", { ROLE.DEFENDER, ROLE.DEFENDER1, ROLE.DEFENDER2, ROLE.DEFENDER3 } );
				SetGoalRole( "DEFEND_Axis_First_DockArea_.*", { ROLE.DEFENDER, ROLE.DEFENDER1, ROLE.DEFENDER2, ROLE.DEFENDER3 } );
				SetGoalRole( "DEFEND_Axis_DockAAGun_.*", { ROLE.DEFENDER, ROLE.DEFENDER1, ROLE.DEFENDER2, ROLE.DEFENDER3 } );

				Util.SetMaxUsers( 2, "ATTACK_Allies_DockAAGun_.*" );

				SetGoalRole( "PLANT_Dock_AA_Gun", { ROLE.ATTACKER, ROLE.ATTACKER1, ROLE.ATTACKER2, ROLE.ATTACKER3 } );
				SetGoalRole( "ATTACK_Allies_DockAAGun_.*", { ROLE.ATTACKER, ROLE.ATTACKER1, ROLE.ATTACKER2, ROLE.ATTACKER3 } );
			}

			if ( Map.Courtyard_Sewer_Grate )
			{
				SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_Allies_CourtyardSewerGrate_.*" );
			}

			if ( Map.Axis_Bunker_Sewer_Grate )
			{
				SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_Allies_BunkerSewerGrate_.*" );
			}

			if ( !Map.Axis_Inner_Blockade )
			{
				SetAvailableMapGoals( TEAM.AXIS, false, "BUILD_Axis_Inner_Blockade" );
			}
			else
			{
				SetAvailableMapGoals( TEAM.AXIS, false, {
					"REPAIRMG42_axis_inner_blockade_mg42",
					"MOUNTMG42_axis_inner_blockade_mg42",
				});

				SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_Axis_Inner_Blockade" );
			}
		}
		else
		{
			Util.SetMaxUsers( 2, "DEFEND_Axis_EastAAGun_.*" );
			Util.SetMaxUsers( 2, "ATTACK_Allies_EastAAGun_.*" );

			SetGoalRole( "DEFEND_Axis_EastAAGun_.*", { ROLE.DEFENDER2, ROLE.DEFENDER3 } );
			SetGoalRole( "ATTACK_Allies_EastAAGun_.*", { ROLE.ATTACKER2, ROLE.ATTACKER3 } );
		}

		Util.MapDebugPrint( "^5West_AA_Gun_Destroyed" );
	},

	Thirty_second = function()
	{
		Util.MapDebugPrint( "^5Thirty_second" );

		sleep(30);

		if ( !Map.Allies_Win )
		{
			Util.MapDebugPrint( "^5Axis_Win" );

			sleep(1);
			ETUtil.WinningChat( TEAM.AXIS );
			sleep(1.5);
			ETUtil.LosingChat( TEAM.ALLIES );
		}
	},

	Apartment_Complex_Door_1_Exploded = function()
	{
		Map.ApartmentComplexDoor1Exploded = true;

		Util.DisableGoal( "GRENADE_Apartment_Complex_Door_1_.*" );

		Util.EnableGoal( "ROUTE_Garden_Apartment_Door_1" );

		Util.MapDebugPrint( "^5Apartment_Complex_Door_1_Exploded" );
	},

	Apartment_Complex_Door_2_Exploded = function()
	{
		Map.ApartmentComplexDoor2Exploded = true;

		Util.DisableGoal( "GRENADE_Apartment_Complex_Door_2_.*" );

		Util.MapDebugPrint( "^5Apartment_Complex_Door_2_Exploded" );
	},

	Church_Alley_Door_Exploded = function()
	{
		Map.ChurchAlleyDoorExploded = true;

		Util.DisableGoal( "GRENADE_Church_Alley_Door_.*" );

		if ( !Map.Axis_Outer_Blockade )
		{
			Util.EnableGoal( "ROUTE_Past_OuterBlockade_R" );
			Util.EnableGoal( "ROUTE_Church_Door" );
			Util.EnableGoal( "ROUTE_Church_AleyDoor" );
		}

		Util.MapDebugPrint( "^5Church_Alley_Door_Exploded" );
	},

	Fixed_Forward_Spawn = function()
	{
		Map.Forward_Spawn_Fixed = true;

		Util.MapDebugPrint( "^5Fixed_Forward_Spawn" );
	},

	Fixed_outer_blockade = function()
	{
		Map.Outer_Blockade_fixed = true;

		Util.MapDebugPrint( "^5Fixed_outer_blockade" );
	},

	Allies_Inside_First =
	{
		Name = "Allies_Inside_First",
		TriggerOnClass = CLASS.ANYPLAYER,

		OnEnter = function(ent)
		{
			if( GetEntTeam(ent) == TEAM.ALLIES )
			{
				if ( Map.AlliesInsideFirst[ent] )
				{
					Map.AlliesInsideFirst[ent] += 1;
				}
				else
				{
					Map.AlliesInsideFirst[ent] = 1;
				}

				if ( tableCount(Map.AlliesInsideSecond) < 1 )
				{
					Map.SetSpawn();

					if ( !Map.Hotel_Gate )
					{
						SetAvailableMapGoals( TEAM.AXIS, false, ".*_Axis_HotelGate_.*" );

						if ( Map.Dock_AA_Gun )
						{
							SetAvailableMapGoals( TEAM.AXIS, true, ".*_Axis_First_DockArea_.*" );
						}
					}

					SetAvailableMapGoals( TEAM.AXIS, false, {
						".*_Axis_MainGates_.*",
						".*_Axis_OuterBlockade_CP_.*",
						".*_Axis_OuterBlockade_R_.*",
					});

					if ( Map.West_AA_Gun or Map.East_AA_Gun )
					{
						if ( !Map.Axis_Inner_Blockade )
						{
							SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_Axis_Inner_Blockade" );
						}

						SetAvailableMapGoals( TEAM.AXIS, true, {
							".*_Axis_First_CPArea_.*",
							".*_Axis_First_OuterBlockadeCP_.*",
							".*_Axis_First_OuterBlockadeR_.*",
						});
					}

					Util.MapDebugPrint( "^5Allies entered into first trigger" );
				}
			}
		},
		OnExit = function(ent)
		{
			if ( Map.AlliesInsideFirst[ent] )
			{
				if ( Map.AlliesInsideFirst[ent] > 1 )
				{
					Map.AlliesInsideFirst[ent] -= 1;
				}
				else
				{
					Map.AlliesInsideFirst[ent] = null;
				}
			}

			if ( tableCount(Map.AlliesInsideFirst) < 1 )
			{
				Map.SetSpawn();

				SetAvailableMapGoals( TEAM.AXIS, false, {
					".*_Axis_First_DockArea_.*",
					".*_Axis_First_CPArea_.*",
					".*_Axis_First_OuterBlockadeCP_.*",
					".*_Axis_First_OuterBlockadeR_.*",
				});

				if ( !Map.Axis_Inner_Blockade )
				{
					SetAvailableMapGoals( TEAM.AXIS, false, "BUILD_Axis_Inner_Blockade" );
				}

				if ( Map.Dock_AA_Gun )
				{
					SetAvailableMapGoals( TEAM.AXIS, true, ".*_Axis_HotelGate_.*" );
				}

				SetAvailableMapGoals( TEAM.AXIS, true, {
					".*_Axis_MainGates_.*",
					".*_Axis_OuterBlockade_CP_.*",
					".*_Axis_OuterBlockade_R_.*",
				});

				Util.MapDebugPrint( "^5Allies in first trigger = 0" );
			}
		},
	},

	Allies_Inside_Second =
	{
		Name = "Allies_Inside_Second",
		TriggerOnClass = CLASS.ANYPLAYER,

		OnEnter = function(ent)
		{
			if( GetEntTeam(ent) == TEAM.ALLIES )
			{
				if ( Map.AlliesInsideSecond[ent] )
				{
					Map.AlliesInsideSecond[ent] += 1;
				}
				else
				{
					Map.AlliesInsideSecond[ent] = 1;
				}

				if ( Map.Outer_Blockade_fixed and !Map.Axis_Outer_Blockade )
				{
					SetAvailableMapGoals( TEAM.AXIS, false, {
						"BUILD_Axis_Outer_Blockade",
					});
				}

				if ( Map.Tank )
				{
					SetAvailableMapGoals( TEAM.AXIS, false, "MOUNT_Tank" );
				}
				else
				{
					SetAvailableMapGoals( TEAM.AXIS, false, "BUILD_Tank" );
				}

				SetAvailableMapGoals( TEAM.AXIS, false, {
					".*_Axis_First_DockArea_.*",
					".*_Axis_First_CPArea_.*",
					".*_Axis_First_OuterBlockadeCP_.*",
					".*_Axis_First_OuterBlockadeR_.*",
					".*_Axis_HotelGate_.*",
				});

				Map.SetSpawn();

				if ( Map.West_AA_Gun or Map.East_AA_Gun )
				{
					SetAvailableMapGoals( TEAM.AXIS, true, ".*_Axis_Second_CPArea_.*" );
				}
				else
				{
					SetAvailableMapGoals( TEAM.AXIS, true, ".*_Axis_Forced_DockAAGunDefend_.*" );
				}

				if ( Map.Dock_AA_Gun )
				{
					if ( tableCount(Map.AlliesNearDockAAGun) < 1 and tableCount(Map.AlliesNearAAGuns) < 1 )
					{
						if ( Map.Dock_AA_Gun )
						{
							SetAvailableMapGoals( TEAM.AXIS, true, ".*_Axis_Second_DockArea_.*" );
						}

						if ( Map.West_AA_Gun or Map.East_AA_Gun )
						{
							SetAvailableMapGoals( TEAM.AXIS, true, {
								".*_Axis_Second_BunkerSewGr_.*",
								".*_Axis_Second_CourtyardSewGr_.*",
							});

							if ( Map.Axis_Inner_Blockade )
							{
								SetAvailableMapGoals( TEAM.AXIS, true, {
									"REPAIRMG42_axis_inner_blockade_mg42",
									"MOUNTMG42_axis_inner_blockade_mg42",
								});
							}
							else
							{
								SetAvailableMapGoals( TEAM.AXIS, true, {
									"BUILD_Axis_Inner_Blockade",
								});
							}
						}

						if ( !Map.ApartmentComplexDoor1Exploded )
						{
							SetAvailableMapGoals( TEAM.AXIS, true, "GRENADE_Apartment_Complex_Door_1.*" );
						}
						if ( !Map.ApartmentComplexDoor2Exploded )
						{
							SetAvailableMapGoals( TEAM.AXIS, true, "GRENADE_Apartment_Complex_Door_2.*" );
						}

						Util.MapDebugPrint( "^5Allies entered into second trigger" );
					}
				}
				else
				{
					if ( tableCount(Map.AlliesNearAAGuns) < 1 )
					{
						if ( Map.West_AA_Gun or Map.East_AA_Gun )
						{
							SetAvailableMapGoals( TEAM.AXIS, true, {
								".*_Axis_Second_BunkerSewGr_.*",
								".*_Axis_Second_CourtyardSewGr_.*",
							});

							if ( Map.Axis_Inner_Blockade )
							{
								SetAvailableMapGoals( TEAM.AXIS, true, {
									"REPAIRMG42_axis_inner_blockade_mg42",
									"MOUNTMG42_axis_inner_blockade_mg42",
								});
							}
							else
							{
								SetAvailableMapGoals( TEAM.AXIS, true, {
									"BUILD_Axis_Inner_Blockade",
								});
							}
						}

						if ( !Map.ApartmentComplexDoor1Exploded )
						{
							SetAvailableMapGoals( TEAM.AXIS, true, "GRENADE_Apartment_Complex_Door_1.*" );
						}
						if ( !Map.ApartmentComplexDoor2Exploded )
						{
							SetAvailableMapGoals( TEAM.AXIS, true, "GRENADE_Apartment_Complex_Door_2.*" );
						}

						Util.MapDebugPrint( "^5Allies entered into second trigger" );
					}
				}
			}
		},
		OnExit = function(ent)
		{
			if (Map.AlliesInsideSecond[ent])
			{
				if ( Map.AlliesInsideSecond[ent] > 1 )
				{
					Map.AlliesInsideSecond[ent] -= 1;
				}
				else
				{
					Map.AlliesInsideSecond[ent] = null;
				}
			}

			if ( tableCount(Map.AlliesInsideSecond) < 1 )
			{
				Map.SetSpawn();

				if ( Map.Outer_Blockade_fixed and !Map.Axis_Outer_Blockade )
				{
					SetAvailableMapGoals( TEAM.AXIS, true, {
						"BUILD_Axis_Outer_Blockade",
					});
				}

				if ( Map.Tank )
				{
					SetAvailableMapGoals( TEAM.AXIS, true, "MOUNT_Tank" );
				}
				else
				{
					SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_Tank" );
				}

				SetAvailableMapGoals( TEAM.AXIS, false, {
					".*_Axis_Second_DockArea_.*",
					".*_Axis_Second_CPArea_.*",
					".*_Axis_Second_BunkerSewGr_.*",
					".*_Axis_Second_CourtyardSewGr_.*",
					".*_Axis_Forced_DockAAGunDefend_.*",
				});

				if ( Map.Axis_Inner_Blockade )
				{
					SetAvailableMapGoals( TEAM.AXIS, false, {
						"REPAIRMG42_axis_inner_blockade_mg42",
						"MOUNTMG42_axis_inner_blockade_mg42",
					});
				}

				if ( Map.Hotel_Gate )
				{
					if ( Map.Dock_AA_Gun )
					{
						SetAvailableMapGoals( TEAM.AXIS, true, ".*_Axis_HotelGate_.*" );
					}
				}

				if ( tableCount(Map.AlliesInsideFirst) > 0 )
				{
					if ( Map.Dock_AA_Gun )
					{
						SetAvailableMapGoals( TEAM.AXIS, true, ".*_Axis_First_DockArea_.*" );
					}

					SetAvailableMapGoals( TEAM.AXIS, true, ".*_Axis_First_CPArea_.*" );

					if ( Map.West_AA_Gun or Map.East_AA_Gun )
					{
						SetAvailableMapGoals( TEAM.AXIS, true, {
							".*_Axis_First_OuterBlockadeCP_.*",
							".*_Axis_First_OuterBlockadeR_.*",
						});
					}
				}

				Util.MapDebugPrint( "^5Allies in second trigger = 0" );
			}
		},
	},

	Allies_Near_Dock_AAGun =
	{
		Name = "Allies_Near_Dock_AAGun",
		TriggerOnClass = CLASS.ANYPLAYER,

		OnEnter = function(ent)
		{
			if( GetEntTeam(ent) == TEAM.ALLIES )
			{
				if (Map.AlliesNearDockAAGun[ent])
				{
					Map.AlliesNearDockAAGun[ent] += 1;
