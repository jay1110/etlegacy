				SetAvailableMapGoals( TEAM.AXIS, false, ".*_Axis_Second_DockArea_.*" );

				SetAvailableMapGoals( TEAM.AXIS, true, ".*_Axis_DockAAGun_.*" );

				Util.MapDebugPrint( "^5Allies entered into Dock AA Gun trigger" );
			}
		},
		OnExit = function(ent)
		{
			if ( Map.AlliesNearDockAAGun[ent] )
			{
				if (Map.AlliesNearDockAAGun[ent] > 1)
				{
					Map.AlliesNearDockAAGun[ent] -= 1;
				}
				else
				{
					Map.AlliesNearDockAAGun[ent] = null;
				}
			}

			if ( tableCount(Map.AlliesNearDockAAGun) < 1 )
			{
