				{
					SetAvailableMapGoals( TEAM.AXIS, true, ".*_Axis_WestAAGun_.*" );
				}

				if ( Map.West_AA_Gun )
				{
					if ( tableCount(Map.AlliesNearWestAAGuns) < 1 )
					{
