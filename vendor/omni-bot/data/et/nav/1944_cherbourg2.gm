	Axis_Command_Post_Built = function()
	{
		Map.Axis_CP = true;

		Map.SetSpawn();

		Util.DisableGoal( {
			"BUILD_Command_Post",
		});

		SetAvailableMapGoals( TEAM.AXIS, false, {
			"ATTACK_Axis_CP_.*",
		});

		SetAvailableMapGoals( TEAM.ALLIES, true, {
			"PLANT_Command_Post",
			"ATTACK_Allies_CP_.*",
