					{
						if ( !Map.Axis_Bunker_Sewer_Grate )
						{
							SetAvailableMapGoals( TEAM.AXIS, true, {
								"DEFEND_Axis_Help_EastAAGun_01",
								"DEFEND_Axis_Help_EastAAGun_02",
							});
						}

						if ( !Map.Courtyard_Sewer_Grate )
						{
							SetAvailableMapGoals( TEAM.AXIS, true, {
