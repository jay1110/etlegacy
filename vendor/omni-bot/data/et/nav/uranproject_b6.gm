        OnExit = function(ent)
        {
            
            if(GetEntTeam(ent) == TEAM.ALLIES )
            {
                if (GetEntFlags( ent, ENTFLAG.CARRYINGGOAL))
                {
                    b = Util.GetBotByName(GetEntName(ent));
                    if (b)
                    {
                        b.SayTeam("I Have Picked Up OBJECTIVE");                        
                    }
                 Util.MapDebugPrint( "^28_ALLIED ^ePLAYER IS AT THE AXIS_CAPPOINT_ROOM ^2EXIT WITH THE OBJECTIVE" );  //works              
                     //SetAvailableMapGoals( TEAM.ALLIES, false, "FLAG_secretdocs1" );   
                }
            		//Util.MapDebugPrint( "^212_ALLIED ^ePLAYER IS at THE ^6AXIS_CAPPOINT_ROOM EXIT" );//works
            }
            if(GetEntTeam(ent) == TEAM.AXIS )
            {
                if (GetEntFlags( ent, ENTFLAG.CARRYINGGOAL))
                {
                    b = Util.GetBotByName(GetEntName(ent));
                    if (b)
                    {
                        b.SayTeam("I Have The OBJECTIVE");                        
                    }              
                    //SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_tunnel_.*" );     
            		Util.MapDebugPrint( "^215_AXIS ^ePLAYER IS AT THE AXIS_CAPPOINT_ROOM ^2EXIT WITH THE ^1OBJECTIVE" ); //works   
                }
            		//Util.MapDebugPrint( "^216_AXIS ^ePLAYER IS at AXIS_CAPPOINT_ROOM EXIT" );//works
            }        

		//Util.MapDebugPrint( "^2EXIT" );         
        },
       
    },

