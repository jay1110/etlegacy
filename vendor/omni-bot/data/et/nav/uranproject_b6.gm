    axisspawnchange =
    {
        Name = "axisspawnchange",
        TriggerOnClass = CLASS.ANYPLAYER,
        OnEnter = function(ent)
        {
            if(GetEntTeam(ent) == TEAM.AXIS )
            {
                    b = Util.GetBotByName(GetEntName(ent));
                    if (b)
                    {
                        b.SayTeam("AXIS Im in the axisspawnchange");
                            Map.SetSpawn1;                     
                    }
                if (GetEntFlags( ent, ENTFLAG.CARRYINGGOAL))
                {
                    b = Util.GetBotByName(GetEntName(ent));
                    if (b)
                    {
                        b.SayTeam("AXIS OBJECTIVE axisspawnchange");
                                                
                    }
                    //SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_tunnel_.*" );                                                                                              
                Util.MapDebugPrint( "^6AXIS ^ePLAYER at axisspawnchange WITH THE ^1OBJECTIVE" ); //works                   
                }
            Util.MapDebugPrint( "^2AXIS ^ePLAYER IS AT axisspawnchange" );//works
            }            
		Util.MapDebugPrint( "^2ENTER axisspawnchange" );         
        },
        OnExit = function(ent)
        {
            
            if(GetEntTeam(ent) == TEAM.AXIS )
            {
                if (GetEntFlags( ent, ENTFLAG.CARRYINGGOAL))
                {
                    b = Util.GetBotByName(GetEntName(ent));
                    if (b)
                    {
                        b.SayTeam("I Have Picked Up OBJECTIVE");                        
                    }
                 Util.MapDebugPrint( "^2AXIS^ePLAYER IS AT spawnchange WITH THE OBJECTIVE" );  //works              
                     //SetAvailableMapGoals( TEAM.ALLIES, false, "FLAG_secretdocs1" ); 
                }
            		Util.MapDebugPrint( "^6AXIS ^ePLAYER IS at THE ^6AXIS spawnchange EXIT" );//works
            }
            if(GetEntTeam(ent) == TEAM.ALLIES )
            {
                if (GetEntFlags( ent, ENTFLAG.CARRYINGGOAL))
                {
                    b = Util.GetBotByName(GetEntName(ent));
                    if (b)
                    {
                        b.SayTeam("I Have The OBJECTIVE");                        
                    }              
                    //SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_tunnel_.*" );     
            		Util.MapDebugPrint( "^6ALLIES ^ePLAYER IS AT THE AXIS_CAPPOINT_ROOM ^2EXIT WITH THE ^1OBJECTIVE" ); //works   
                }
            		Util.MapDebugPrint( "^6ALLIES ^ePLAYER IS at AXIS_CAPPOINT_ROOM EXIT" );//works
            }        

		Util.MapDebugPrint( "^2EXIT axisspawnchange" );         
        },
       
    },




//spawn at lab
	SetSpawn1 = function(bot)
	{
		if (bot.GetTeam() == TEAM.AXIS) {
            
			if (Map.oldbunkergone == true)
            {
                
				bot.ChangeSpawnPoint(2);
			} 
		}
	},

	SetSpawn = function()
	{
		foreach(bot in BotTable)
		{
			Map.SetSpawn1(bot);
		}
	},





