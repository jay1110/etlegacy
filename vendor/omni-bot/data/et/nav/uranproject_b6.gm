	Bunker_Backdoor_Destroyed = function( trigger )
	{
            //ETUtil.SuicideSpawn( TEAM.AXIS, 6, -1 );

                        if (Map.securitydooropen == true)//open
                {
                    Util.ChangeSpawn( TEAM.AXIS, 8 );
                    //ETUtil.SuicideSpawn( TEAM.AXIS, 8, -1 );
                                
                    SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_backdoorinside_.*" );
                    SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_main" );
SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_Main_Bunker_Entrance" ); 
                    SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_funnel_entrance" );
                    SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_maingate_.*" ); 
                    
                    Util.DisableGoal( "SWITCH_towerdoor", true );
                    Util.DisableGoal( "SWITCH_funnelmaingate", true );
                    SetAvailableMapGoals( TEAM.ALLIES, false, "SWITCH_funnelmaingate" );
                    SetAvailableMapGoals( TEAM.AXIS, false, "SWITCH_funnelmaingate" ); 
                    Util.DisableGoal( "PLANT_Bunker_Backdoor___Dynamite_it", true );
                    Util.DisableGoal( "BUILD_Bridge", true );
                    //Util.DisableGoal( "PLANT_funnel_entrance", true );
                    Util.DisableGoal( "PLANT_Outpost_Entrance", true );
                    Util.DisableGoal( "PLANT_Ventilator", true );
                    Util.DisableGoal( "BUILD_second_Bridge", true );
                    Util.DisableGoal( "PLANT_second_Bridge", true );
                    Util.DisableGoal( "PLANT_Bridge", true );  
                }
            else 
            {
                    Util.EnableGoal( "SWITCH_towerdoor", true );
                    Util.DisableGoal( "SWITCH_funnelmaingate", true ); 
                    SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_funnel_entrance" ); 
                    SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_main" );
SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_Main_Bunker_Entrance" );   
            }
        Map.backdoorintact = false;
        Map.backdoorgone = true;
        Util.ChangeSpawn( TEAM.AXIS, 8 );
                SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_backdoorinside_.*" ); 
        	SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_backdoorinside_1" );    
    SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_backdoorinside_2" ); 
