    door4start = function( trigger )//door fucked up door3istoplevel
	{
        if ( trigger.Action == "0.00 60.00 0.00" )//opening but is closed              
		          {
                    Map.lockdoor2Closed = false;
                    Map.lockdoor2Opened = true;
                      Map.lockdoor2status = 1;//opened
            			//Map.Switches.inside_elevator_ontoplevel.Enabled = true; //ride down
                        //Map.Switches.inside_elevator_onbottomlevel.Enabled = false; //ride up
                        //Map.Switches.elevator_groundlevel.Enabled = false; //call to the top
                        //Map.Switches.elevator_bottomlevel.Enabled = true;  //call to the bottom
                        
	SetAvailableMapGoals( TEAM.ALLIES, false, "SWITCH_lockdoor2" );    

	SetAvailableMapGoals( TEAM.AXIS, true, "SWITCH_lockdoor2" );    
        
			                             Util.MapDebugPrint("^6lockdoor2status OPENING", true);			
		}
		else
		{
                    Map.lockdoor2Closed = true;
                    Map.lockdoor2Opened = false;            
            Map.lockdoor2status = 0; //closed 
    SetAvailableMapGoals( TEAM.ALLIES, true, "SWITCH_lockdoor2" );    
 
	SetAvailableMapGoals( TEAM.AXIS, false, "SWITCH_lockdoor2" );    
        
			Util.MapDebugPrint("^6lockdoor2status CLOSING", true);			
		}
	},    
