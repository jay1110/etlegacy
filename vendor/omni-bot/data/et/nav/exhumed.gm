global OnMapLoad = function()
{
	OnTrigger("MISSING_STRING", Map.Charge_Booster_Built);
	OnTrigger("MISSING_STRING", Map.Allied_West_Door_Destroyed);
	OnTrigger("MISSING_STRING", Map.Axis_South_Door_Destroyed);
	OnTrigger("MISSING_STRING", Map.Charge_Booster_Destroyed);
	OnTrigger("MISSING_STRING", Map.Pyramid_Door_Destroyed);
	OnTrigger("MISSING_STRING", Map.east_tomb_door_Destroyed);
	OnTrigger("MISSING_STRING", Map.north_tomb_door_Destroyed);
	OnTrigger("MISSING_STRING", Map.south_tomb_door_Destroyed);
	OnTrigger("MISSING_STRING", Map.west_tomb_door_Destroyed);
	OnTrigger("MISSING_STRING", Map.mummy_Taken);
	OnTrigger("MISSING_STRING", Map.mummy_Returned);
	OnTrigger("MISSING_STRING", Map.mummy_Secured);
	OnTrigger("MISSING_STRING", Map.dungeonflag_Axis_Captured);
	OnTrigger("MISSING_STRING", Map.dungeonflag_Allies_Captured);

	//~Util.DisableGoal(".*", true);
	//~SetAvailableMapGoals(TEAM.AXIS, true, "ATTACK.*");
	//~SetAvailableMapGoals(TEAM.ALLIES, true, "ATTACK.*");

	//Util.SetMaxUsers(1, "MOUNTMG42.*");
    Util.AddUseWp("PLANT_south_tomb_door", "plant_south_tomb_door");// Antenna is the waypoint name
    Util.AddUseWp("PLANT_north_tomb_door", "plant_north_tomb_door");// Antenna is the waypoint name
    Util.AddUseWp("PLANT_east_tomb_door", "plant_east_tomb_door");// Antenna is the waypoint name
    Util.AddUseWp("PLANT_west_tomb_door", "plant_west_tomb_door");// Antenna is the waypoint name    
    Util.AddUseWp("PLANT_Axis_South_Door", "near_axis_south_door_plant");// Antenna is the waypoint name
    Util.AddUseWp("PLANT_Pyramid_Door", "plant_pyramid_door");// Antenna is the waypoint name
    Util.AddUseWp("PLANT_Allied_West_Door", "near_allied_west_door_plant");// Antenna is the waypoint name
	//SetMapGoalProperties("MOUNTMG42.*", {MinCampTime=15, MaxCampTime=90});
    SetGoalPriority( "PLANT_south_tomb_door", .96, TEAM.AXIS, 0 );
    SetGoalPriority( "PLANT_Axis_South_Door", .94, TEAM.AXIS, 0 );
    SetGoalPriority( "PLANT_Pyramid_Door", .95, TEAM.AXIS, 0 );    
    SetGoalPriority( "FLAG_mummy", .97, TEAM.AXIS, 0 );
    SetGoalPriority( "CAPPOINT_mummysecuredontruck", .98, TEAM.AXIS, 0 );
   // SetGoalPriority( "CHECKPOINT_dungeonflag", .99, TEAM.AXIS, 0 );

	Util.MapDebugPrint("Omni-bot map script for " + GetMapName() + " executed.");
        if ( GetGameState() == "Playing" )
	{
		sleep(15);
		Util.BotChat( 0, "say", "Ets|^1C^2Y^3B^6E^5R^04^1W^2O^3L^6F ^6Omni-bot map script ^2ver 1.0 ^3For the map: ^7" + GetMapName() + " running" , 1 );
	}
};

