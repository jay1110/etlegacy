				crucialClass = CLASS.ENGINEER,
			},
		},
	},

	La_Barrera_Aliada_Built = function( trigger )
	{
		Util.MapDebugPrint( "^6La_Barrera_Aliada_Built" );
	},

	La_Rampa_Built = function( trigger )
	{

		Util.MapDebugPrint( "^6La_Rampa_Built" );
	},

	Tank_Built = function( trigger )
	{
	SetAvailableMapGoals( TEAM.AXIS, true, "ESCORT_TANK" );
	SetAvailableMapGoals( TEAM.AXIS, true, "MOUNT_TANK" );
		Util.MapDebugPrint( "^6Tank_Built" );
	},
    
    Command_Post_Built = function( trigger )
	{
		Util.MapDebugPrint( "^6Command_Post_Built" );
	},

	Command_Post_Destroyed = function( trigger )
