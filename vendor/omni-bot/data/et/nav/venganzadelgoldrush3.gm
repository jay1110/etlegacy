	Bank_Broken_Into = function( trigger )
	{
	SetAvailableMapGoals( TEAM.AXIS, true, "CAPPOINT_Gold_Dropoff_2" );
	SetAvailableMapGoals( TEAM.AXIS, true, "PLANT_Obstaculo_Destruible" );
SetGoalPriority( "PLANT_Obstaculo_Destruible", 0.93, TEAM.AXIS, CLASS.ENGINEER );
	SetAvailableMapGoals( TEAM.AXIS, false, "ESCORT_TANK" );
	SetAvailableMapGoals( TEAM.AXIS, false, "MOUNT_TANK" );
		Util.MapDebugPrint( "^6Bank_Broken_Into" );
	},

};

global OnMapLoad = function()
{
	// Register callback functions
	OnTrigger( "^eEl tanque ha llegado a su destino!!!", Map.Bank_Broken_Into );
	OnTrigger( "MISSING_STRING", Map.Command_Post_Built );
	OnTrigger( "La Barrera ha sido construida", Map.La_Barrera_Aliada_Built );
	OnTrigger( "La Rampa ha sido construida", Map.La_Rampa_Built );
	OnTrigger( "El tanque ha sido reparado!", Map.Tank_Built );
	OnTrigger( "MISSING_STRING", Map.Command_Post_Destroyed );
	OnTrigger( "MISSING_STRING", Map.La_Barrera_Aliada_Destroyed );
	OnTrigger( "goldrush_allies_tankbar_destroyed", Map.La_Rampa_Destroyed );
	OnTrigger( "Obstaculo Destruible Destroyed.", Map.Obstaculo_Destruible_Destroyed );
	OnTrigger( "Axis have stolen The Gold Bars!", Map.Gold_Bars_Taken );
	OnTrigger( "Flag returned Gold Bars!", Map.Gold_Bars_Returned );
	OnTrigger( "goldrush_allies_gold1_secured", Map.Gold_Bars_Secured_1 );
	OnTrigger( "goldrush_allies_gold2_secured", Map.Gold_Bars_Secured_2 );    
	OnTrigger( "CHECKPOINT_bunker_flag to team 1", Map.bunker_flag_Axis_Captured );
	OnTrigger( "CHECKPOINT_bunker_flag to team 2", Map.bunker_flag_Allies_Captured );

	//~Util.DisableGoal( ".*", true ); // all but routes
	SetAvailableMapGoals( TEAM.AXIS, false, "ATTACK_.*" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "DEFEND_.*" );
    
	SetAvailableMapGoals( TEAM.AXIS, false, "MOUNTMG42_mg42_.*" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "MOUNTMG42_mg42_.*" );    


	SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_La_Barrera_Aliada" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "CHECKPOINT_bunker_flag" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Command_Post" );

	SetAvailableMapGoals( TEAM.AXIS, true, "PLANT_La_Barrera_Aliada" );

	SetAvailableMapGoals( TEAM.AXIS, true, "CHECKPOINT_bunker_flag" );
	SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_La_Rampa" );
	SetAvailableMapGoals( TEAM.AXIS, false, "CAPPOINT_Gold_Dropoff_2" );
	SetAvailableMapGoals( TEAM.AXIS, false, "FLAG_Gold_Bars" );
	SetAvailableMapGoals( TEAM.AXIS, false, "PLANT_Obstaculo_Destruible" );

	SetAvailableMapGoals( TEAM.AXIS, false, "ESCORT_TANK" );
	SetAvailableMapGoals( TEAM.AXIS, false, "MOUNT_TANK" );
	SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_Command_Post" );

	SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_TANK" );

	SetGoalPriority( "BUILD_TANK", 0.92, TEAM.AXIS );
	SetGoalPriority( "ESCORT_TANK", 0.91, TEAM.AXIS );
	SetGoalPriority( "PLANT_La_Barrera_Aliada", 0.93, TEAM.AXIS );
	SetGoalPriority( "BUILD_La_Rampa", 0.91, TEAM.AXIS );
	SetGoalPriority( "FLAG_Gold_Bars", 1.0, TEAM.AXIS );
	SetGoalPriority( "CAPPOINT_Gold_Dropoff_2", 1.10, TEAM.AXIS );
    SetGoalPriority( "PLANT_La_Barrera_Aliada", 0.93, TEAM.AXIS );
//~Los Axis han capturado la Bandera = checkpoint_flag 586:1
//~La_Barrera_Aliada = barrier 1 399:1
//~Obstaculo_Destruible = rock hiding the gold
//~La_Rampa = ramp for the tank to get into the bank 400:1
//SetAvailableMapGoals( TEAM.AXIS, false, "PLANT_Obstaculo_Destruible" );
 Util.AddUseWp("PLANT_La_Barrera_Aliada", "b1_plant");// Antenna is the waypoint name
 Util.AddUseWp("PLANT_La_Barrera_Aliada", "b2_plant");// Antenna is the waypoint name
        //SetGoalPriority( "PLANT_La_Barrera_Aliada", 0.91, TEAM.AXIS, CLASS.ENGINEER );
 Util.AddUseWp("PLANT_Obstaculo_Destruible", "plant_rock");// Antenna is the waypoint name
 Util.AddUseWp("CAPPOINT_Gold_Dropoff_2", "cappoint_gold");// Antenna is the waypoint name
        //SetGoalPriority( "PLANT_Obstaculo_Destruible", 0.93, TEAM.AXIS, CLASS.ENGINEER );

	// Max users per goal
	//Util.SetMaxUsers( 1, "MOUNTMG42_.*" );

	// Camp times
	//SetMapGoalProperties( "MOUNTMG42_.*", {MinCampTime=15, MaxCampTime=90} );


	Util.MapDebugPrint( "^6ETS^4| ^2Custom ^4- ^5c4w ^3Omni-bot map script ver. ^61.0 is ^2LOADED ^3For the map: ^7" + GetMapName() + " executed." );
	print( "^6ETS^4| ^2Custom ^1- ^4c4w ^3Omni-bot map script ver. ^61.0 is ^2LOADED ^3For the map: ^7" + GetMapName() );
	
	Util.BotChat( 0, "say", "^6ETS^4| ^2Custom ^1- ^4c4w ^3Omni-bot map script ver. ^61.0 is ^2LOADED ^3For the map: ^7" + GetMapName(), 1 );
};

global OnBotJoin = function( bot )
{
	// Uncomment for shootable breakables
	bot.TargetBreakableDist = 90.0;
	// Only set MaxViewDistance on maps with limited sight (e.g. fog)
	//~bot.MaxViewDistance = 2400;
};

