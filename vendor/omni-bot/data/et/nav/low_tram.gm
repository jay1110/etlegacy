				GetGoal("CAMP_Allies_Escort_2").AimVectors = { Vec3(0.334, -0.774, 0.538), Vec3(-0.346, 0.904, 0.253) };
				Util.SetGoalPosition(3593.952, 398.618, 1545.954, "CAMP_Allies_Escort_4");
				GetGoal("CAMP_Allies_Escort_2").AimVectors = { Vec3(0.780, -0.424, 0.460), Vec3(0.356, 0.905, 0.231) };
				
				SetAvailableMapGoals( TEAM.ALLIES, true, "CAMP_Allies_Escort_.*" );
			}
			else if (GetEntPosition(i).x > 4600 )
			{
				SetAvailableMapGoals( TEAM.ALLIES, false, "CAMP_Allies_Escort_.*" );
			}
			else if (GetEntPosition(i).x >= 4063 and GetEntPosition(i).y >= 263 and GetEntPosition(i).z >= 1729 and
			GetEntPosition(i).x <= 4832 and GetEntPosition(i).y <= 836 and GetEntPosition(i).z <= 1850)
			{
				foreach ( goal in Util.GoalTable("CAMP_Allies_Escort_.*") )
				{
					goal.SetRange(1500);
				}
				
				Util.SetGoalPosition(4808.136, 1048.660, 1729.125, "CAMP_Allies_Escort_1");
				GetGoal("CAMP_Allies_Escort_1").AimVectors = { Vec3(-0.158, 0.987, 0.002), Vec3(-0.103, -0.994, -0.043) };
				Util.SetGoalPosition(4673.192, 928.196, 1729.125, "CAMP_Allies_Escort_2");
				GetGoal("CAMP_Allies_Escort_2").AimVectors = { Vec3(0.737, 0.676, 0.017), Vec3(0.290, -0.957, -0.020) };
				Util.SetGoalPosition(4688.802, 1261.765, 1729.125, "CAMP_Allies_Escort_3");
				GetGoal("CAMP_Allies_Escort_2").AimVectors = { Vec3(0.415, 0.910, 0.005), Vec3(0.120, -0.993, -0.022) };
				Util.SetGoalPosition(4805.861, 1151.771, 1729.125, "CAMP_Allies_Escort_4");
				GetGoal("CAMP_Allies_Escort_2").AimVectors = { Vec3(-0.088, -0.996, -0.003), Vec3(-0.148, 0.989, -0.020) };
				
				SetAvailableMapGoals( TEAM.ALLIES, true, "CAMP_Allies_Escort_.*" );
				
				foreach ( bot in BotTable )
				{
					goal = bot.GetMapGoalName();
					if ( goal == "CAMP_Allies_Escort_1" or goal == "CAMP_Allies_Escort_2" or goal == "CAMP_Allies_Escort_3" or goal == "CAMP_Allies_Escort_4" )
					{
						bot.DisableCombatMovement = true;
						bot.HoldButton(BTN.SPRINT, 0.2);
					}
					else
					{
						bot.DisableCombatMovement = false;
					}
				}
			}
			else if ((GetEntPosition(i).x >= 3151 and GetEntPosition(i).y >= -1300 and GetEntPosition(i).z >= 1885 and
			GetEntPosition(i).x <= 4481 and GetEntPosition(i).y <= 433 and GetEntPosition(i).z <= 2300) or
			(GetEntPosition(i).x >= 3189 and GetEntPosition(i).y >= -1300 and GetEntPosition(i).z >= 1400 and
