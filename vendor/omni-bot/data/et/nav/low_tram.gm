				GetGoal("CAMP_Allies_Escort_1").AimVectors = { Vec3(0.877, 0.476, 0.060), Vec3(0.285, 0.927, -0.245) };
				Util.SetGoalPosition(3509.020, -826.097, 1960.088, "CAMP_Allies_Escort_2");
				GetGoal("CAMP_Allies_Escort_2").AimVectors = { Vec3(0.697, 0.717, -0.006), Vec3(0.147, 0.958, -0.247) };
				Util.SetGoalPosition(3630.990, -655.960, 1937.726, "CAMP_Allies_Escort_3");
				GetGoal("CAMP_Allies_Escort_2").AimVectors = { Vec3(0.036, 0.968, -0.248), Vec3(0.748, 0.663, 0.041) };
				Util.SetGoalPosition(3837.134, -623.719, 1917.725, "CAMP_Allies_Escort_4");
				GetGoal("CAMP_Allies_Escort_2").AimVectors = { Vec3(0.493, 0.869, 0.046), Vec3(-0.112, 0.964, -0.242) };
				
				SetAvailableMapGoals( TEAM.ALLIES, true, "CAMP_Allies_Escort_.*" );
			}
			else if ((GetEntPosition(i).x >= 3189 and GetEntPosition(i).y >= 400 and GetEntPosition(i).z >= 1260 and
			GetEntPosition(i).x <= 4000 and GetEntPosition(i).y <= 1731 and GetEntPosition(i).z <= 1810) or
			(GetEntPosition(i).x >= 2075 and GetEntPosition(i).y >= 1378 and GetEntPosition(i).z >= 1050 and
			GetEntPosition(i).x <= 3151 and GetEntPosition(i).y <= 1735 and GetEntPosition(i).z <= 1330))
			{
