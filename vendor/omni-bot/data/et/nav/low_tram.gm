	Navigation =
	{
		//	/bot waypoint_setproperty paththrough Navigation_PT:jump
		jump =
		{
			navigate = function(_this)
			{
				_this.Bot.HoldButton(BTN.JUMP, 0.55);
				sleep(0.55);
			},
		},
		
		//	/bot waypoint_setproperty paththrough Navigation_PT:jump_wait
		jump_wait =
		{
			navigate = function(_this)
			{
				sleep(0.25);
				_this.Bot.HoldButton(BTN.JUMP, 0.55);
				sleep(0.55);
			},
		},
		
		//	/bot waypoint_setproperty paththrough Navigation_PT:tram_tower
		tram_tower =
		{
			EvalFunc = function()
			{
				return Map.Tramcar_3 == "Middle";
			},
			navigate = function()
			{
				this.Goto(this.Bot.GetPosition());
				
				while ( Map.Tramcar_3 == "Middle" )
				{
					yield();
				}
			},
		},
		
		//	/bot waypoint_setproperty paththrough Navigation_PT:tramcar
		tramcar =
		{
			OnExit = function(_this)
			{
				this.Bot.DisableCombatMovement = false;
				if ( !this.CurrentNavigation )
				{
					sleep(0.5);
					return;
				}
				
				botId_key = this.CurrentNavigation + "_botId";
				botReady_key = this.CurrentNavigation + "_Bot_Ready";
				
				Map.ReleaseSlot(_this, botId_key, botReady_key);
				
				if ( Map.Bot_Carrying_Goal_ID == this.Bot.GetGameId() )
				{
					Map.Bot_Carrying_Goal_Near_Tram = false;
					Util.MapDebugPrint( "Bot_Carrying_Goal - false" );
				}
			},
			
			navigate = function(_this)
			{
				this.Bot.DisableCombatMovement = true;
				this.Goto(this.Bot.GetPosition());
				wp = Wp.GetClosestWaypoint(this.Bot.GetPosition());
				this.CurrentNavigation = wp.name;
				botId_key = this.CurrentNavigation + "_botId";
				botReady_key = this.CurrentNavigation + "_Bot_Ready";
				
				sleep(0.5);
				if ( !this.CurrentNavigation )
				{
					Map.MoveWithTimeout(_this, wp.position, 15, 60);
					
					sleep(1.5);
					return;
				}
				
				slot = Map.ClaimSlot(_this, botId_key);
				
				if ( slot == -1 )
				{
					sleep(0.5);
					return;
				}
				
				if ( this.Bot.IsCarryingFlag() )
				{
					Map.Bot_Carrying_Goal_Near_Tram = true;
					Map.Bot_Carrying_Goal_ID = this.Bot.GetGameId();
					Util.MapDebugPrint( "Bot_Carrying_Goal - true" );
				}
				
				refs = {};
				
				switch ( this.CurrentNavigation )
				{
					case "Village":
					{
						tramA = "Tramcar_3";
						tramB = "Tramcar_4";
						state = "Bottom";
						refs[0] = Map.Reference_Points.Position[1];
						refs[1] = Map.Reference_Points.Position[2];
						refs[2] = Map.Reference_Points.Position[3];
					}
					case "Outpost_Bottom":
					{
						tramA = "Tramcar_3";
						tramB = "Tramcar_4";
						state = "Top";
						refs[0] = Map.Reference_Points.Position[0];
						refs[1] = Map.Reference_Points.Position[1];
						refs[2] = Map.Reference_Points.Position[2];
					}
					case "Outpost_Top":
					{
						tramA = "Tramcar_2";
						tramB = "Tramcar_1";
						state = "Bottom";
						refs[0] = Map.Reference_Points.Position[5];
						refs[1] = Map.Reference_Points.Position[6];
						refs[2] = Map.Reference_Points.Position[7];
					}
					case "Castle":
					{
						tramA = "Tramcar_2";
						tramB = "Tramcar_1";
						state = "Top";
						refs[0] = Map.Reference_Points.Position[4];
						refs[1] = Map.Reference_Points.Position[5];
						refs[2] = Map.Reference_Points.Position[6];
					}
				}
					
				if ( Map[tramA] != state and Map[tramB] != state )
				{
					Map.MoveWithTimeout(_this, Map.Wait_Positions[this.CurrentNavigation][slot], 55, 60);
				}
		
				Map[botReady_key][slot] = true;
				
				while ( Map[tramA] != state and Map[tramB] != state )
				{
					yield();
				}
				
				if ( Map[tramA] == state )
				{
					ent = GetGoal( "MOVER_tramcar_" + tramA.Right(1) ).GetEntity();
					
					if ( this.CurrentNavigation == "Village" or this.CurrentNavigation == "Outpost_Top" )
					{
						waitpos = 2;
					}
					else
					{
						waitpos = 1;
					}
					
					boardpos = 4;
					tram = tramA;
				}
				else
				{
					ent = GetGoal( "MOVER_tramcar_" + tramB.Right(1) ).GetEntity();
					
					if ( this.CurrentNavigation == "Village" or this.CurrentNavigation == "Outpost_Top" )
					{
						waitpos = 1;
					}
					else
					{
						waitpos = 2;
					}
					
					boardpos = 5;
					tram = tramB;
				}
				
				Map.MoveWithTimeout(_this, Map.Wait_Positions[this.CurrentNavigation][waitpos], 25, 50);
					
				if ( !Map.TramBoarding(_this, ent, tram, state, boardpos, slot) )
				{
					return;
				}
				
				pos = Map.GetGoalPos(_this);
				exitdata = Map.GetBestExit(_this, refs, pos, tram, this.CurrentNavigation);
				
				state = exitdata[0];
				exitpos = exitdata[1];
				altstate1 = exitdata[2];
				altexitpos1 = exitdata[3];
				altstate2 = exitdata[4];
				altexitpos2 = exitdata[5];
				
				Map.ReleaseSlot(_this, botId_key, botReady_key);
				
				while ( Map[tram] != state )
				{
					this.Bot.MoveTowards(this.Bot.GetPosition());
					this.Bot.HoldButton(BTN.CROUCH, 0.25);
					yield();
				}
				
				dowhile ( !this.Bot.MoveTowards(offsetPos, 15) )
				{
					offsetPos = GetEntityWorldSpace(ent, Map.Tram_Positions[exitpos]);
					
					if ( Map[tram] != state )
					{
						if ( altstate1 )
						{
							while ( Map[tram] != altstate1 )
							{
								dowhile ( !this.Bot.MoveTowards(offsetPos, 25) )
								{
									offsetPos = GetEntityWorldSpace(ent, Map.Tram_Positions[slot] );
									
									yield();
								}
								this.Bot.MoveTowards(this.Bot.GetPosition());
								this.Bot.HoldButton(BTN.CROUCH, 0.25);
								yield();
							}
							
							dowhile ( !this.Bot.MoveTowards(offsetPos, 15) )
							{
								offsetPos = GetEntityWorldSpace(ent, Map.Tram_Positions[altexitpos1]);
								yield();
								
								if ( Map[tram] != altstate1 )
								{
									if ( altstate2 )
									{
										while ( Map[tram] != altstate2 )
										{
											dowhile ( !this.Bot.MoveTowards(offsetPos, 25) )
											{
												offsetPos = GetEntityWorldSpace(ent, Map.Tram_Positions[slot] );
												
												yield();
											}
											this.Bot.MoveTowards(this.Bot.GetPosition());
											this.Bot.HoldButton(BTN.CROUCH, 0.25);
											yield();
										}
										
										dowhile ( !this.Bot.MoveTowards(offsetPos, 15) )
										{
											offsetPos = GetEntityWorldSpace(ent, Map.Tram_Positions[altexitpos2]);
											yield();
										}
									}
									else
									{
										return;
									}
								}
							}
						}
						else
						{
							return;
						}
					}
					yield();
				}	
			},
		},
	},

	MoveWithTimeout = function(_this, pos, radius, limit)
	{
		timer = 0;
		while ( !_this.Bot.MoveTowards(pos, radius) )
		{
			sleep(0.1);
			timer += 1;
			if ( timer > limit )
			{
				return false;
			}
		}
		return true;
	},

	TramBoarding = function(_this, ent, tram, state, boardpos, y)
	{
		dowhile ( !_this.Bot.MoveTowards(offsetPos, 25) )
		{
			offsetPos = GetEntityWorldSpace(ent, Map.Tram_Positions[boardpos]);
			
			if ( Map[tram] != state )
			{
				if ( _this.Bot.DistanceTo(offsetPos) < 70 )
				{
					break;
				}
				else
				{
					return false;
				}
			}
			yield();
		}
		
		timer = 0;
		dowhile ( !_this.Bot.MoveTowards(offsetPos, 25) )
		{
			offsetPos = GetEntityWorldSpace(ent, Map.Tram_Positions[y] );
			sleep(0.1);
			timer += 1;
			
			if ( timer > 100 )
			{
				return false;
			}
		}
		
		while ( Map[tram] != "Moving" )
		{
			yield();
		}
		return true;
	},
	
	ClaimSlot = function(_this, botId_key)
	{
		for ( i = 0; i <= 3; i += 1 )
		{
			if ( Map[botId_key][i] == -1 )
			{
				Map[botId_key][i] = _this.Bot.GetGameId();
				return i;
			}
		}
		return -1;
	},
	
	ReleaseSlot = function(_this, botId_key, botReady_key)
	{
		for ( i = 0; i <= 3; i += 1 )
		{
			if ( Map[botId_key][i] == _this.Bot.GetGameId() )
			{
				Map[botId_key][i] = -1;
				Map[botReady_key][i] = false;
				return;
			}
		}
	},

	GetGoalPos = function(_this)
	{
		goal = _this.Bot.GetMapGoalName();
		
		if ( !goal or goal.GoalType == "REVIVE" or goal.GoalType == "DEFUSE" )
		{
			return false;
		}
		
		return Util.GetMapGoalPosition(goal);
	},
	
	GetBestExit = function (_this, refs, pos, tram, location)
	{
		bestDistance = 999999;
		bestexit = 0;
		goal = _this.Bot.GetMapGoalName();
		
		foreach ( ref in refs )
		{
			d = DistanceBetween(ref, pos);
			if ( d < bestDistance )
			{
				bestDistance = d;
				bestexit = ref;
			}
		}
		
		foreach ( index and point in Map.Reference_Points.Position )
		{
			if ( bestexit == point )
			{
				name = Map.Reference_Points.String[index];
				
				if ( goal == "PLANT_lower_access_door" and ( tram == "Tramcar_3" or tram == "Tramcar_4" ))
				{
					ref = Map.Reference_Points.Position[2];
					name = Map.Reference_Points.String[2];
					index = 2;
				}
				
				Util.MapDebugPrint( "I'm exiting at " + name + " from tram " + tram.Right(1) + " goal " + ToString(goal) );
				break;
			}
		}
		
		exitdata = Map.ExitConfig[location][tram][index];
		
		return exitdata;
	},

	Outpost_Bridge_Built = function( trigger )
	{
		Map.Outpost_Bridge = true;
		Util.MapDebugPrint( "Outpost_Bridge_Built" );
		Wp.SetWaypointFlag( "Outpost_Bridge_1", "closed", false );
		
		Util.EnableGoal("ROUTE_OutpostOutsideRight_.*");
		
		SetAvailableMapGoals( TEAM.ALLIES, false, {
			"BUILD_outpost_bridge",
			".*_Allies_OutpostBridge_.*",
		});
		
		if ( Map.Supply_Room_Door )
		{
			SetAvailableMapGoals( TEAM.AXIS, false, ".*_Axis_OutpostCP_0[234]" );
			
			SetAvailableMapGoals( TEAM.AXIS, true, {
				".*_Axis_OutpostCP_0[01]",
				".*_Axis_OutpostCP_18",
				".*_Axis_OutpostCP_20",
				"PLANT_outpost_bridge",
			});
		}
	},
	
	Outpost_Bridge_Planted = function( trigger )
	{
		Util.MapDebugPrint( "Outpost_Bridge_Planted" );
		
		if ( Map.Supply_Room_Door )
		{
			foreach( goal in Util.GoalTable("DEFUSE_outpost_bridge_.*") )
			{
				goal.SetRoles(ROLE.ATTACKER1);
				goal.SetGoalPriority( TEAM.ALLIES, 0, 0.9 ); //return to default due to role
			}
		}
	},
	
