	Allied_Outpost_CP_Built = function( trigger )
	{
		Map.Allied_Outpost_CP = true;
		Util.MapDebugPrint( "Allied_Outpost_CP_Built" );
		
		Util.DisableGoal("BUILD_Outpost_Command_Post" );
		
		if ( !Map.Supply_Room_Door )
		{
			SetGoalRole( "PLANT_Outpost_Command_Post", ROLE.INFILTRATOR );
			Util.SetMaxUsers( 1, "PLANT_Outpost_Command_Post" );
		}
		
		SetAvailableMapGoals( TEAM.AXIS, true, "PLANT_Outpost_Command_Post" );
	},
	
