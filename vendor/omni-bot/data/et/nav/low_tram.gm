	Lower_Access_Door_Destroyed = function( trigger )
	{
		Map.Lower_Access_Door = false;
		Util.MapDebugPrint( "Lower_Access_Door_Destroyed" );
		
		Map.Village_Tram_Tower = TEAM.ALLIES;
		
		foreach( goal in Util.GoalTable("DEFUSE_lower_access_door.*") )
		{
			goal.SetAvailable(TEAM.AXIS, false);
		}
		
		SetAvailableMapGoals( TEAM.AXIS, false, {
			"PLANTMINE_Axis_LowerAccess_.*",
			"MOBILEMG42_Axis_LowerAccess_.*",
		});
		
		if ( Map.Outpost_Bridge )
		{
			SetAvailableMapGoals( TEAM.AXIS, false, "PLANT_outpost_bridge" );
		}
		
		if ( Map.Supply_Room_Door )
		{
			SetAvailableMapGoals( TEAM.AXIS, true, ".*_Axis_LowAccessDest_.*" );
			
			SetAvailableMapGoals( TEAM.ALLIES, true, ".*_Allies_LowAccessDest_.*" );
			
			SetGoalRole( "PLANT_supply_room_door", ROLE.ATTACKER );
		}
		
		if ( Map.Hatch )
		{
			SetGoalRole( "PLANT_hatch", ROLE.ATTACKER );
		}
		
		Map.SetSpawn();
	},
	
	Hatch_Planted = function( trigger )
	{
		Util.MapDebugPrint( "Hatch_Planted" );
		
