	Cablecar_Position_Debug = function()
	{
		keys =
		{
			"Village",
			"Outpost_Bottom",
			"Outpost_Top",
			"Castle"
		};
		
		for (;;)
        {
            for ( i = 0; i < tableCount(Map.Stations.Position); i += 1 )
			{
				pos = Map.Stations.Position[i];
				DrawText3d( pos + Vec3(0,0,40), Map.Stations.String[i], COLOR.RED, 0.05 );
			}
			
			for ( w = 0; w < tableCount(Map.Reference_Points.Position); w += 1 )
			{
				pos = Map.Reference_Points.Position[w];
				DrawText3d( pos + Vec3(0,0,40), Map.Reference_Points.String[w], COLOR.ORANGE, 0.05 );
				DrawDebugLine( pos + Vec3(0,0,40), pos - Vec3(0,0,25), COLOR.PINK, 0.05 );
			}
			
			for ( y = 1; y < 5; y += 1 )
			{
				ent = GetGoal("MOVER_tramcar_" + y).GetEntity();
				
				for ( x = 0; x < tableCount(Map.Tram_Positions); x += 1 )
				{
					offsetpos = GetEntityWorldSpace(ent, Map.Tram_Positions[x]);
					DrawDebugLine( offsetpos + Vec3(0,0,40), offsetpos - Vec3(0,0,25), COLOR.BLUE, 0.05 );
					DrawText3d( offsetpos + Vec3(0,0,40), Map.Strings.Ride[x], COLOR.YELLOW, 0.05 );
				}
			}
			
			for ( z = 0; z < 4; z += 1 )
			{
				foreach ( key in keys )
				{
					pos = Map.Wait_Positions[key][z];
					DrawText3d( pos + Vec3(0,0,40), Map.Strings.Wait[z], COLOR.CYAN, 0.05 );
					botId_key = key + "_botId";
					botReady_key = key + "_Bot_Ready";
					
					if ( Map[botId_key][z] == -1 )
					{
						c = COLOR.GREEN;
					}
					else if ( Map[botReady_key][z] )
					{
						c = COLOR.RED;
					}
					else
					{
						c = COLOR.YELLOW;
					}
					
					DrawDebugLine( pos + Vec3(0,0,40), pos - Vec3(0,0,25), c, 0.05 );
				}
			}
            sleep(0.05);
        }
	},
};

global OnMapLoad = function()
{
	thread ( Map.Tramcar_Position );
	
	if ( Map.Debug )
	{
		thread ( Map.Cablecar_Position_Debug );
	}
	
	OnTrigger( "Planted at the Castle Basement Door.", Map.Castle_Basement_Door_Planted );
