	Lower_Access_Door_Planted = function( trigger )
	{
		Util.MapDebugPrint( "Lower_Access_Door_Planted" );
		
		if ( Map.Supply_Room_Door )
		{
			foreach( goal in Util.GoalTable("DEFUSE_lower_access_door.*") )
			{
				goal.SetRoles(ROLE.DEFENDER);
				goal.SetGoalPriority( TEAM.AXIS, 0, 0.87 );
