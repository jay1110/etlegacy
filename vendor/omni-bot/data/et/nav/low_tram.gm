	OutpostCP_Trigger =
	{
		Name = "OutpostCP_Trigger",
		TriggerOnClass = CLASS.ANYPLAYER,
		OnEnter = function(ent)
		{
			if ( Map.Supply_Room_Door )
			{
				if ( GetEntTeam(ent) == TEAM.ALLIES )
				{
					if (Map.Ally_CP_trigger[ent])
					{
						Map.Ally_CP_trigger[ent] += 1;
					}
					else
					{
						Map.Ally_CP_trigger[ent] = 1;
					}
					
					GetGoal("DEFEND_Axis_OutpostCP_30").AimVectors = { Vec3(0.247, 0.837, -0.489), Vec3(0.294, -0.922, -0.250) };
				}
				else
				{
					if (Map.Axis_CP_trigger[ent])
					{
						Map.Axis_CP_trigger[ent] += 1;
					}
					else
					{
						Map.Axis_CP_trigger[ent] = 1;
					}
					
					GetGoal("ATTACK_Allies_OutpostCP_04").AimVectors = { Vec3(0.446, 0.882, -0.150), Vec3(0.331, -0.930, -0.158) };
				}
				
				bot = Util.IsBot(ent);
				if(bot){ bot.SetRoles(ROLE.ROAMER); }
				
				if ( Map.EntOwner == "Owner_Axis" and GetEntTeam(ent) == TEAM.ALLIES )
				{
					Util.MapDebugPrint( "Disable MOUNTMG42_Outpost_CP_Hut for Axis" );
					
					SetAvailableMapGoals( TEAM.AXIS, true, "CAMP_CP_Trigger_00");
					sleep(2.1);
					SetAvailableMapGoals( TEAM.AXIS, false, ".*MG42_Outpost_CP_Hut");
					sleep(5);
					
					if ( Map.EntOwner == "Free" and Map.Supply_Room_Door )
					{
						SetAvailableMapGoals( 0, false, "CAMP_CP_Trigger_00");
						
						SetAvailableMapGoals( 0, true, ".*MG42_Outpost_CP_Hut");
					}
				}
				else if ( Map.EntOwner == "Owner_Allies" and GetEntTeam(ent) == TEAM.AXIS )
				{
					Util.MapDebugPrint( "Disable MOUNTMG42_Outpost_CP_Hut for Allies" );
					
					SetAvailableMapGoals( TEAM.ALLIES, true, "CAMP_CP_Trigger_00");
					sleep(2.1);
					SetAvailableMapGoals( TEAM.ALLIES, false, ".*MG42_Outpost_CP_Hut");
					sleep(5);
					
					if ( Map.EntOwner == "Free" and Map.Supply_Room_Door )
					{
						SetAvailableMapGoals( 0, false, "CAMP_CP_Trigger_00");
						
						SetAvailableMapGoals( 0, true, ".*MG42_Outpost_CP_Hut");
					}
				}
			}
		},
		OnExit = function(ent)
		{
			bot = Util.IsBot(ent);
			if(bot){ bot.ClearRoles(ROLE.ROAMER); }
			if (Map.Ally_CP_trigger[ent])
			{
				if (Map.Ally_CP_trigger[ent] > 1)
				{
					Map.Ally_CP_trigger[ent] -= 1;
				}
				else
				{
					Map.Ally_CP_trigger[ent] = null;
				}
				
				if ( Map.Supply_Room_Door )
				{
					if ( tableCount(Map.Ally_CP_trigger) < 1 )
					{
						GetGoal("DEFEND_Axis_OutpostCP_30").AimVectors = { Vec3(0.247, 0.837, -0.489) };
						
						SetAvailableMapGoals( TEAM.AXIS, false, "CAMP_CP_Trigger_00");
						
						SetAvailableMapGoals( TEAM.AXIS, true, ".*MG42_Outpost_CP_Hut");
					}
				}
			}
			else
			{
				if (Map.Axis_CP_trigger[ent] > 1)
				{
					Map.Axis_CP_trigger[ent] -= 1;
				}
				else
				{
					Map.Axis_CP_trigger[ent] = null;
				}
				
				if ( Map.Supply_Room_Door )
				{
					if ( tableCount(Map.Axis_CP_trigger) < 1 )
					{
						GetGoal("ATTACK_Allies_OutpostCP_04").AimVectors = { Vec3(0.446, 0.882, -0.150) };
						
						SetAvailableMapGoals( TEAM.ALLIES, false, "CAMP_CP_Trigger_00");
						
						SetAvailableMapGoals( TEAM.ALLIES, true, ".*MG42_Outpost_CP_Hut");
					}
				}
			}
		},
	},
	
	MG_Owner = function()
	{
		mg_ent = GetGoal("MOUNTMG42_Outpost_CP_Hut").GetEntity();
		
		while ( Map.Supply_Room_Door )
		{
			if ( GetEntFlags(mg_ent, ENTFLAG.MOUNTED) )
			{
				owner = GetEntOwner(mg_ent);
				
				if ( owner )
				{
					if ( GetEntTeam(owner) == TEAM.AXIS )
					{
						if ( Map.EntOwner != "Owner_Axis" )
						{
							Util.MapDebugPrint( "MOUNTMG42_Outpost_CP_Hut mounted by Axis" );
							
							Map.EntOwner = "Owner_Axis";
						}
					}
					else if ( GetEntTeam(owner) == TEAM.ALLIES )
					{
						if ( Map.EntOwner != "Owner_Allies" )
						{
							Util.MapDebugPrint( "MOUNTMG42_Outpost_CP_Hut mounted by Allies" );
							
							Map.EntOwner = "Owner_Allies";
						}
					}
				}
				else
				{
					if ( Map.EntOwner != "Free" )
					{
						Util.MapDebugPrint( "MOUNTMG42_Outpost_CP_Hut => clear entity owner" );
						
						Map.EntOwner = "Free";
					}
				}
			}
			else
			{
				if ( Map.EntOwner != "Free" )
				{
					Util.MapDebugPrint( "MOUNTMG42_Outpost_CP_Hut => clear entity owner" );
					
					Map.EntOwner = "Free";
				}
			}
			sleep(0.1);
		}
	},
	
	Castle_Trigger =
	{
		Name = "Castle_Trigger",
		TriggerOnClass = CLASS.ANYPLAYER,
		OnEnter = function(ent)
		{
			if ( GetEntTeam(ent) == TEAM.ALLIES )
			{
				if (Map.Ally_in_trigger[ent])
				{
					Map.Ally_in_trigger[ent] += 1;
				}
				else
				{
					Map.Ally_in_trigger[ent] = 1;
					Util.MapDebugPrint("Ally in trigger: " + tableCount(Map.Ally_in_trigger));
				}
				
				if ( !Map.Supply_Room_Door )
				{
					SetAvailableMapGoals( TEAM.AXIS, false, {
						".*_Axis_Castle_.*",
						".*_Axis_CastleStation_.*",
					});
					
					if ( tableCount(Map.Ally_in_trigger) < 10 )
					{
						SetAvailableMapGoals( TEAM.AXIS, true, {
							"DEFEND_Axis_CastleIns_" + tableCount(Map.Ally_in_trigger),
							"DEFEND_Axis_CastleIns_" + (tableCount(Map.Ally_in_trigger)+1),
						});
					}
					
					sleep(0.5);
					
					SetAvailableMapGoals( TEAM.AXIS, true, {
						".*_Axis_Castle_.*",
						".*_Axis_CastleStation_.*",
					});
				}
			}
		},
		OnExit = function(ent)
		{
			if (Map.Ally_in_trigger[ent])
			{
				SetAvailableMapGoals( TEAM.AXIS, false, {
					"DEFEND_Axis_CastleIns_" + (tableCount(Map.Ally_in_trigger)+1),
				});
				
				if (Map.Ally_in_trigger[ent] > 1)
				{
					Map.Ally_in_trigger[ent] -= 1;
					Util.MapDebugPrint("Ally in trigger: " + tableCount(Map.Ally_in_trigger));
				}
				else
				{
					Map.Ally_in_trigger[ent] = null;
					
					Util.MapDebugPrint("Ally in trigger: " + tableCount(Map.Ally_in_trigger));
				}
				
				if ( tableCount(Map.Ally_in_trigger) < 1 )
				{
					SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_Axis_CastleIns_.*" );
				}
			}
		},
	},
	
	Castle_Trigger_Taken =
	{
		Name = "Castle_Trigger_Taken",
		TriggerOnClass = CLASS.ANYPLAYER,
		OnEnter = function(ent)
		{
			if ( GetEntFlags(ent,ENTFLAG.CARRYINGGOAL) )
			{
				if (Map.CarryingAlly_in_trigger[ent])
				{
					Map.CarryingAlly_in_trigger[ent] += 1;
				}
				else
				{
					Map.CarryingAlly_in_trigger[ent] = 1;
					Util.MapDebugPrint("CarryingAlly in trigger: " + tableCount(Map.CarryingAlly_in_trigger));
				}
				
				SetAvailableMapGoals( TEAM.AXIS, false, {
					".*_Axis_Castle_.*",
					".*_Axis_CastleStation_.*",
					".*_Axis_CastleIns_.*",
					"MOUNTMG42_Tram_Tower_Outpost_Top",
				});
				
				SetAvailableMapGoals( TEAM.AXIS, true, ".*_Axis_CappointPlace_.*" );
				
				SetAvailableMapGoals( TEAM.ALLIES, false, {
					".*MG42_Tram_Tower_Castle",
					".*_Allies_CastleOut_.*",
					".*_Allies_CastleStation_.*",
				});
				
				SetAvailableMapGoals( TEAM.ALLIES, true, {
					".*_Allies_CastleIns_.*",
					".*_Allies_CappointPlace_.*",
				});
				
				sleep(0.5);
				
				if ( !Map.Supply_Room_Door )
				{
					SetAvailableMapGoals( TEAM.AXIS, true, {
						".*_Axis_Castle_.*",
						".*_Axis_CastleStation_.*",
						".*_Axis_CastleIns_.*",
					});
				}
			}
		},
		OnExit = function(ent)
		{
			if (Map.CarryingAlly_in_trigger[ent] > 1)
			{
				Map.CarryingAlly_in_trigger[ent] -= 1;
				Util.MapDebugPrint("CarryingAlly in trigger: " + tableCount(Map.CarryingAlly_in_trigger));
			}
			else
			{
				Map.CarryingAlly_in_trigger[ent] = null;
				
				Util.MapDebugPrint("CarryingAlly in trigger: " + tableCount(Map.CarryingAlly_in_trigger));
			}
			
			if ( tableCount(Map.CarryingAlly_in_trigger) < 1 )
			{
				if ( Map.Radio_Codes_Booklet == "Taken" )
				{
					SetAvailableMapGoals( TEAM.AXIS, false, ".*_Axis_CappointPlace_.*" );
				}
				
				SetAvailableMapGoals( TEAM.ALLIES, true, {
					".*MG42_Tram_Tower_Castle",
					".*_Allies_CastleOut_.*",
					".*_Allies_CastleStation_.*",
				});
				
				SetAvailableMapGoals( TEAM.ALLIES, false, {
					".*_Allies_CastleIns_.*",
					".*_Allies_CappointPlace_.*",
				});
			}
		},
	},
	
	Carrying_player = function()
	{
		while ( Map.Radio_Codes_Booklet == "Taken" )
		{
			for ( c = 0; c <= 999; c += 1 )
			{
				if ( GetEntFlags(c,ENTFLAG.CARRYINGGOAL) and !Util.IsBot(c) )
				{
					for ( b = 1; b < 5; b += 1 )
					{
						ent = GetGoal("MOVER_tramcar_" + b).GetEntity();
						while ( DistanceBetween(GetEntPosition(c), GetEntPosition(ent)) < 300 )
						{
							if ( Map.Player_Carrying_Goal_Near_Tram == 0 )
							{
								Map.Player_Carrying_Goal_Near_Tram = 1;
								Util.MapDebugPrint( "Player_Is_Near_Tram" );
							}
							yield();
						}
						
						if ( Map.Player_Carrying_Goal_Near_Tram == 1 )
						{
							Map.Player_Carrying_Goal_Near_Tram = 0;
							Util.MapDebugPrint( "Player_Isn't_Near_Tram" );
						}
					}
				}
			}
			yield();
		}
	},
	
	MG42_Trigger =
	{
		Name = "MG42_Trigger",
		TriggerOnClass = CLASS.ANYPLAYER,
		OnEnter = function(ent)
		{
			a = Util.IsBot(ent);
			if (a)
			{
				a.OldReactionTime = a.ReactionTime;
				a.ReactionTime = 0.5;
			}
		},
		OnExit = function(ent)
		{
			a = Util.IsBot(ent);
			if (a)
			{
				a.ReactionTime = a.OldReactionTime;
			}
		},
	},

	SetSpawn1 = function(bot)
	{
		if ( bot.GetTeam() == TEAM.ALLIES )
        {
			if ( Map.Supply_Room_Door )
			{
				if ( Map.Village_Tram_Tower == TEAM.ALLIES )
				{
					if ( RandInt(0, 1) == 1 )
					{
						bot.ChangeSpawnPoint(3);
					}
					else
					{
						bot.ChangeSpawnPoint(1);
					}
				}
				else
				{
					bot.ChangeSpawnPoint(1);
				}
			}
			else
            {
				bot.ChangeSpawnPoint(4);
			}
		}
	},
	
	SetSpawn = function()
	{
		foreach ( id and bot in BotTable )
		{
			Map.SetSpawn1(bot);
		}
	},
	
	Tramcar_Position = function()
	{
		while ( 1 )
		{
			for ( h = 1; h <= 4; h += 1 )
			{
				pos = Util.GetMapGoalPosition("MOVER_tramcar_" + h ).x;
				//Util.MapDebugPrint( "Tramcar" + " " + h + " " + pos );
				
				switch ( h )
				{
					case 1:
					{
						if ( pos < 132 )
						{
							if ( Map.Tramcar_1 != "Bottom" )
							{
								Map.Tramcar_1 = "Bottom";
								
								if ( Map.Tramcar_Position_Debug )
								{
									Util.MapDebugPrint( "Tramcar_1_Bottom" );
								}
							}
						}
						else if ( pos > 1990 and pos < 2063 )
						{
							if ( Map.Tramcar_1 != "Middle" )
							{
								Map.Tramcar_1 = "Middle";
								
								if ( Map.Tramcar_Position_Debug )
								{
									Util.MapDebugPrint( "Tramcar_1_Middle" );
								}
							}
						}
						else if ( pos > 2800 and pos < 3320 )
						{
							if ( Map.Tramcar_1 != "Hill" )
							{
								Map.Tramcar_1 = "Hill";
								
								if ( Map.Tramcar_Position_Debug )
								{
									Util.MapDebugPrint( "Tramcar_1_Hill" );
								}
							}
						}
						else if ( pos > 4174 )
						{
							if ( Map.Tramcar_1 != "Top" )
							{
								Map.Tramcar_1 = "Top";
								
								if ( Map.Tramcar_Position_Debug )
								{
									Util.MapDebugPrint( "Tramcar_1_Top" );
								}
							}
						}
						else
						{
							if ( Map.Tramcar_1 != "Moving" )
							{
								Map.Tramcar_1 = "Moving";
								
								if ( Map.Tramcar_Position_Debug )
