		{
			foreach( goal in Util.GoalTable("DEFUSE_hatch.*") )
			{
				goal.SetRoles(ROLE.DEFENDER2, ROLE.DEFENDER3);
				goal.SetGoalPriority( TEAM.AXIS, 0, 0.88 );
				goal.MaxUsers_InProgress( 1 );
			}
