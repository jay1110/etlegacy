	Supply_Room_Door_Defused = function( trigger )
	{
		Util.MapDebugPrint( "Supply_Room_Door_Defused" );
		
		if ( tableCount(Util.GoalTable("DEFUSE_supply_room_door.*")) == 1 and Map.Supply_Room_Door )
		{
			SetAvailableMapGoals( TEAM.AXIS, false, ".*_Axis_CastleCP_.*" );
			
			if ( Map.Lower_Access_Door )
			{
				SetAvailableMapGoals( TEAM.AXIS, true, ".*_Axis_LowerAccess_.*" );
			}
			else
			{
				SetAvailableMapGoals( TEAM.AXIS, true, {
					".*_Axis_LowerAccess_.*",
					".*_Axis_LowAccessDest_.*",
				});
				
				yield();
				
				SetAvailableMapGoals( TEAM.AXIS, false, {
					"PLANTMINE_Axis_LowerAccess_.*",
					"MOBILEMG42_Axis_LowerAccess_.*",
				});
			}
		}
	},
	
	Supply_Room_Door_Destroyed = function( trigger )
	{
		Map.Supply_Room_Door = false;
		Util.MapDebugPrint( "Supply_Room_Door_Destroyed" );
		
		ClearGoalRole( ".*_Outpost_Command_Post", { ROLE.DEFENDER, ROLE.DEFENDER1 });
		
		SetAvailableMapGoals( 0, true, ".*CAB.*" );
		
		Util.SetMaxUsers( 2, "BUILD_Castle_Command_Post" );
		
		if ( Map.Allied_Outpost_CP )
		{
			SetGoalRole( "PLANT_Outpost_Command_Post", ROLE.INFILTRATOR );
			Util.SetMaxUsers( 1, "PLANT_Outpost_Command_Post" );
		}
		
		foreach( goal in Util.GoalTable("DEFUSE_supply_room_door.*") )
		{
			goal.SetAvailable(TEAM.AXIS, false);
		}
		
		Util.DisableGoal("CAMP_CP_Trigger_00");
		
		if ( Map.Lower_Access_Door )
		{
			Util.DisableGoal("CHECKPOINT_forward_flag");
		}
		
		SetAvailableMapGoals( TEAM.AXIS, false, {
			".*_Axis_Low.*",
			".*_Axis_OutpostCP_.*",
			".*_Axis_OutpostStation_.*",
			".*MG42_Outpost_CP_Hut",
			"BUILD_Outpost_Command_Post",
		});
		
		if ( Map.Outpost_Bridge )
		{
			SetAvailableMapGoals( TEAM.AXIS, false, "PLANT_outpost_bridge" );
		}
		
		SetAvailableMapGoals( TEAM.AXIS, true, {
			"MOUNTMG42_Tram_Tower_Outpost_Top",
			".*MG42_Castle_CP_Hut",
			".*_Axis_CastleCP_.*",
			".*_Axis_CastleStation_.*",
		});
		
		if ( !Map.Allied_Castle_CP and !Map.Axis_Castle_CP )
		{
			SetAvailableMapGoals( 0, true, "BUILD_Castle_Command_Post" );
		}
		else if ( Map.Allied_Castle_CP )
		{
			SetAvailableMapGoals( TEAM.AXIS, true, "PLANT_Castle_Command_Post" );
		}
		else
		{
			SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_Castle_Command_Post" );
		}
		
		if ( Map.Castle_Bridge )
		{
			SetAvailableMapGoals( TEAM.AXIS, true, "PLANT_castle_bridge" );
		}
		else
		{
			SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_castle_bridge" );
		}
		
		if ( tableCount(Map.CarryingAlly_in_trigger) < 1 )
		{
			SetAvailableMapGoals( TEAM.AXIS, true, ".*_Axis_Castle_.*" );
		}
		
		Map.SetSpawn();
		
		sleep(2);
		
		if ( !Map.Outpost_Bridge )
		{
			SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_outpost_bridge" );
		}
		
		SetAvailableMapGoals( TEAM.ALLIES, false, {
			".*_Allies_Low.*",
			".*_Allies_OutpostBridge_.*",
			".*_Allies_OutpostCP_.*",
			".*MG42_Outpost_CP_Hut",
			".*MG42_Tram_Tower_Outpost_Bottom",
			".*_Allies_OutpostStation_.*",
		});
		
		if ( Map.Lower_Access_Door )
		{
			SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_lower_access_door" );
		}
		
		if ( !Map.Outpost_Bridge )
		{
			SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_outpost_bridge" );
		}
		
		if ( Map.Radio_Codes_Booklet != "Taken" )
		{
			SetAvailableMapGoals( TEAM.AXIS, true, ".*_Axis_SupplyRoom_.*" );
			
			SetAvailableMapGoals( TEAM.ALLIES, true, "FLAG_radio_codes" );
		}
		
		SetAvailableMapGoals( TEAM.ALLIES, true, {
			".*MG42_Tram_Tower_Castle",
			".*_Allies_CastleCP_.*",
			".*MG42_Castle_CP_Hut",
			".*_Allies_CastleStation_.*",
		});
		
		if ( Map.Castle_Basement_Door )
		{
			SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_Castle_Basement_Door" );
		}
	},
	
	Radio_Codes_Booklet_Taken = function( trigger )
	{
		Map.Radio_Codes_Booklet = "Taken";
		Util.MapDebugPrint( "Radio_Codes_Booklet_Taken" );
		thread ( Map.Carrying_player );
		
		OnTriggerRegion(AABB(3500,-2374,1364,7585,2034,2752), Map.Castle_Trigger_Taken);
		
		SetAvailableMapGoals( TEAM.ALLIES, true, "CAPPOINT_Transmitter" );
		
		if ( tableCount(Map.CarryingAlly_in_trigger) < 1 )
		{
			SetAvailableMapGoals( TEAM.ALLIES, true, ".*_Allies_CastleOut_.*" );
		}
		
		for ( i = 0; i <= 999; i += 1 )
		{
			if ( GetEntFlags(i,ENTFLAG.CARRYINGGOAL) )
			{
				break;
			}
		}
		
		thread(Map.Escort_carrying, i);
		
		sleep(2);
		
		if ( Map.Radio_Codes_Booklet == "Taken" )
		{
			SetAvailableMapGoals( TEAM.AXIS, false, ".*_Axis_SupplyRoom_.*" );
		}
	},
	
	Escort_carrying = function (i)
	{
		while ( Map.Radio_Codes_Booklet == "Taken" )
		{
			if ( Map.Bot_Carrying_Goal_Near_Tram or Map.Player_Carrying_Goal_Near_Tram == 1 )
			{
				SetAvailableMapGoals( TEAM.ALLIES, false, "CAMP_Allies_Escort_.*" );
			}
			else if (GetEntPosition(i).x >= -10000 and GetEntPosition(i).y >= -2000 and GetEntPosition(i).z >= -100 and
			GetEntPosition(i).x <= 1780 and GetEntPosition(i).y <= 1985 and GetEntPosition(i).z <= 1600)
			{
				foreach ( goal in Util.GoalTable("CAMP_Allies_Escort_.*") )
				{
					goal.SetRange(3500);
				}
				
				Util.SetGoalPosition(2079.723, 1843.358, 1171.132, "CAMP_Allies_Escort_1");
				GetGoal("CAMP_Allies_Escort_1").AimVectors = { Vec3(0.938, -0.324, 0.125), Vec3(0.236, -0.963, 0.132) };
				Util.SetGoalPosition(2052.572, 1963.526, 1237.225, "CAMP_Allies_Escort_2");
				GetGoal("CAMP_Allies_Escort_2").AimVectors = { Vec3(0.269, -0.950, 0.162), Vec3(0.862, -0.482, 0.155) };
				Util.SetGoalPosition(1910.374, 1779.756, 1121.875, "CAMP_Allies_Escort_3");
				GetGoal("CAMP_Allies_Escort_2").AimVectors = { Vec3(0.947, -0.124, 0.296), Vec3(0.255, -0.953, 0.162) };
				Util.SetGoalPosition(1760.168, 1626.821, 1088.695, "CAMP_Allies_Escort_4");
				GetGoal("CAMP_Allies_Escort_2").AimVectors = { Vec3(0.380, -0.893, 0.242), Vec3(0.983, -0.032, 0.181) };
				
				SetAvailableMapGoals( TEAM.ALLIES, true, "CAMP_Allies_Escort_.*" );
			}
			else if ((GetEntPosition(i).x >= 1810 and GetEntPosition(i).y >= -2000 and GetEntPosition(i).z >= 1050 and
			GetEntPosition(i).x <= 3150 and GetEntPosition(i).y <= 1000 and GetEntPosition(i).z <= 2500) or
			(GetEntPosition(i).x >= 1810 and GetEntPosition(i).y >= 1001 and GetEntPosition(i).z >= 1050 and
			GetEntPosition(i).x <= 2024 and GetEntPosition(i).y <= 1440 and GetEntPosition(i).z <= 1200))
			{
