				}
				
				Util.SetGoalPosition(4781.101, 122.715, 2033.125, "CAMP_Allies_Escort_1");
				GetGoal("CAMP_Allies_Escort_1").AimVectors = { Vec3(0.451, -0.893, 0.007), Vec3(0.969, 0.244, 0.046) };
				Util.SetGoalPosition(4754.125, -100.318, 2033.125, "CAMP_Allies_Escort_2");
				GetGoal("CAMP_Allies_Escort_2").AimVectors = { Vec3(0.475, 0.878, 0.060), Vec3(0.759, -0.651, -0.001) };
				Util.SetGoalPosition(4788.125, -267.084, 2033.125, "CAMP_Allies_Escort_3");
				GetGoal("CAMP_Allies_Escort_2").AimVectors = { Vec3(0.315, 0.948, 0.037), Vec3(0.961, -0.276, -0.019) };
				Util.SetGoalPosition(5086.658, 304.133, 2033.125, "CAMP_Allies_Escort_4");
				GetGoal("CAMP_Allies_Escort_2").AimVectors = { Vec3(-0.357, -0.934, 0.020), Vec3(-0.324, 0.906, 0.273) };
				
				SetAvailableMapGoals( TEAM.ALLIES, true, "CAMP_Allies_Escort_.*" );
				
				foreach ( bot in BotTable )
				{
					goal = bot.GetMapGoalName();
					if ( goal == "CAMP_Allies_Escort_1" or goal == "CAMP_Allies_Escort_2" or goal == "CAMP_Allies_Escort_3" or goal == "CAMP_Allies_Escort_4" )
					{
						bot.DisableCombatMovement = false;
						bot.HoldButton(BTN.SPRINT, 0.2);
					}
				}
			}
			else
			{
				foreach ( goal in Util.GoalTable("CAMP_Allies_Escort_.*") )
				{
					goal.SetRange(1000);
				}
				
				SetAvailableMapGoals( TEAM.ALLIES, true, "CAMP_Allies_Escort_.*" );
				
				foreach ( goal in Util.GoalTable("CAMP_Allies_Escort_.*") )
				{
					goal.SetPosition(GetEntPosition(i) - Vec3(-20, 0, 23));
				}
			}
			
			sleep(0.1);
		}
	},
	
	Radio_Codes_Booklet_Dropped = function( trigger )
	{
		Map.Radio_Codes_Booklet = "Dropped";
		Util.MapDebugPrint( "Radio_Codes_Booklet_Dropped" );
		
		SetAvailableMapGoals( TEAM.ALLIES, false, {
			"CAPPOINT_Transmitter",
			"CAMP_Allies_Escort_.*",
		});
		
		Util.SetGoalRange( ".*_radio_codes_dropped", 1600);
		Util.SetMaxUsers( 3, "FLAGRETURN_radio_codes_dropped" );
		
		if ( tableCount(Map.CarryingAlly_in_trigger) < 1 )
		{
			DeleteTriggerRegion("Castle_Trigger_Taken");	//don't move it, because of testing of variable CarryingAlly_in_trigger
			
			SetAvailableMapGoals( TEAM.AXIS, false, ".*_Axis_CappointPlace_.*" );
			Util.MapDebugPrint( "Empty trigger" );
		}
		else
		{
			DeleteTriggerRegion("Castle_Trigger_Taken");	//don't move it, because of testing of variable CarryingAlly_in_trigger
			
			Util.MapDebugPrint( "Entity in trigger" );
			
			while ( Map.Radio_Codes_Booklet == "Dropped" )
			{
				sleep(0.1);
			}
			
			if ( tableCount(Map.CarryingAlly_in_trigger) < 1 )
			{
				SetAvailableMapGoals( TEAM.AXIS, false, ".*_Axis_CappointPlace_.*" );
			}
		}
	},

