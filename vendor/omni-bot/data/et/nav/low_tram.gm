		SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_Outpost_Command_Post" );
	},
	
	Outpost_CP_Planted = function( trigger )
	{
		if ( Map.Allied_Outpost_CP )
		{
			Util.MapDebugPrint( "Allied_Outpost_CP_Planted" );
			
			foreach( goal in Util.GoalTable("DEFUSE_Outpost_Command_Post.*") )
