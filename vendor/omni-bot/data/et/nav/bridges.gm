global OnMapLoad = function()
{
	// Register callback functions

	// Start Spawns
	//Axis Spawn   = 2 //not first spawn, train start end spawn    
	//Axis Spawn   = 4 //flag 2 Axis first spawn
	//Allies Spawn = 3 //flag 1 Allied first spawn
    //Allies Spawn = 1 //first Allied spawn - last spawn - Axis first objective truck - Axis final objective Train to final end
    
    // spawn# 1 is Allied only spawn = Truck start location. Train End Location
    // spawn# 2 is AXIS only spawn = Truck end this location & fix Train start Location.
    // spawn# 3 is a flag & is goal for BOTH team & BOTH teams can spawn there.   
    // spawn# 4 is a flag & is goal for BOTH team & BOTH teams can spawn there 
       
	OnTrigger( "bridges_allies_barrier_construct", Map.Map_Started );
    
    OnTrigger( "CHECKPOINT_forwardspawn to team 1", Map.spawn1axis );
    OnTrigger( "CHECKPOINT_forwardspawn to team 2", Map.spawn1allies );
    
    OnTrigger( "CHECKPOINT_forwardspawn2 to team 1", Map.spawn2axis );
    OnTrigger( "CHECKPOINT_forwardspawn2 to team 2", Map.spawn2allies );    

	OnTrigger( "Allied Command Post constructed. Charge speed increased!", Map.Command_Post_Built );
	OnTrigger( "Axis Command Post constructed. Charge speed increased!", Map.Command_Post_Built );
