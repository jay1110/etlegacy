	Map_Started = function( trigger )
	{
		// Stops Certain triggers running at start of map
		Map.MapStart = false;
	},

	Command_Post_Built = function( trigger )
	{
		Util.MapDebugPrint( "Command_Post_Built" );
	},

	Command_Post_Destroyed = function( trigger )
	{
		Util.MapDebugPrint( "Command_Post_Destroyed" );
	},

	Truck_Built = function( trigger )
	{
		Map.TruckBuilt = 1;
		if ( Map.EscortTruck == 0 )
			{ return; }

		else
		{
            SetAvailableMapGoals( TEAM.ALLIES, true, "ESCORT_Defend_Truck" );// enable this for allies to attack truck sooner
			SetAvailableMapGoals( TEAM.AXIS, true, "ESCORT_Truck" );
			SetAvailableMapGoals( TEAM.AXIS, true, "ESCORT_Attack_Truck" );
		}

		Util.MapDebugPrint( "truck_Built" );
	},

	Truck_Destroyed = function( trigger )
	{
		Map.TruckBuilt = 0;

		if ( Map.MapStart == true )
			{ return; }

		if ( Map.BuildTruck == 0 )
			{ return; }

		SetAvailableMapGoals( TEAM.AXIS, false, "ESCORT_Truck" );

		if ( Map.TruckPastBarrier == 1 )
		{
			SetAvailableMapGoals( TEAM.AXIS, true, "ESCORT_Attack_Truck" );
            SetAvailableMapGoals( TEAM.ALLIES, true, "ESCORT_Defend_Truck" );
		}
		Util.MapDebugPrint( "^6truck_Destroyed" );
	},

	Truck_Killed = function( trigger )
	{
        		Map.TruckBuilt = 0;

		if ( Map.MapStart == true )
			{ return; }
		Util.MapDebugPrint( "^6truck_killed_1" );
		if ( Map.BuildTruck == 0 )
			{ return; }
		Util.MapDebugPrint( "^6truck_killed_2" );
		SetAvailableMapGoals( TEAM.AXIS, false, "ESCORT_Truck" );

		if ( Map.TruckPastBarrier == 1 )
		{
			SetAvailableMapGoals( TEAM.AXIS, true, "ESCORT_Attack_Truck" );
            SetAvailableMapGoals( TEAM.ALLIES, true, "ESCORT_Defend_Truck" );
            		Util.MapDebugPrint( "^6truck_killed_3" );
		}

		Util.MapDebugPrint( "^6truck_killed_0" );
	},

	Truck_Stolen = function( trigger )
	{
		SetAvailableMapGoals( TEAM.AXIS, false, "ATTACK_Truck_Start.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "ATTACK_Truck_Barrier.*" );
                Map.TruckNotStolen = false;
				Map.Truck_Stolen = true;

		SetAvailableMapGoals( TEAM.ALLIES, false, {
			"DEFEND_Truck_Start.*",
			"MOUNTMG42_BoatHousePath",
			"REPAIRMG42_BoatHousePath",
		});
		SetAvailableMapGoals( TEAM.ALLIES, false, "DEFEND_Truck_Barrier.*" );
        SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_Truck_Barrier.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "ESCORT_Attack_Truck" );
        SetAvailableMapGoals( TEAM.ALLIES, true, "ESCORT_Defend_Truck" );// enable this for allies to attack truck sooner
		Util.MapDebugPrint( "^6Truck_Stolen" );
	},

