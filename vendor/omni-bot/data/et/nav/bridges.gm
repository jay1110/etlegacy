//ClearGoalRole( "ESCORT_Truck", ROLE.ATTACKER );
//ClearGoalRole( "BUILD_truck", ROLE.ATTACKER );
//ClearGoalRole( "ESCORT_Attack_Truck", ROLE.ATTACKER );      
    SetGoalPriority( "ARTILLERY_S_.*", 1.89, TEAM.AXIS, CLASS.FIELDOPS );//axis goal        
        SetGoalPriority( "RIDE_Train", .89, TEAM.AXIS );//axis goal
    SetGoalPriority( "MOBILEMG42_start", .99, TEAM.AXIS ); //axis goal
    SetGoalPriority( "BUILD_truck", .99, TEAM.AXIS, CLASS.ENGINEER  );//axis goal   
	SetGoalPriority( "ESCORT_Attack_Truck", .89, TEAM.AXIS );//axis goal79
	SetGoalPriority( "BUILD_Command_Post", 0.85, TEAM.AXIS, CLASS.ENGINEER );
	SetGoalPriority( "BUILD_Command_Post", 0.85, TEAM.ALLIES, CLASS.ENGINEER );    
    SetGoalPriority( "ESCORT_Truck", .89, TEAM.AXIS );//axis goal
    SetGoalPriority( "ESCORT_Defend_Truck", .81, TEAM.ALLIES );//allies goal5-79-81
    SetGoalPriority( "ATTACK_Truck_Start.*", 0.78, TEAM.AXIS );//axis goal
    SetGoalPriority( "DEFEND_Truck_Start.*", 0.85, TEAM.ALLIES );//allies goal5-79-85
    SetGoalPriority( "CALLARTILLERY_.*", 1.98, TEAM.AXIS, CLASS.FIELDOPS );
    SetGoalPriority( "AIRSTRIKE_start_1", .99, TEAM.AXIS, CLASS.FIELDOPS );
    SetGoalPriority( "AIRSTRIKE_get_truck_start", .99, TEAM.AXIS, CLASS.FIELDOPS );    
    SetGoalPriority( "AIRSTRIKE_get_truck_start_again", .99, TEAM.AXIS, CLASS.FIELDOPS );    
    //SetGoalPriority( "ARTILLERY_S_.*", 0.98, TEAM.AXIS );
    //SetGoalPriority( "*._lastchancetruck_.*", 0.95, TEAM.ALLIES );
//SetAvailableMapGoals( TEAM.ALLIES, true, "*._lastchancetruck_.*" );     
    SetGoalPriority( "ATTACK_.*", 0.78, TEAM.AXIS );//axis goal
  //SetGoalPriority( "DEFEND_.*", .79, TEAM.ALLIES );//allies goal
  SetGoalPriority( "DEFEND_Truck_Barrier_.*", .5, TEAM.ALLIES );//5-78-79
	Util.LimitToClass( "PLANT_Command_Post", 1, 5 );//in theory it makes the goal for COVERTOPS only. if other class bots are going to the goal this can be used to stop that. 
	Util.LimitToClass( "PLANT_Command_Post", 2, 5 );//in theory it makes the goal for COVERTOPS only. if other class bots are going to the goal this can be used to stop that. 
    Util.LimitToClass( "BUILD_Command_Post", 1, 3 );//in theory it makes the goal for ENGINEER only. if other class bots are going to the goal this can be used to stop that. 
	Util.LimitToClass( "BUILD_Command_Post", 2, 3 );//in theory it makes the goal for ENGINEER only. if other class bots are going to the goal this can be used to stop that.     
	// Max users per goal
	Util.SetMaxUsers( 4, "ESCORT_Truck" );
    Util.SetMaxUsers( 4, "ESCORT_Attack_Truck" );
    Util.SetMaxUsers( 4, "ESCORT_Defend_Truck" );    
    Util.SetMaxUsers( 4, "BUILD_truck" );
    Util.SetMaxUsers( 1, "DEFEND_.*" );
	Util.SetMaxUsers( 1, "MOUNTMG42_.*" );
    Util.SetMaxUsers( 1, "BUILD_Command_Post" );
    Util.SetMaxUsers( 1, "PLANT_Command_Post" );
    Util.SetMaxUsers( 2, "CHECKPOINT.*", TEAM.AXIS );
    Util.SetMaxUsers( 2, "CHECKPOINT.*", TEAM.ALLIES );
Util.ExcludeClass( "ATTACK_Axis_End_.*", TEAM.AXIS, CLASS.ENGINEER );

Util.DisableGoal( "ROUTE_repair_.*", true );

	// Camp times
	SetMapGoalProperties( "MOUNTMG42_.*", {MinCampTime=15, MaxCampTime=90} );
	SetMapGoalProperties( "MOBILEMG42_.*", {MinCampTime=10, MaxCampTime=60} );
    
    //Util.AddUseWp("BUILD_truck", "truck");// Antenna is the waypoint name    
    //Util.IgnoreTargetGoalAllBots("MOVER_truck");    
    //Util.DisableGoal( "ROUTE_Spawn_2", true );
    //Util.FixMoverPos("truck", Vec3(871.000, 49.500, 348.500), Vec3(872.000, -96.000, 288.000));
    
	Util.FixMoverPos("train", Vec3(9263.998, 2546.000, 936.000), Vec3(9264.000, 2546.000, 888.000));
