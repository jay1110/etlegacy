global Map =
{
	Debug = 0, // please set to zero before distributing your script
	

	truck_Built = function( trigger )
	{
		SetAvailableMapGoals( TEAM.AXIS, false, "BUILD_truck" );
		SetAvailableMapGoals( TEAM.AXIS, true, "ESCORT_Truck" );
		SetGoalPriority( "ESCORT_truck", 1.20, TEAM.AXIS );
		Util.MapDebugPrint( "truck_Built" );
	},
	
	truck_Damaged = function( trigger )
	{
		SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_truck" );
		SetGoalPriority( "BUILD_truck", 1.20, TEAM.AXIS, CLASS.ENGINEER );
		SetAvailableMapGoals( TEAM.AXIS, false, "ESCORT_Truck" );
		Util.MapDebugPrint( "truck_Damaged" );
	},
	
	Truck_Barrier_1_Built = function( trigger )
	{
		SetAvailableMapGoals( TEAM.AXIS, true, "PLANT_Truck_Barrier_1" );
		SetGoalPriority( "PLANT_Truck_Barrier_1", 1.30, TEAM.AXIS, CLASS.ENGINEER );
		SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Truck_Barrier_1" );
		Util.MapDebugPrint( "Truck_Barrier_1_Built" );
	},
	
	Truck_Barrier_1_Destroyed = function( trigger )
	{
		SetAvailableMapGoals( TEAM.AXIS, false, "PLANT_Truck_Barrier_1" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Truck_Barrier_1" );
		SetGoalPriority( "BUILD_Truck_Barrier_1", 1.10, TEAM.ALLIES, CLASS.ENGINEER );
		SetGoalPriority( "BUILD_truck", 1.2, TEAM.AXIS, CLASS.ENGINEER );
		Util.MapDebugPrint( "Truck_Barrier_1_Destroyed" );
	},
	
	Truck_Barrier_1_Passed = function( trigger )
	{
		SetAvailableMapGoals( TEAM.AXIS, false, "PLANT_Truck_Barrier_1" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Truck_Barrier_1" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Garage_Door" );
		SetGoalPriority( "BUILD_Garage_Door", 1.1, TEAM.ALLIES, CLASS.ENGINEER );
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_b1.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "ATTACK_b1.*" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_b2.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "ATTACK_b2.*" );
		Util.MapDebugPrint( "Truck_Barrier_1_Passed" );
	},
	
	Garage_Door_Built = function( trigger )
	{
		SetAvailableMapGoals( TEAM.AXIS, true, "PLANT_Garage_Door" );
		SetGoalPriority( "PLANT_Garage_Door", 1.20, TEAM.AXIS, CLASS.ENGINEER );
		Util.AddUsePoint("PLANT_Garage_Door",{Vec3(-3593.7,7725.6,184.125),Vec3(-3590.4,7725.6,184.125),Vec3(-3437.6,7569.1,184.125),Vec3(-3448.2,7569.1,184.125)});
		SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Garage_Door" );
		SetGoalPriority( "BUILD_truck", 0.6, TEAM.AXIS, CLASS.ENGINEER );
		Util.MapDebugPrint( "Garage_Door_Built" );
	},
	
	Garage_Door_Destroyed = function( trigger )
	{
		SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_Garage_Door" );
		SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_Garage_Door" );
		SetGoalPriority( "BUILD_Garage_Door", 1.10, TEAM.ALLIES, CLASS.ENGINEER );
		SetGoalPriority( "BUILD_truck", 1.20, TEAM.AXIS, CLASS.ENGINEER );
		Util.MapDebugPrint( "Garage_Door_Destroyed" );
	},
	
	Garage_Door_Passed = function( trigger )
	{
		SetAvailableMapGoals( TEAM.AXIS, false, "PLANT_Garage_Door" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Garage_Door" );
		SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_Command_Post" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Command_Post" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Truck_Barrier_2" );
		SetGoalPriority( "BUILD_Truck_Barrier_2", 1.1, 0, CLASS.ENGINEER );
		SetAvailableMapGoals( TEAM.AXIS, true, "PLANT_cave_rocks" );
		SetGoalPriority( "PLANT_cave_rocks", 1.20, TEAM.AXIS, CLASS.ENGINEER );
		Util.AddUsePoint("PLANT_cave_rocks",{Vec3(-10859.23,7400.395,232.125),Vec3(-10747.895,7404.411,232.125),Vec3(-10648,7422.498,232.125)});
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_b2.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "ATTACK_b2.*" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_b3.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "ATTACK_b3.*" );
		Util.MapDebugPrint( "Garage_Door_Passed" );
	},
	
	Truck_Barrier_2_Built = function( trigger )
	{
		SetAvailableMapGoals( TEAM.AXIS, true, "PLANT_Truck_Barrier_2" );
		SetGoalPriority( "PLANT_Truck_Barrier_2", 1.30, TEAM.AXIS, CLASS.ENGINEER );
		SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Truck_Barrier_2" );
		SetGoalPriority( "BUILD_truck", 0.6, TEAM.AXIS, CLASS.ENGINEER );
		Util.MapDebugPrint( "Truck_Barrier_2_Built" );
	},
	
	Truck_Barrier_2_Destroyed = function( trigger )
	{
		SetAvailableMapGoals( TEAM.AXIS, false, "PLANT_Truck_Barrier_2" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Truck_Barrier_2" );
		SetGoalPriority( "BUILD_Truck_Barrier_2", 1.10, TEAM.ALLIES, CLASS.ENGINEER );
		SetGoalPriority( "BUILD_truck", 1.2, TEAM.AXIS, CLASS.ENGINEER );
		Util.MapDebugPrint( "Truck_Barrier_2_Destroyed" );
	},
	
	Truck_Barrier_2_Passed = function( trigger )
	{
		SetAvailableMapGoals( TEAM.AXIS, false, "PLANT_Truck_Barrier_2" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Truck_Barrier_2" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_b3.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "ATTACK_b3.*" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_e1.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "ATTACK_e1.*" );
		Util.MapDebugPrint( "Truck_Barrier_2_Passed" );
	},
	
	cave_rocks_Destroyed = function( trigger )
	{
		SetAvailableMapGoals( TEAM.AXIS, false, "PLANT_cave_rocks" );
		Util.MapDebugPrint( "cave_rocks_Destroyed" );
	},	
	
	Allied_Command_Post_Built = function( trigger )
	{
		SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Command_Post" );
		SetAvailableMapGoals( TEAM.AXIS, false, "BUILD_Command_Post" );
		SetAvailableMapGoals( TEAM.AXIS, true, "PLANT_Command_Post" );
		SetGoalPriority( "PLANT_Command_Post", 1.10, TEAM.AXIS, CLASS.COVERTOPS );
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_e1.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "ATTACK_e1.*" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_e2.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "ATTACK_e2.*" );	
		Util.MapDebugPrint( "Allied_Command_Post_Built" );
	},
	
	Axis_Command_Post_Built = function( trigger )
	{
        SetAvailableMapGoals( TEAM.AXIS, false, "BUILD_Command_Post" );
        SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Command_Post" );
        SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_Command_Post" );
		SetGoalPriority( "PLANT_Command_Post", 1.10, TEAM.ALLIES, CLASS.COVERTOPS );
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_e2.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "ATTACK_e2.*" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_e1.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "ATTACK_e1.*" );			
        Util.MapDebugPrint( "Axis_Command_Post_Built" );
	},
	
	Axis_Command_Post_Destroyed = function( trigger )
	{
		SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_Command_Post" );
		SetGoalPriority( "BUILD_Command_Post", 1.20, TEAM.AXIS, CLASS.ENGINEER );
		SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Command_Post" );
		SetGoalPriority( "BUILD_Command_Post", 1.20, TEAM.ALLIES, CLASS.ENGINEER );
		SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_Command_Post" );
		Util.MapDebugPrint( "Axis_Command_Post_Destroyed" );
	},
	
	Allied_Command_Post_Destroyed = function( trigger )
	{
		SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Command_Post" );
		SetGoalPriority( "BUILD_Command_Post", 1.20, TEAM.ALLIES, CLASS.ENGINEER );
		SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_Command_Post" );
		SetGoalPriority( "BUILD_Command_Post", 1.20, TEAM.AXIS, CLASS.ENGINEER );
		SetAvailableMapGoals( TEAM.AXIS, false, "PLANT_Command_Post" );
		Util.MapDebugPrint( "Command_Post_Destroyed" );
	},	
};

global OnMapLoad = function()
{
	// Register callback functions
	OnTrigger( "Axis Command Post constructed. Charge speed increased!", Map.Axis_Command_Post_Built );
	OnTrigger( "Allied Command Post constructed. Charge speed increased!", Map.Allied_Command_Post_Built );
	OnTrigger( "First Barrier has been constructed.", Map.Truck_Barrier_1_Built );
	OnTrigger( "Garage Door has been constructed.", Map.Garage_Door_Built );
	OnTrigger( "Second Barrier has been constructed.", Map.Truck_Barrier_2_Built );
	OnTrigger( "The truck has been repaired!", Map.truck_Built );
	OnTrigger( "^5The truck has been damaged", Map.truck_Damaged );
	OnTrigger( "Allied team has destroyed the Axis Command Post!", Map.Axis_Command_Post_Destroyed );
	OnTrigger( "Axis team has destroyed the Allied Command Post!", Map.Allied_Command_Post_Destroyed );
	OnTrigger( "First Barrier has been Destroyed!", Map.Truck_Barrier_1_Destroyed );
	OnTrigger( "Garage Door has been Destroyed!", Map.Garage_Door_Destroyed );
	OnTrigger( "Second Barrier has been Destroyed!", Map.Truck_Barrier_2_Destroyed );
	OnTrigger( "^5Cave Rocks has been destroyed!", Map.cave_rocks_Destroyed );
	OnTrigger( "^1Axis have passed the first Barrier!", Map.Truck_Barrier_1_Passed );
	OnTrigger( "^1Axis have passed the Garage Door!", Map.Garage_Door_Passed );
	OnTrigger( "^1Axis have passed the Second Barrier!", Map.Truck_Barrier_2_Passed );
	
	Util.DisableGoal( ".*", true ); // all but routes
	
	SetAvailableMapGoals( TEAM.AXIS, true, "ESCORT_Truck" );
	SetGoalPriority( "ESCORT_truck", 1.20, TEAM.AXIS );
		
	SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Truck_Barrier_1" );
	SetGoalPriority( "BUILD_Truck_Barrier_1", 1.10, TEAM.ALLIES, CLASS.ENGINEER );
	
	SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_b1.*" );
	SetAvailableMapGoals( TEAM.AXIS, true, "ATTACK_b1.*" );
		
	// Max users per goal
	Util.SetMaxUsers( 1, "ESCORT_.*" );
	Util.SetMaxUsers( 2, "PLANT_.*" );
	Util.SetMaxUsers( 2, "BUILD_.*" );

	//Camp times
	//SetMapGoalProperties( "MOUNTMG42_.*", {MinCampTime=15, MaxCampTime=90} );
	Util.MapDebugPrint( "Omni-bot map script for " + GetMapName() + " executed." );
};

