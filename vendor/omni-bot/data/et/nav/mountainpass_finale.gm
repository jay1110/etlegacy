global OnMapLoad = function()
{
	// Register callback functions
	OnTrigger( "The allies have stolen the Actionfigure!", Map.docs_Taken );
	OnTrigger( "The axis return the Actionfigure!", Map.docs_Returned );
	OnTrigger( "The allies have secured the Actionfigure!", Map.docs_Secured );

