	MapRoutes[ "PLANTMINE_crates.*" ] = MapRoutes.BUILD_citadel_entrance_barrier;

	Util.Routes( MapRoutes );
};

global WeaponGoals =
{
	MOBILEMORTAR_AXIS_START_BROKEN_WALL_FACING = Vec3( -0.926, 0.191, 0.325 ),
	MOBILEMORTAR_AXIS_START_GUN_CONTROL_LADDER_MATERIALS_FACING = Vec3( -0.778, 0.599, 0.190 ),
	MOBILEMORTAR_AXIS_START_GUN_CONTROL_ALLIED_ACCESS_FACING = Vec3( -0.912, 0.343, 0.225 ),

	MOBILEMORTAR_AXIS_START_MAP_GOAL = GetGoal( "MOBILEMORTAR_axis_start" ),

	Favor_Airstrike_Over_Spawn_Ammo_Dispense = function()
	{
		Map.DontDispenseAmmo = true;
		SetGoalPriority( "AIRSTRIKE_ammo_1", 0.81 );
		sleep( 1 ); // Just enough to skip the goal
		Map.DontDispenseAmmo = false;
		SetGoalPriority( "AIRSTRIKE_ammo_1", 0.80 );
	},

	// Around 15 seconds for Allies to get there
	// Around 3-4 seconds between the shot and the hit
	// Artillery will push them back for a couple seconds
	Hold_MobileMortar_Axis_Start_Until_Allies_At_Wall = function()
	{
		// Make sure the 1st shot is targeted at the broken wall
		WeaponGoals.MOBILEMORTAR_AXIS_START_MAP_GOAL.MortarAim[ 1 ] = null;

		WeaponGoals.MOBILEMORTAR_AXIS_START_MAP_GOAL.DontShootMortar = true;
		sleep( 10 + 2 );
		WeaponGoals.MOBILEMORTAR_AXIS_START_MAP_GOAL.DontShootMortar = false;

		sleep( 3 );
		WeaponGoals.MOBILEMORTAR_AXIS_START_MAP_GOAL.MortarAim[ 1 ] = WeaponGoals.MOBILEMORTAR_AXIS_START_GUN_CONTROL_LADDER_MATERIALS_FACING;
	},

	Manage_DEFENDER_Bot_Weapon_Switch_OnSwitchActivated = function()
	{
		defenderBot = null;
		foreach ( bot in BotTable )
		{
			if ( bot.HasRole( ROLE.DEFENDER ) )
			{
				defenderBot = bot;
				break;
			}
		}

		if ( defenderBot == null ) { return; }

		if ( !defenderBot.ChangePrimaryWeapon( WEAPON.MOBILE_MG42 ) )
		{
			Util.MapDebugPrint( "DEFENDER bot couldn't change to Mobile MG42", 2 );
			return;
		}

		thread( ETUtil.SuicideNextSpawn, defenderBot );
	},

	Manage_MobileMortar_Axis_Start_Targets = function()
	{
		if ( !Map.isAmmoTakenOrSecured )
		{
			WeaponGoals.MOBILEMORTAR_AXIS_START_MAP_GOAL.MortarAim[ 0 ] = WeaponGoals.MOBILEMORTAR_AXIS_START_BROKEN_WALL_FACING;
			WeaponGoals.MOBILEMORTAR_AXIS_START_MAP_GOAL.MortarAim[ 1 ] = WeaponGoals.MOBILEMORTAR_AXIS_START_GUN_CONTROL_LADDER_MATERIALS_FACING;
		}
		else
		{
			WeaponGoals.MOBILEMORTAR_AXIS_START_MAP_GOAL.MortarAim[ 0 ] = WeaponGoals.MOBILEMORTAR_AXIS_START_GUN_CONTROL_ALLIED_ACCESS_FACING;
			WeaponGoals.MOBILEMORTAR_AXIS_START_MAP_GOAL.MortarAim[ 1 ] = WeaponGoals.MOBILEMORTAR_AXIS_START_GUN_CONTROL_LADDER_MATERIALS_FACING;
		}

		WeaponGoals.MOBILEMORTAR_AXIS_START_MAP_GOAL.AdjustOrientation();
	}
};

global Utils =
{
	// Only cycle through bots/ignore real players
	ExistBotClass = function( team, class )
	{
		foreach ( bot in BotTable )
		{
			if ( bot.GetTeam() == team && bot.GetClass() == class )
			{
				return true;
			}
		}

		return false;
	}
};
