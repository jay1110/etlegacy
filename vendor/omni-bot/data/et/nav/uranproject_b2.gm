    killzone =//missing kill commands
    {
        Name = "killzone",
        TriggerOnClass = CLASS.ANYPLAYER,
        OnEnter = function(ent)
        {
            if(GetEntTeam(ent) == TEAM.ALLIES )
            {
                    b = Util.GetBotByName(GetEntName(ent));
                    if (b)
                    {
                        b.SayTeam("ALLIES Im in the killzone");                        
                    }
                if (GetEntFlags( ent, ENTFLAG.CARRYINGGOAL))
                {
                    b = Util.GetBotByName(GetEntName(ent));
                    if (b)
                    {
                        b.SayTeam("ALLIES OBJECTIVE killzone");                        
                    }
                    //SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_tunnel_.*" );                                                                                              
                Util.MapDebugPrint( "^26_AXIS ^ePLAYER IS AT THE AXIS_CAPPOINT_ROOM ^2ENTRANCE WITH THE ^1OBJECTIVE" ); //works                   
                }
            Util.MapDebugPrint( "^27_ALLIED ^ePLAYER IS AT THE _CAPPOINT_ROOM ^2ENTRANCE" );//works
            }            
		Util.MapDebugPrint( "^2ENTER" );         
        },
        OnExit = function(ent)
        {
            
            if(GetEntTeam(ent) == TEAM.ALLIES )
            {
                if (GetEntFlags( ent, ENTFLAG.CARRYINGGOAL))
                {
                    b = Util.GetBotByName(GetEntName(ent));
