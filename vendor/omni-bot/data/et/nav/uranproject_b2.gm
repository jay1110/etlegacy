    NEW_TRIGGER2 = function( trigger )
	{
        if ( trigger.Action == "opening" )
        {
                //doorsopening_elevatorisdown
            Map.liftStatus = 0;
            liftlowerfloordoorOpen = true; 		
			//Map.Switches.Elevatortop.Enabled = false;
            //Map.Switches.Elevatorbottom.Enabled = false;           
                  Util.MapDebugPrint( "^6BOTTOMDOORS_OPENING" );  
        }
    else if ( trigger.Action == "closing" )
        {
            Map.liftStatus = 1;
            liftlowerfloordoorOpen = false;
			//Map.Switches.Elevatortop.Enabled = false;
            //Map.Switches.Elevatorbottom.Enabled = false;
                Util.MapDebugPrint( "^6BOTTOMDOORS_CLOSING_GOINGUP" );
        }

		Util.MapDebugPrint( "^6NEW_TRIGGER2 Elevator bottomdoors" );
	},
   
       NEW_TRIGGER3 = function( trigger )
	{
        if ( trigger.Action == "opening" )
        {
                //doorsopening_elevatorisdown
            Map.liftStatus = 0;
            liftfirstfloordoorOpen = false; 
			//Map.Switches.Elevatortop.Enabled = false;
            //Map.Switches.Elevatorbottom.Enabled = false;          
                  Util.MapDebugPrint( "^6TOPDOORS_CLOSING_GOINGDOWN" );  
        }
    else if ( trigger.Action == "closing" )
        {
            Map.liftStatus = 1;
            liftfirstfloordoorOpen = true;
			Map.Switches.Elevatortop.Enabled = true;
            Map.Switches.Elevatorbottom.Enabled = true;
                Util.MapDebugPrint( "^6TOPDOORS_OPENING" );
        }

		Util.MapDebugPrint( "^6NEW_TRIGGER3 Elevator TOPDOORS" );
	},

