 RideMovers =
 {
    big_aufzug_allies =
		{
			movergoal = "MOVER_big_aufzug",
			rideposition = Vec3(-3.837, 2.727, 250.625),
			stance = BTN.CROUCH,
            maxusers = 5,
			startwp = "home",
			exitwp = null,
			board = function( _this )
			{
				return Map.floorathome == true;
			},

			leave = function( _this )
			{
				if ( Map.endoffloorride == true && _this.Bot.GetTeam() == TEAM.ALLIES )
				{
					Map.RideMovers.big_aufzug_allies.exitwp = "end";
					return true;
				}

				if ( Map.endoffloorride == true && _this.Bot.GetTeam() == TEAM.AXIS )
				{
					Map.RideMovers.big_aufzug_allies.exitwp = "end";
					return true;
				}

				return false;
			},
		},
        
