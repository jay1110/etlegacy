	Bridge_Destroyed = function( trigger )
	{
        if (Map.MainBunkerDoorDestroyed == true)
        {
                  
        Util.DisableGoal( "SWITCH_towerdoor", true );
        Util.DisableGoal( "SWITCH_funnelmaingate", true ); 
Util.DisableGoal( "PLANT_Bunker_Backdoor", true );
