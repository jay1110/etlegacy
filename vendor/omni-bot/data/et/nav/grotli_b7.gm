	Main_Gate_Destroyed = function( trigger )
	{
		if ( TestMap )
			{ return; }

		SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_Side_Entrance" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_Vault_room_door" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_maingate_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_firstbarrier_.*" );		
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_secondbarrier_.*" );	
		SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_first_Tank_Barrier" );	
		SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_second_Tank_Barrier" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_gold_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_alliedvault_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_tankgate_.*" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_flag_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "BUILD_Vault_room_door" );	
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_gold_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_axistunnel_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_firstbarrier_.*" );
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_secondbarrier_.*" );		
		SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_maingate_.*" );
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_tankgate_.*" );	
		SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_flag_.*" );		

		sleep(4);
		Util.BotChat(TEAM.ALLIES, "vsay", VOICE.LETS_GO, 1);	

		Map.Main_Gate_Dyno = 0;

		Util.MapDebugPrint( "Main_Gate_Destroyed" );
	},

