	Ebbelwoi_Express_Built = function( trigger )
	{
		// ALLIES: Escort the Tank, focus on tank, use Tank MG seat
		SetAvailableMapGoals( TEAM.ALLIES, true, {
			"ESCORT_tank",                           // Escort the Tank
			"MOVER_tank",                            // Focus on Tank
			"MOUNT_tank",                            // Tank MG seat
		});

		// AXIS: focus on Tank and use the Tank MG seat
		SetAvailableMapGoals( TEAM.AXIS, true, {
			"MOVER_tank",                            // Focus on Tank
			"MOUNT_tank_axis",		                 // Tank MG seat
		});
		
		// Tank has been built or repaired
		if(Map.Debug==1){EchoToScreen (10,"^1TRIGGER: ^2Ebbelwoi_Express_Built");}
		Util.MapDebugPrint( "Ebbelwoi_Express_Built" );
	},
	
