						},
					},
				},
			},
			
			// from the Old City
			ROUTE_OLDCITY =
			{
				// Eastgate Route
				ROUTE_EASTGATE =
				{
					Weight = 2,
					ROUTE_ALLIES_SPAWN =
					{
						ROUTE_OLDBRIDGE_ALLIES = {},
					},
				},
				
				// Eastgate Route Left
				ROUTE_EASTGATE_LEFT =
				{
					Weight = 2,
					ROUTE_ALLIES_SPAWN =
					{
						ROUTE_OLDBRIDGE_ALLIES = {},
					},
				},

				// Eastgate Route Right
				ROUTE_EASTGATE_LEFT =
				{
					Weight = 2,
					ROUTE_ALLIES_SPAWN =
					{
						ROUTE_OLDBRIDGE_ALLIES = {},
					},
				},

				// Bunker Crossway Route
				ROUTE_BUNKER_CROSSWAY =
				{
					ROUTE_ALLIES_SPAWN =
					{
						ROUTE_OLDBRIDGE_ALLIES = {},
					},
				},
			},
		},
	};
	
	// copy identical Routes
	MapRoutes.FLAG_bembel = MapRoutes.PLANT_Vault;
	MapRoutes["ATTACK_DISCO_.*"] = MapRoutes.PLANT_Vault;
	MapRoutes["DEFEND_DISCO_.*"] = MapRoutes.DEFEND_DISCO_1;
	MapRoutes["ATTACK_KAISERSAAL_.*"] = MapRoutes.FLAG_recipe;
	MapRoutes["DEFEND_KAISERSAAL_.*"] = MapRoutes.DEFEND_KAISERSAAL_1;
	MapRoutes["ATTACK_TRUCK_.*"] = MapRoutes.ATTACK_TRUCK_1;
	MapRoutes["DEFEND_TRUCK_.*"] = MapRoutes.DEFEND_TRUCK_2;
	MapRoutes["SWITCH_ROEMER.*"] = MapRoutes.ROUTE_ROEMERLIFT;
	MapRoutes.REPAIRMG42_mg42_roof = MapRoutes.MOUNTMG42_mg42_roof;

	Util.Routes(MapRoutes);
	Util.MapDebugPrint("Omnibot Script: Routes loaded");
		
	Util.MapDebugPrint( "Omnibot Script: Executed for map " + GetMapName() );
	print("Omnibot Script for map " + GetMapName() + " loaded. Attaway, baby!");
	
};



// ===========================================================================
// Initial settings for bots on joining the game
// ===========================================================================
global OnBotJoin = function( bot )
{
	// limit Bot viewing distance to limit Field Ops "battles" at the river
	bot.MaxViewDistance = 1500;
	
	// limit func_explosive action distance (only break if *really* close)
	bot.TargetBreakableDist = 32.0;
	
	Map.SetSpawn1(bot);
};