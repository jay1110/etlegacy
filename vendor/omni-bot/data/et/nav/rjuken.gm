/*
 * TODO:
 * - Realised I've disabled the routing... without explanation (part of the commit with the lift closed flag management)
 * - Beyond Electric Fence handling:
 *		* Missing case only Allies capable of finishing the map, would need to make Axis use buttons to temp disable electricity to get through etc.
 * - When both caches built + Fence disabled, CHECKPOINT_topdamflag priority could be raised? + When players beyond Fence when electrified
 */

/*
 * Objective
 * Build both Explosive Caches (cannot be planted; 8s after => Top Dam flag is forced on Axis)
 * Blow up Electric Fence Controls
 * Built Explosive Trigger Primer
 * 1 min 10s cooldown - Axis can destroy it with either satchel or dynamite ONTOP-ONLY of it...
 * Trigger the explosion
 */

/*
 * Grates (pipes in water)
 * #1 (North-East) => Leads to the ladder after Explosives #2 room
 * #2 (North-West) => Dead end?
 * #3 (South-East) => Leads to between Axis Spawn front and Explosives #2 room
 * #4 (South-West) => Some ladders leading to turbines room ceiling
 */

/*
 * Other notes
 * (1) Fixed MG42's are not handled, because the nav to get back down is annoying (even as a real player)
 * (2) If Grate #4 way is opened, the elevator top-to-bottom way is closed,
 *     in order to force bots to go through the water pipe leading to the turbines room ceiling
 *     => Routing thus disabled (commented-out)
 */

global Spawn =
{
	TOP_OF_DAM				= 1,
	ALLIED_SPAWN			= 2,
	AXIS_SPAWN				= 3,
	ALLIED_TRIGGER_SPAWN	= 4 // Commented-out in script
};

global Map =
{
	areBothExplosiveCachesBuilt = false,
	areElectricFenceControlsDestroyed = false,
	isExplosiveTriggerBuilt = false,
	isExplosiveTriggerPrimed = false,

	topDamFlagOwner = TEAM.AXIS,

	liftEntity,
	liftStatus,

	LiftStatus =
	{
		TOP			= 0,
		MOVING_DOWN	= 1,
		BOTTOM		= 2,
		MOVING_UP	= 3
	},

	Navigation =
	{
		// /bot waypoint_setproperty paththrough Navigation_PT:cabinets_ladder
		cabinets_ladder =
		{
			navigate = function()
			{
				wpTable = {};
				Wp.GetWaypointByName( "cabinets_ladder_bottom", wpTable );
				if ( this.Goto( wpTable.position ) == EVENT.PATH_SUCCESS )
				{
					// Look up the ladder
					this.AddAimRequest( Priority.High, "facing", Vec3( 0, 0, 1 ) );

					// Get at the middle of that ladder
					this.Bot.HoldButton( BTN.FORWARD, 2 );
					sleep( 2 );

					// While maintaining the facing,
					// strafe left to get off the ladder,
					// and land on the cabinets floor
					this.Bot.HoldButton( BTN.STRAFE_L, 1 );
					sleep( 1 );

					this.ReleaseAimRequest();
				}
			}
		},

		// /bot waypoint_setproperty paththrough Navigation_PT:look_down
		look_down =
		{
			navigate = function()
			{
				// Face opposite to the ladder to snap out of it
				this.AddAimRequest( Priority.High, "facing", Vec3( 0, -1, 0 ) );
				sleep( .5 );
				// Look down
				this.AddAimRequest( Priority.High, "facing", Vec3( 0, 0, -1 ) );
				sleep( 2 );
				this.ReleaseAimRequest();
			}
		}
	},

	Roles =
	{
		AXIS =
		{
			AllBots = true,

			// Dam Top
			DEFENDER =
			{
				crucialClass = CLASS.ENGINEER, // Entry Door + CP
				numbots = 3
			},

			// Dam Bottom
			DEFENDER1 =
			{
				AllBots = true,
				crucialClass = CLASS.ENGINEER, // Explosive Caches
				numbots = 3,
				spawnpt = Spawn.AXIS_SPAWN
			}
		},

		ALLIES =
		{
			AllBots = true,

			// Dam Top
			ATTACKER =
			{
				crucialClass = { CLASS.ENGINEER, CLASS.COVERTOPS }, // Entry Door + CP + Grates
				numbots = 3
			},

			// Dam Bottom
			ATTACKER1 =
			{
				AllBots = true,
				crucialClass = CLASS.ENGINEER, // Explosive Caches (Electric Fence Controls can be focused after)
				numbots = 3
			}
		}
	},

	Switches =
	{
		// /bot waypoint_setproperty paththrough UseSwitch_PT:lift_top_outside
		lift_top_outside =
		{
			AimPosition = Vec3( -145, 190, 230 ), // /bot aim_pos
			Enabled = false,
			Priority = 0,
			Timeout = 22000, // 20s movement + 2s door opening
			WaypointName = "lift_top_outside",

			ExitConditions = // press the button only when the lift is at bottom position
			{
				f = function()
				{
					if (Map.liftStatus == Map.LiftStatus.MOVING_DOWN)
					{
						if(this){ this.ReleaseAimRequest(); }
						dowhile (Map.liftStatus == Map.LiftStatus.MOVING_DOWN)
						{
							yield();
						}
						sleep(5); //wait so that others can enter or exit
						if(this){ this.AddAimRequest(Priority.High, "position", Map.Switches.lift_top_outside.AimPosition); }
					}
					return Map.liftStatus != Map.LiftStatus.BOTTOM; // Return true to stop pressing the button
				}
			},

			Wait = function() // wait for slow moving lift
			{
				return Map.liftStatus == Map.LiftStatus.TOP; // Return true to finish the paththrough and go through the door
			}
		},

		// /bot waypoint_setproperty paththrough UseSwitch_PT:lift_top_inside
		lift_top_inside =
		{
			AimPosition = Vec3( -350, -50, 200 ), // /bot aim_pos
			Enabled = true,
			Priority = 0,
			Timeout = 20000, // 20s movement
			WaypointName = "lift_top_inside",

			Wait = function()
			{
				return Map.liftStatus == Map.LiftStatus.BOTTOM;
			}
		},

		// /bot waypoint_setproperty paththrough UseSwitch_PT:lift_bottom_outside
		lift_bottom_outside =
		{
			AimPosition = Vec3( -580, 190, -955 ), // /bot aim_pos
			Enabled = true,
			Priority = 0,
			Timeout = 22000, // 20s movement + 2s door opening
			WaypointName = "lift_bottom_outside",

			ExitConditions = // press the button only when the lift is at top position
			{
				f = function()
				{
					if (Map.liftStatus == Map.LiftStatus.MOVING_UP)
					{
						if(this){ this.ReleaseAimRequest(); }
						dowhile (Map.liftStatus == Map.LiftStatus.MOVING_UP)
						{
							yield();
						}
						sleep(5); //wait so that others can enter or exit
						if(this){ this.AddAimRequest(Priority.High, "position", Map.Switches.lift_bottom_outside.AimPosition); }
					}
					return Map.liftStatus != Map.LiftStatus.TOP; // Return true to stop pressing the button
				}
			},

			Wait = function() // wait for slow moving lift
			{
				return Map.liftStatus == Map.LiftStatus.BOTTOM; // Return true to finish the paththrough and go through the door
			}
		},

		// /bot waypoint_setproperty paththrough UseSwitch_PT:lift_bottom_inside
		lift_bottom_inside =
		{
			AimPosition = Vec3( -350, -50, -935 ), // /bot aim_pos
			Enabled = false,
			Priority = 0,
			Timeout = 20000, // 20s movement
			WaypointName = "lift_bottom_inside",

			Wait = function()
			{
				return Map.liftStatus == Map.LiftStatus.TOP;
			}
		}
	},

