	Clear_Final_Area_Role_For_Ent = function( ent )
	{
		bot = Util.IsBot( ent );
		if ( !bot ) { return; }
		Map.Clear_Final_Area_Role_For_Bot( bot );
	},

	Clear_Final_Area_Role_For_Bot = function( bot )
	{
		if ( bot.GetTeam() == TEAM.AXIS && bot.HasRole( ROLE.DEFENDER2 ) )
		{
			bot.ClearRoles( ROLE.DEFENDER2);
			Util.MapDebugPrint( "DEFENDER2 role cleared for " + bot.Name, true );
			return;

		}

		if ( bot.GetTeam() == TEAM.ALLIES && bot.HasRole( ROLE.ATTACKER2 ) )
		{
			bot.ClearRoles( ROLE.ATTACKER2);
			Util.MapDebugPrint( "ATTACKER2 role cleared for " + bot.Name, true );
		}
	},

	Allied_Command_Post_Built = function()
	{
		Util.MapDebugPrint( "Allied_Command_Post_Built", true );
	},

	Axis_Command_Post_Built = function()
	{
		Util.MapDebugPrint( "Axis_Command_Post_Built", true );
	},

