    tankdone =
 	{
 		Name="tankdone",
 		TriggerOnEntity = GetGoal("MOVER_tank").GetEntity(),
 		OnEnter = function(ent)
 		{
		sleep(6.1);
		ETUtil.KillTeam(TEAM.ALLIES);
		ETUtil.KillTeam(TEAM.AXIS, 8);
		sleep(0.1);
		Wp.CheckBlockable();
		Util.DisableGroup("al1");
		Util.DisableGroup("ax1");
	//SetAvailableMapGoals( TEAM.ALLIES, false, "ESCORT_Tank" );
//SetAvailableMapGoals( TEAM.ALLIES, false, "MOUNT_Tank" );
//SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Tank" );
		SetAvailableMapGoals(TEAM.ALLIES, 1, ".*Command_Post");
		SetAvailableMapGoals(TEAM.ALLIES, 0, "SMOKEBOMB.*");
		Util.SetGoalRange("BUILD_Neutral_Command_Post", 6000);

		SetGoalGroup({
			"FLAG_allied_gold",
			"CAPPOINT_GateControls",
			".*MG42_569",
			".*MG42_45",
		}, "al2");
		Util.EnableGroup("al2", TEAM.ALLIES);

		SetGoalGroup({
			"DEFEND_key.*",
			"DEFEND_2_.*",
			"SNIPE_DEFEND_A1",
			"PLANTMINE_g.*",
			".*MG42_357",
			".*MG42_362",
			".*MG42_472",
		}, "ax2");
		Util.EnableGroup("ax2", TEAM.AXIS);

		Util.MapDebugPrint("Garrison_wall_Destroyed 2");
 			Util.MapDebugPrint(GetEntName(ent) + " ^5Tank entering");
			Util.MapDebugPrint("^5Tank trigger works ENTER");
 		},
 		OnExit = function(ent)
 		{
            Util.RemoveGoal( "MOVER_tank", true );
            //SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_Tank_Barrier_2" );
            //SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_Tank_Barrier_2" );
			Util.MapDebugPrint(GetEntName(ent) + " exited aabb trigger");
			Util.MapDebugPrint("^4TRUCK EXIT");
 		},     
    },

};

global OnMapLoad = function()
{
	//OnTrigger("^dThe tank has been repaired!", Map.Tank_Built);
	//OnTrigger("^1The tank has been damaged!", Map.Tank_Damaged);
	//OnTrigger("^1The Tank Barrier has been constructed.", Map.Tank_Barrier_Built);
	//OnTrigger("^dThe Tank Barrier has been destroyed.", Map.Tank_Barrier_Destroyed);
	//OnTrigger("^dAllies ^3have built the Sola River Bridge!", Map.Sola_River_Bridge_Built);
	//OnTrigger("^1Axis ^3has destroyed the Sola River Bridge!", Map.Sola_River_Bridge_Destroyed);
	OnTriggerRegion(AABB(1681.095,5902.999,667.125,2304.177,6078.087,741.133), Map.tankdone);    
	//OnTrigger("^7Allies have destroyed the Garrison Door!", Map.Garrison_Door_Destroyed);
OnTrigger("^7Allied team has breached the Garrison!", Map.Garrison_Door_Destroyed);
	OnTrigger("^7Allies have built the assault ramp!", Map.Assault_Ramp_Built);
	OnTrigger("^7Axis has damaged the assault ramp!", Map.Assault_Ramp_Destroyed);

	OnTrigger("^7Axis has repaired the gas control!", Map.Gas_Control_Built);
	OnTrigger("al_gc_destroyed", Map.Gas_Control_Destroyed);

	OnTrigger("^7Axis has built the infantry barrier!", Map.Invasion_Barrier_Built);
	OnTrigger("^7Allies have destroyed the infantry barrier!", Map.Invasion_Barrier_Destroyed);

	OnTrigger("^7Allies have built the scaffold!", Map.scaffolding_Built);
	OnTrigger("^7Axis has damaged the scaffold!", Map.scaffolding_Destroyed);

	OnTrigger("the execution wall Destroyed.", Map.execution_wall_Destroyed);

	OnTrigger("^7Allies ^3have taken the Main Gate key!", Map.allied_gold_Taken);
	OnTrigger("^7Axis ^3has returned the Main Gate key!", Map.allied_gold_Returned);
	//OnTrigger("^7Allied team ^3has opened the camp's main gate!", Map.Main_Gate_Open);

	OnTrigger("Allies captured goldishere", Map.Main_Gate_Open);
	OnTrigger("^7Allies ^3have taken the Artillery Shell!", Map.zyklon_Taken);
	OnTrigger("^7Axis ^3have returned the Artillery Shell!", Map.zyklon_Returned);
	OnTrigger("^7Allies ^3have delivered the Artillery Shell", Map.zyklon_Secured);

	OnTrigger("^7Axis ^3have captured the Main Camp!", Map.superflag_Axis_Captured);
	OnTrigger("^7Allies ^3have captured the Main Camp!", Map.superflag_Allies_Captured);

	OnTriggerRegion(Vec3(3196, 5424, 695), 100, RegionTrigger.VehicleTrigger);
	OnTrigger("tank at location", Map.tank_at_location);

	Util.DisableGoal(".*", true);

	Util.LimitToClass("PLANT_scaffolding", 1, 5);
	Util.LimitToClass("PLANT_Assault_Ramp", 1, 5);
	Util.LimitToClass("PLANT_Neutral_Command_Post", 0, 5);

	Util.AddUsePoint("PLANT_Invasion_Barrier", Vec3(8787, 5752, 672));
	Util.AddUsePoint("PLANT_Assault_Ramp", Vec3(5015, 7961, 722));

	//SetAvailableMapGoals( TEAM.AXIS, false, "BUILD_Radio_door" );

	SetGoalGroup({
		"BUILD_Tank",
		"MOUNT_Tank",
		"ESCORT_Tank",
		"BUILD_Sola_River_Bridge",
		"PLANT_Tank_Barrier",
		"SNIPE_ATTACK_.*",
            "ARTILLERY_S_crates_1",
            "ARTILLERY_S_crates_2",
            "ARTILLERY_S_crates_3",
            "ARTILLERY_S_crates_4",
            "ARTILLERY_S_crates_5",
            "ARTILLERY_S_crates_6",
            "ARTILLERY_S_crates_7",
            "ARTILLERY_S_crates_8",
            "ARTILLERY_S_crates_9",
            "CALLARTILLERY_barrier_1",
            "CALLARTILLERY_barrier_2",
            "CALLARTILLERY_barrier_3",
            "CALLARTILLERY_barrier_4",
	}, "al1");
	Util.EnableGroup("al1", TEAM.ALLIES);

	SetGoalGroup({
		"BUILD_Tank_Barrier",
		"PLANT_Sola_River_Bridge",
		".*Command_Post",
		"DEFEND_1_.*",
		"SNIPE_DEFEND_[BC].*",
		"MOUNTMG42_244",
		"MOUNTMG42_488",
	}, "ax1");
	Util.EnableGroup("ax1", TEAM.AXIS);

	SetGoalPriority("DEFEND_control.*", 0.51);
	SetGoalPriority("BUILD_Assault_Ramp", 0.81);
	SetGoalPriority("PLANT_Invasion_Barrier", 0.9);
	SetGoalPriority("SNIPE.*", 0.8);
	SetGoalPriority("CHECKPOINT.*", 0.5);

	Util.SetGoalRange("BUILD_Neutral_Command_Post", 3100);

	SetMapGoalProperties("DEFEND.*", {MinCampTime=10, MaxCampTime=70});
	SetMapGoalProperties("SNIPE.*", {MinCampTime=300, MaxCampTime=400});

	Util.SetMaxUsers(1, {"MOUNTMG42.*", ".*Command_Post", "BUILD_Sola_River_Bridge"});

	Util.MapDebugPrint("Omni-bot map script for " + GetMapName() + " executed.");
};

global OnBotJoin = function(bot)
{
	bot.TargetBreakableDist = 90;
};

