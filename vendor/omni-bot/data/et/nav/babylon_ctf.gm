global Map =
{
	SaveCampTime = 0,
	
	win_Axis_Captured = function()
	{
		Util.MapDebugPrint( "win_Axis_Captured" );
	},

	win_Allies_Captured = function()
	{
		Util.MapDebugPrint( "win_Allies_Captured" );
	},

};

global OnMapLoad = function()
{
	OnTrigger( "^1Axis ^dKnow how to capture a Flag^2!!!", Map.win_Axis_Captured );
	OnTrigger( "^4Allies ^dKnow how to capture a Flag^2!!!", Map.win_Allies_Captured );

	Util.LimitToTeam(TEAM.AXIS, "ATTACK_x.*");
	Util.LimitToTeam(TEAM.ALLIES, "ATTACK_l.*");
	Util.MapDebugPrint( "Omni-bot map script for " + GetMapName() + " executed." );
};
