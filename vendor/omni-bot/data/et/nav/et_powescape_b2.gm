	SetAvailableMapGoals( TEAM.AXIS, false, "SWITCH_key" );//THISIS activationkey1 
                }
            }
		Util.MapDebugPrint( "^2KEY 3 TRIGGER ENTER" );        
        },
        OnExit = function(ent)
        {
            if(GetEntTeam(ent) == TEAM.AXIS )
            {
                if (GetEntFlags( ent, ENTFLAG.CARRYINGGOAL))
                {
                                            //Util.ClearRoleForGoals( "FLAG_.*", ROLE.DEFENDER1 );
                            //Util.SetRoleForGoals( "CAPPOINT_.*", ROLE.DEFENDER1 );
Util.BotChat( TEAM.AXIS, "sayteam", "^eI Have Picked Up Activation Key Number 3", 1 );                     
                    b = Util.GetBotByName(GetEntName(ent));
                    if (b)
                    {
                        b.SayTeam("I Have Picked Up Activation Key Number 3");
                        
                    }
                foreach (id and bot in BotTable)
                {
                    if ( bot.GetTeam() == TEAM.ALLIES )
                    {
                        bot.SayTeam("Do not Allow The Axis To Secure The Key Number 3 IT Activate's The Super Soldier's");
                        break;
                    }
                }
                                                        //Util.ClearRoleForGoals( "FLAG_activationkey.*", ROLE.DEFENDER1 );
                            //Util.SetRoleForGoals( "CAPPOINT_.*", ROLE.DEFENDER1 );
    SetAvailableMapGoals( TEAM.AXIS, false, "FLAG_activationkey1" );
    SetAvailableMapGoals( TEAM.AXIS, false, "FLAG_activationkey2" );
    SetAvailableMapGoals( TEAM.AXIS, false, "SWITCH_flag_1_pickup" );//THISIS activationkey1
	SetAvailableMapGoals( TEAM.AXIS, false, "SWITCH_key" );//THISIS activationkey1
                            SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_infrontofbarracks2b_.*" ); //insidebarracks2b
    SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_maingate_.*" ); 
    SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_insidewallcarcrashlane_.*" );
            		Util.MapDebugPrint( "^2AXIS ^6HAVE THE OBJECTIVE ^3Key 3" );
                    		// some bot talk:
		if ( !MAP_TALK )
			{ return; }

		sleep(0.5);
		foreach ( id and bot in BotTable )
		{
			if ( bot.HasAnyEntityFlag( ENTFLAG.CARRYINGGOAL ) )
			{
				if ( bot.GetNearestAlly( CAT.PLAYER ) )
				{
					bot.SayVoice( VOICE.FOLLOW_ME );
				}
				else
				{
					bot.SayVoice( VOICE.NEED_BACKUP );
				}
				break;
			}
		}
	     
                }
            		Util.MapDebugPrint( "^2AXIS ^3PLAYER IS AT ^3Key 3 LOCATION" );            
            }
		Util.MapDebugPrint( "^2KEY 3 TRIGGER EXIT" );        
