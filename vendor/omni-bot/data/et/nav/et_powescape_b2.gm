    SetMapGoalProperties( "DEFEND_cappointtrainlocomotive_.*", {MinCampTime=320, MaxCampTime=500} );//*****
    //SetMapGoalProperties( "ATTACK_key_cap_point_.*", {MinCampTime=120, MaxCampTime=200} );//***** 
    SetMapGoalProperties( "DEFEND_train_cap_point_.*", {MinCampTime=320, MaxCampTime=500} );//*****
    //SetMapGoalProperties( "ATTACK_CAPROOM_.*", {MinCampTime=120, MaxCampTime=200} );//*****
              
	//SetMapGoalProperties( "MOUNTMG42_.*", {MinCampTime=15, MaxCampTime=90} );
   // SetMapGoalProperties( "ATTACK_door_2_intolabarea_.*", {MinCampTime=120, MaxCampTime=200} );
    //SetMapGoalProperties( "ATTACK_door_1intolabarea_.*", {MinCampTime=120, MaxCampTime=200} );
    //SetMapGoalProperties( "ATTACK_bluespinningroom_.*", {MinCampTime=120, MaxCampTime=200} );
 
    //SetMapGoalProperties( "ATTACK_CP_BOTHSTEPS_AREA_TOCAPROOM_.*", {MinCampTime=120, MaxCampTime=200} );
    
    //SetMapGoalProperties( "ATTACK_*.*", {MinCampTime=60, MaxCampTime=100} );
    //SetMapGoalProperties( "DEFEND_*.*", {MinCampTime=60, MaxCampTime=100} ); 

	Util.MapDebugPrint( "Omni-bot 9 map script for " + GetMapName() + " executed." );
	Util.MapDebugPrint( "^7ETS|^1C^2Y^3B^6E^5R^04^1W^2O^3L^6F ^3Omni-bot 9 map script ^6Version ^19 ^3For the map: ^7" + GetMapName() + " executed." );
	print( "^7ETS|^1C^2Y^3B^6E^5R^04^1W^2O^3L^6F ^3Omni-bot 9 map script ^6Version ^19 ^3For the map: ^7" + GetMapName() );
	
	Util.BotChat( 0, "say", "^7ETS|^1C^2Y^3B^6E^5R^04^1W^2O^3L^6F ^3Omni-bot 9 map script ^6Version ^19 ^3For the map: ^7" + GetMapName(), 1 );
};

global OnBotJoin = function( bot )
{
	// Uncomment for shootable breakables
    Map.SetSpawn1(bot);
	bot.TargetBreakableDist = 0.1;
    Util.IgnoreTargetGoal( bot, "MOVER_shower_pump", 9999 );
    Util.IgnoreTargetGoal( bot, "MOVER_fish", 9999 );    
	// Only set MaxViewDistance on maps with limited sight (e.g. fog)
	bot.MaxViewDistance = 2400;
};

