        activationkey1_TakenTrigger = 
    {
        Name = "activationkey1_TakenTrigger",
        TriggerOnClass = CLASS.ANYPLAYER,
        OnEnter = function(ent)
        {
            if(GetEntTeam(ent) == TEAM.AXIS )
            {
                if (GetEntFlags( ent, ENTFLAG.CARRYINGGOAL))
                {
                    b = Util.GetBotByName(GetEntName(ent));
                    if (b)
                    {
                        b.SayTeam("I Have Picked Up Activation Key Number 1");                                             
                    }
                foreach (id and bot in BotTable)
                {
                    if ( bot.GetTeam() == TEAM.ALLIES )
                    {
                        bot.SayTeam("Do not Allow The Axis To Secure The Key Number 1 IT Activate's The Super Soldier's");                        
                    }
                }
    SetAvailableMapGoals( TEAM.AXIS, false, "FLAG_activationkey3" );
    SetAvailableMapGoals( TEAM.AXIS, false, "FLAG_activationkey2" );
                }
            }
        		Util.MapDebugPrint( "^2KEY 1 TRIGGER ENTER" );
        },
        OnExit = function(ent)
        {
            if(GetEntTeam(ent) == TEAM.AXIS )
            {
                if (GetEntFlags( ent, ENTFLAG.CARRYINGGOAL))
                {
                        //Util.ClearRoleForGoals( "FLAG_activationkey.*", ROLE.DEFENDER1 );
                            //Util.SetRoleForGoals( "CAPPOINT_.*", ROLE.DEFENDER1 );
Util.BotChat( TEAM.AXIS, "sayteam", "^eI Have Picked Up Activation Key Number 1", 1 );                     
                    b = Util.GetBotByName(GetEntName(ent));
                    if (b)
                    {
                        b.SayTeam("I Have Picked Up Activation Key Number 1");                        
                    }
                foreach (id and bot in BotTable)
                {
                    if ( bot.GetTeam() == TEAM.ALLIES )
                    {
                        bot.SayTeam("Do not Allow The Axis To Secure The Key Number 1 IT Activate's The Super Soldier's");
                        
                    }
                }
    SetAvailableMapGoals( TEAM.AXIS, false, "FLAG_activationkey3" );
    SetAvailableMapGoals( TEAM.AXIS, false, "FLAG_activationkey2" );
                            SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_infrontofbarracks2b_.*" ); //insidebarracks2b
    SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_maingate_.*" ); 
    SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_insidewallcarcrashlane_.*" );
            Util.MapDebugPrint( "^2AXIS ^6HAVE THE OBJECTIVE ^3Key 1" );    
                }
            		Util.MapDebugPrint( "^2AXIS ^3PLAYER IS AT ^3Key 1 LOCATION" );            
            }
