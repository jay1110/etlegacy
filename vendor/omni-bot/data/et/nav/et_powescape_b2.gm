	/*
        Allied spawns:	1 - First spawn = Shower Room - Allied only
		Axis spawns:	2 - First spawn = Officers Quarters - Axis Only
                        3 - Mess spawn
                        4 - Barracks - Allied Only
                        5 - Generals Quarters
                        6 - Front Gate
                        7 - North Gate
                        8 - North Command Post spawn        
			9 - Secret Lab Command Post spawn
                        10 - Train Station Command Post spawn

