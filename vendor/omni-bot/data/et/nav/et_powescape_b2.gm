//spawn at TSCP
	SetSpawn1 = function(bot)
	{
		if (bot.GetTeam() == TEAM.AXIS) {
            
			if (Map.TSCP_Owner == TEAM.AXIS){
                
				bot.ChangeSpawnPoint(10);
			} 
            else {
				bot.ChangeSpawnPoint(0);
			}
		}
	},

	SetSpawn = function()
	{
		foreach(bot in BotTable)
		{
			Map.SetSpawn1(bot);
		}
	},




//TRIGGERS TO TRACK PLAYER WITH OBJECTIVE

    trainroad2crashwall_Trigger = 
    {
        Name = "trainroad2crashwall_Trigger",
        TriggerOnClass = CLASS.ANYPLAYER,
        OnEnter = function(ent)
        {
            if(GetEntTeam(ent) == TEAM.ALLIES )
            {
                if (GetEntFlags( ent, ENTFLAG.CARRYINGGOAL))
                {
                    b = Util.GetBotByName(GetEntName(ent));
                    if (b)
                    {
                        b.SayTeam("I Have The ^1OBJECTIVE! ");                        
                    }
