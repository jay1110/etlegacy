    pow_tunnel_door1ISMoving = function( trigger )//door status trigger - use for door with trigger string and use with path through switch navigation
	{
		if ( trigger.Action == "opening" )
		{
			//Map.powtunneldoorClosed = false;
			//Map.powtunneldoorOpened = true;
			Map.StoveOpened = true;
			//Map.Switches.bunkerdoor.Enabled = false;
            //Util.MapDebugPrint( "bunkerdoor switch disabled" );
			           Map.StoveOpening = true;
		Map.Switches.stove_switch.Enabled = false;
			Util.MapDebugPrint( "^6POW TUNNEL STOVE DOOR IS OPENING" );
		}
		else//if ( trigger.Action == "closing" )
		{
			//Map.powtunneldoorOpened = false;
			//Map.powtunneldoorClosed = true;
            Map.StoveOpened = false;
			           Map.StoveOpening = false;
			Map.Switches.stove_switch.Enabled = true;
			Util.MapDebugPrint( "^6POW TUNNEL STOVE DOOR IS CLOSING" );          
			
			//Map.Switches.bunkerdoor.Enabled = true;
			
			//Util.MapDebugPrint( "bunkerdoor switch enabled" );
		}
	},


