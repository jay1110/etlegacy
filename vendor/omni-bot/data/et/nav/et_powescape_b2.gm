    xlabdoor1ISMoving = function( trigger )//door status trigger - use for door with trigger string and use with path through switch navigation
	{
		if ( trigger.Action == "opening" )
		{
            	Map.xlabdoor1Closed = false;
                Map.xlabdoor1Opened = true;

            Map.xlabdoor1Status = 1;//doorstatus open

			Map.Switches.labdoor_1a.Enabled = false;
			Map.Switches.labdoor_1b.Enabled = false;
           Util.EnableGoal( "SWITCH_labdoor_1a", false );//this way works turning on switch but pathrough FAILS! so ROUTE fails
           Util.EnableGoal( "SWITCH_labdoor_1b", false );
        SetAvailableMapGoals( TEAM.AXIS, false, "SWITCH_labdoor_1a" );//THISIS
    SetAvailableMapGoals( TEAM.AXIS, false, "SWITCH_labdoor_1b" );//THISIS 
     SetAvailableMapGoals( TEAM.ALLIES, false, "SWITCH_labdoor_1a" );//THISIS
    SetAvailableMapGoals( TEAM.ALLIES, false, "SWITCH_labdoor_1b" );//THISIS 

            Util.MapDebugPrint( "^elabdoor_1 switch disabled" );
			
			Util.MapDebugPrint( "^ePOW XLABS DOOR 1 IS OPENING" );
		}
		else //if ( trigger.Action == "closing" )
		{
                Map.xlabdoor1Opened = false;
	            Map.xlabdoor1Closed = true;

           	Map.xlabdoor1Status = 0;//doorstatus closed 
           Util.EnableGoal( "SWITCH_labdoor_1a", true );//this way works turning on switch but pathrough FAILS! so ROUTE fails
