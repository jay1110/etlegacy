// NEUTRAL COMMAND POSTS
// Neutral North Command Post = NCP


	NCP_Owner = 0,
	NCP_Dyno = 0,

	Set_NCP = function(_p) // p = TEAM.ALLIES or TEAM.AXIS or 0 (unbuilt)
	{
		switch(_p)
		{
			case 0:
			{
				Map.NCP_Owner = 0;
				SetAvailableMapGoals( TEAM.ALLIES, 1, "BUILD_North_Command_Post" );
				SetAvailableMapGoals( TEAM.ALLIES, 0, "PLANT_North_Command_Post" );
				SetAvailableMapGoals( TEAM.AXIS,   1, "BUILD_North_Command_Post" );
				SetAvailableMapGoals( TEAM.AXIS,   0, "PLANT_North_Command_Post" );
			}
			case TEAM.ALLIES:
			{
				Map.NCP_Owner = TEAM.ALLIES;
				SetAvailableMapGoals( TEAM.ALLIES, 0, "BUILD_North_Command_Post" );
				SetAvailableMapGoals( TEAM.ALLIES, 0, "PLANT_North_Command_Post" );
				SetAvailableMapGoals( TEAM.AXIS,   1, "PLANT_North_Command_Post" );
			}
			case TEAM.AXIS:
			{
				Map.NCP_Owner = TEAM.AXIS;
				SetAvailableMapGoals( TEAM.ALLIES, 0, "BUILD_North_Command_Post" );
				SetAvailableMapGoals( TEAM.ALLIES, 1, "PLANT_North_Command_Post" );
				SetAvailableMapGoals( TEAM.AXIS,   0, "PLANT_North_Command_Post" );
			}
		}
		Util.MapDebugPrint("NCP Owner: " + Map.NCP_Owner );
	},
	Allied_NCP_Built = function( trigger )
	{
		Map.Set_NCP(TEAM.ALLIES);
