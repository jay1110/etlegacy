// Triggers for doors, hidden hatches & gates 
///  	/bot waypoint_setproperty paththrough Navigation_PT:bedmoved  
    pow_tunnel_door2ISMoving = function( trigger )//door status trigger - use for door with trigger string and use with path through switch navigation
	{
		if ( trigger.Action == "opening" )
		{
			Map.powtunneldoorClosed = false;
			Map.powtunneldoorOpened = true;
            Map.BedOpened = true;
			            Map.BedOpening = true;
			Map.Switches.bed_switch.Enabled = false;
			//Map.Switches.bunkerdoor.Enabled = false;
            //Util.MapDebugPrint( "bunkerdoor switch disabled" );
			Map.bedtunnelopen = true;
			Util.MapDebugPrint( "^ePOW TUNNEL BED DOOR IS OPENING" );
		}
		else//if ( trigger.Action == "closing" )
		{
			Map.powtunneldoorOpened = false;
			Map.powtunneldoorClosed = true;
			Map.bedtunnelopen = false;
			Util.MapDebugPrint( "^ePOW TUNNEL BED DOOR IS CLOSING" );
            Map.BedOpened = false;          
						            Map.BedOpening = false;
			Map.Switches.bed_switch.Enabled = true;
			//Map.Switches.bunkerdoor.Enabled = false;
			
			//Util.MapDebugPrint( "bunkerdoor switch enabled" );
		}
	},
    
    pow_northgateISMoving = function( trigger )//door status trigger - use for door with trigger string and use with path through switch navigation
	{
		if ( trigger.Action == "-100.00 0.00 0.00" )
		{
			Map.pownorthgateClosed = false;
			Map.pownorthgateOpened = true;
                Util.DisableGoal( "SWITCH_exit_2", true );
                Util.DisableGoal( "SWITCH_exit_3", true );			
			Map.Switches.exit_2.Enabled = false;
			Map.Switches.exit_3.Enabled = false;
            Map.pownorthgateStatus = 1;//open
            
            //Util.MapDebugPrint( "^ePOW NORTH GATE switch disabled" );
			
			//Util.MapDebugPrint( "^ePOW NORTH GATE IS OPENING" );
		}
		else//if ( trigger.Action == "100.00 0.00 0.00" )
		{
			Map.pownorthgateOpened = false;
			Map.pownorthgateClosed = true;
            	Util.EnableGoal( "SWITCH_exit_2", true );
                Util.EnableGoal( "SWITCH_exit_3", true );
                            Map.pownorthgateStatus = 0;//closed
			Map.Switches.exit_2.Enabled = true;
			Map.Switches.exit_3.Enabled = true;                
			
			//Util.MapDebugPrint( "^ePOW NORTH GATE IS CLOSING" );          						
			//Util.MapDebugPrint( "^ePOW NORTH GATE  switch enabled" );
		}
	},

    powfrontgate1start = function( trigger )//door status trigger - use for door with trigger string and use with path through switch navigation
	{
		if ( trigger.Action == "0.00 -90.00 0.00" )
		{
			Map.powfrontgateClosed = false;
			Map.powfrontgateOpened = true;
			Util.DisableGoal( "SWITCH_exit_1", true );
			Map.Switches.exit_1.Enabled = false;
    SetAvailableMapGoals( TEAM.AXIS, true, "FLAG_activationkey1" );
    SetAvailableMapGoals( TEAM.AXIS, true, "FLAG_activationkey2" );
	SetAvailableMapGoals( TEAM.AXIS, true, "FLAG_activationkey3" );
    SetAvailableMapGoals( TEAM.AXIS, true, "FLAG_activationkey4" );         
    SetAvailableMapGoals( TEAM.AXIS, true, "SWITCH_flag_1_pickup" );//THISIS activationkey1
	SetAvailableMapGoals( TEAM.AXIS, true, "SWITCH_key" );//THISIS activationkey1 
            //Util.MapDebugPrint( "^ePOW FRONT GATE switch disabled" );			
			//Util.MapDebugPrint( "^ePOW FRONT GATE IS OPENING" );
		}
		else//if ( trigger.Action == "0.00 90.00 0.00" )
		{
			Map.powfrontgateOpened = false;
			Map.powfrontgateClosed = true;
			
			Util.MapDebugPrint( "^ePOW FRONT GATE IS CLOSING" );          
			
			Map.Switches.exit_1.Enabled = true;
			Util.EnableGoal( "SWITCH_exit_1", true );
            if (Map.car_done == 0)
            {
    SetAvailableMapGoals( TEAM.AXIS, false, "FLAG_activationkey1" );
    SetAvailableMapGoals( TEAM.AXIS, false, "FLAG_activationkey2" );
	SetAvailableMapGoals( TEAM.AXIS, false, "FLAG_activationkey3" );
    SetAvailableMapGoals( TEAM.AXIS, false, "FLAG_activationkey4" );         
    SetAvailableMapGoals( TEAM.AXIS, false, "SWITCH_flag_1_pickup" );//THISIS activationkey1
	SetAvailableMapGoals( TEAM.AXIS, false, "SWITCH_key" );//THISIS activationkey1 
            }
			//Util.MapDebugPrint( "^ePOW FRONT GATE switch enabled" );
		}
	},
    
