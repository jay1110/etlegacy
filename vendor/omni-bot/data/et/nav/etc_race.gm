global Map =
{
	Debug = 1, // please set to zero before distributing your script
	ShowMovers = false,

	allies_gold_Taken = function( trigger )
	{
		
		SetAvailableMapGoals( TEAM.AXIS, false, "FLAG_allies_gold" );
		
		if ( TestMap )
			{ return; }

		Util.MapDebugPrint( "allies_gold_Taken" );
	},

