global OnMapLoad = function()
{
	if ( TestMapOn )
		{ Util.AutoTestMap(); }

	// Register callback functions
	OnTrigger( "^1The Axis have stolen The Gold!", Map.allies_gold_Taken );
	OnTrigger( "^4The Allies have stolen The Gold!", Map.axis_gold_Taken );
	OnTrigger( "Allies have returned The Allies Gold Bars!", Map.allies_gold_Returned );
	OnTrigger( "^Axis have returned The Axis Gold Bars!", Map.axis_gold_Returned );
	OnTrigger( "The allies carpet has new fuel", Map.allies_gold_Secured );
	OnTrigger( "^4Allies have returned The Gold!", Map.Allies_Return_Gold );
	OnTrigger( "^1Axis have returned The Gold!", Map.Axis_Return_Gold );
	OnTrigger( "The allies carpet has new fuel", Map.Allied_Carpet_Fuelled);
	OnTrigger( "The axis carpet has new fuel", Map.Axis_Carpet_Fuelled);
	OnTrigger( "(R1) The Axis Carpet needs more fuel !!!", Map.Axis_Fuel_Secured_1 );
	OnTrigger( "(R2) The Axis Carpet needs more fuel !!!", Map.Axis_Fuel_Secured_2 );
	OnTrigger( "(R3) The Axis Carpet needs more fuel !!!", Map.Axis_Fuel_Secured_3 );
	OnTrigger( "(R4) The Axis Carpet needs more fuel !!!", Map.Axis_Fuel_Secured_4 );
	OnTrigger( "(R5) The Axis Carpet needs more fuel !!!", Map.Axis_Fuel_Secured_5 );
	OnTrigger( "(R6) The Axis Carpet needs more fuel !!!", Map.Axis_Fuel_Secured_6 );
	OnTrigger( "(R7) The Axis Carpet needs more fuel !!!", Map.Axis_Fuel_Secured_7 );
	OnTrigger( "(R8) The Axis Carpet needs more fuel !!!", Map.Axis_Fuel_Secured_8 );
	OnTrigger( "(R9) The Axis Carpet needs more fuel !!!", Map.Axis_Fuel_Secured_9 );
	OnTrigger( "(B1) The Allies Carpet needs more fuel !!!", Map.Allied_Fuel_Secured_1 );
	OnTrigger( "(B2) The Allies Carpet needs more fuel !!!", Map.Allied_Fuel_Secured_2 );
	OnTrigger( "(B3) The Allies Carpet needs more fuel !!!", Map.Allied_Fuel_Secured_3 );
	OnTrigger( "(B4) The Allies Carpet needs more fuel !!!", Map.Allied_Fuel_Secured_4 );
	OnTrigger( "(B5) The Allies Carpet needs more fuel !!!", Map.Allied_Fuel_Secured_5 );
	OnTrigger( "(B6) The Allies Carpet needs more fuel !!!", Map.Allied_Fuel_Secured_6 );
	OnTrigger( "(B7) The Allies Carpet needs more fuel !!!", Map.Allied_Fuel_Secured_7 );
	OnTrigger( "(B8) The Allies Carpet needs more fuel !!!", Map.Allied_Fuel_Secured_8 );
	OnTrigger( "(B9) The Allies Carpet needs more fuel !!!", Map.Allied_Fuel_Secured_9 );
	
	SetAvailableMapGoals( TEAM.AXIS, true, "CAPPOINT_axis_carpet_1" );
	SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_axis_gold_1" );
	SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_axis_gold_2" );
	SetAvailableMapGoals( TEAM.AXIS, false, "CAPPOINT_axis_carpet_2" );
	SetAvailableMapGoals( TEAM.AXIS, false, "CAPPOINT_axis_carpet_3" );
	SetAvailableMapGoals( TEAM.AXIS, false, "CAPPOINT_axis_carpet_4" );
	SetAvailableMapGoals( TEAM.AXIS, false, "CAPPOINT_axis_carpet_5" );
	SetAvailableMapGoals( TEAM.AXIS, false, "CAPPOINT_axis_carpet_6" );
	SetAvailableMapGoals( TEAM.AXIS, false, "CAPPOINT_axis_carpet_7" );
	SetAvailableMapGoals( TEAM.AXIS, false, "CAPPOINT_axis_carpet_8" );
	SetAvailableMapGoals( TEAM.AXIS, false, "CAPPOINT_axis_carpet_9" );
	SetAvailableMapGoals( TEAM.AXIS, false, "CAPPOINT_axis_carpet_10" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "CAPPOINT_allied_carpet_1" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "DEFEND_allied_gold_1" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "DEFEND_allied_gold_2" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "CAPPOINT_allied_carpet_2" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "CAPPOINT_allied_carpet_3" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "CAPPOINT_allied_carpet_4" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "CAPPOINT_allied_carpet_5" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "CAPPOINT_allied_carpet_6" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "CAPPOINT_allied_carpet_7" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "CAPPOINT_allied_carpet_8" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "CAPPOINT_allied_carpet_9" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "CAPPOINT_allied_carpet_10" );

	//~Util.DisableGoal( ".*", true ); // all but routes
	//~SetAvailableMapGoals( TEAM.AXIS, true, "ATTACK_.*" );
	//~SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_.*" );

	// Max users per goal
	//Util.SetMaxUsers( 1, "DEFEND_.*" );
	//Util.SetMaxUsers( 1, "GRENADE_.*" );
	//Util.SetMaxUsers( 1, "MOUNTMG42_.*" );

	// Camp times
	SetMapGoalProperties( "MOUNTMG42_.*", {MinCampTime=15, MaxCampTime=90} );
	SetMapGoalProperties( "MOBILEMG42_.*", {MinCampTime=10, MaxCampTime=60} );


	Util.MapDebugPrint( "Omni-bot map script for " + GetMapName() + " executed." );
};

