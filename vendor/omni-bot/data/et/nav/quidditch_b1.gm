global OnMapLoad = function()
{
	OnTrigger("MISSING_STRING", Map.ball_obj_al_Taken);
	OnTrigger("MISSING_STRING", Map.ball_obj_al_1_Taken);
	OnTrigger("MISSING_STRING", Map.ball_obj_al_2_Taken);
	OnTrigger("MISSING_STRING", Map.ball_obj_al_3_Taken);
	OnTrigger("MISSING_STRING", Map.ball_obj_al_4_Taken);
	OnTrigger("MISSING_STRING", Map.ball_obj_ax_Taken);
	OnTrigger("MISSING_STRING", Map.ball_obj_ax_1_Taken);
	OnTrigger("MISSING_STRING", Map.ball_obj_ax_2_Taken);
	OnTrigger("MISSING_STRING", Map.ball_obj_ax_3_Taken);
	OnTrigger("MISSING_STRING", Map.ball_obj_ax_4_Taken);
	OnTrigger("MISSING_STRING", Map.ball_obj_al_Returned);
	OnTrigger("MISSING_STRING", Map.ball_obj_al_1_Returned);
	OnTrigger("MISSING_STRING", Map.ball_obj_al_2_Returned);
	OnTrigger("MISSING_STRING", Map.ball_obj_al_3_Returned);
	OnTrigger("MISSING_STRING", Map.ball_obj_al_4_Returned);
	OnTrigger("MISSING_STRING", Map.ball_obj_ax_Returned);
	OnTrigger("MISSING_STRING", Map.ball_obj_ax_1_Returned);
	OnTrigger("MISSING_STRING", Map.ball_obj_ax_2_Returned);
	OnTrigger("MISSING_STRING", Map.ball_obj_ax_3_Returned);
	OnTrigger("MISSING_STRING", Map.ball_obj_ax_4_Returned);
	OnTrigger("MISSING_STRING", Map.ball_obj_al_Secured);
	OnTrigger("MISSING_STRING", Map.ball_obj_al_1_Secured);
	OnTrigger("MISSING_STRING", Map.ball_obj_al_2_Secured);
	OnTrigger("MISSING_STRING", Map.ball_obj_al_3_Secured);
	OnTrigger("MISSING_STRING", Map.ball_obj_al_4_Secured);
	OnTrigger("MISSING_STRING", Map.ball_obj_ax_Secured);
	OnTrigger("MISSING_STRING", Map.ball_obj_ax_1_Secured);
	OnTrigger("MISSING_STRING", Map.ball_obj_ax_2_Secured);
	OnTrigger("MISSING_STRING", Map.ball_obj_ax_3_Secured);
	OnTrigger("MISSING_STRING", Map.ball_obj_ax_4_Secured);

	//~Util.DisableGoal(".*", true);
	//~SetAvailableMapGoals(TEAM.AXIS, true, "ATTACK_.*");
	//~SetAvailableMapGoals(TEAM.ALLIES, true, "ATTACK_.*");

	//Util.SetMaxUsers(1, "MOUNTMG42_.*");

	//SetMapGoalProperties("MOUNTMG42_.*", {MinCampTime=15, MaxCampTime=90});
	
	// Start watching platform position
	thread(Map.WatchPlatform1Position);
	thread(Map.WatchPlatform2Position);
	thread(Map.WatchPlatform3Position);
	thread(Map.WatchPlatform4Position);
	thread(Map.WatchPlatform5Position);
	thread(Map.WatchPlatform6Position);

	//SNIPE GOALS
	SetAvailableMapGoals(TEAM.ALLIES, false, "SNIPE_left1");
	SetAvailableMapGoals(TEAM.AXIS, false, "SNIPE_left1");
	
	//DEFEND GOALS
	SetAvailableMapGoals(TEAM.ALLIES, false, "DEFEND_left1");
	SetAvailableMapGoals(TEAM.AXIS, false, "DEFEND_left1");
	
	//ARTILLERY GOALS
	SetAvailableMapGoals(TEAM.ALLIES, true, "ARTILLERY_S_center");
	SetAvailableMapGoals(TEAM.AXIS, true, "ARTILLERY_S_center");
	
	//MOBILEMG GOALS
	SetAvailableMapGoals(TEAM.ALLIES, true, "MOBILEMG42_aly1");
	SetAvailableMapGoals(TEAM.AXIS, false, "MOBILEMG42_aly1");
	SetAvailableMapGoals(TEAM.ALLIES, false, "MOBILEMG42_axis1");
	SetAvailableMapGoals(TEAM.AXIS, true, "MOBILEMG42_axis1");
	
	//SMOKE GOALS
