	WatchPlatform1Position = function()
	{
		local goal = GetGoal("MOVER_e_tower_elev2");
		local entity = goal.GetEntity();
		local bottompos = Vector3(1579, -6027, 374);
		local toppos = Vector3(1579, -6027, 912);
		local tolerance = 150;

		while(true)
		{
			local entitypos = GetEntPosition(entity);

			if(DistanceBetween(entitypos, bottompos) < tolerance && Map.Platform1Position != 0)
			{
				Map.Platform1Position = 0;
				if(Map.Debug) { print("Platform1 at bottom position"); }
			}
			else if(DistanceBetween(entitypos, toppos) < tolerance && Map.Platform1Position != 1)
			{
				Map.Platform1Position = 1;
				if(Map.Debug) { print("Platform1 at top position"); }
			}

			sleep(1.2);
		}
	},
	
